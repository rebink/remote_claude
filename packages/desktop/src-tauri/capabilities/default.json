{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "opener:default",
    "shell:default",
    "dialog:allow-open",
    "clipboard-manager:allow-write-text"
  ]
}