{
  "name": "patchwire-vscode",
  "displayName": "Patchwire",
  "description": "Chat with an AI coding agent on a machine you control; review every change as a diff before it touches your code.",
  "version": "0.3.2",
  "publisher": "patchwire",
  "private": true,
  "icon": "media/icon.png",
  "galleryBanner": { "color": "#0E0E10", "theme": "dark" },
  "keywords": ["ai", "claude", "flutter", "diff", "code review", "remote", "patchwire"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rebink/patchwire.git",
    "directory": "packages/extension"
  },
  "license": "MIT",
  "engines": { "vscode": "^1.80.0", "node": ">=20" },
  "categories": ["AI", "Other"],
  "main": "./dist/extension.cjs",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "patchwire.openSetup", "title": "Patchwire: Setup…" },
      { "command": "patchwire.newChat", "title": "Patchwire: New Chat" },
      { "command": "patchwire.toggleLiveSync", "title": "Patchwire: Toggle Live Sync" },
      { "command": "patchwire.viewOutput", "title": "Patchwire: Show Output" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "patchwire", "title": "Patchwire", "icon": "$(comment-discussion)" }
      ]
    },
    "views": {
      "patchwire": [
        { "type": "webview", "id": "patchwire.chatPanel", "name": "Chat" }
      ]
    },
    "configuration": {
      "title": "Patchwire",
      "properties": {
        "patchwire.cliPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the patchwire CLI. Leave empty to use the CLI bundled with the extension."
        }
      }
    }
  },
  "scripts": {
    "build": "tsup && node scripts/bundle-cli.mjs",
    "dev": "pnpm build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "bash scripts/smoke-extension.sh",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@patchwire/protocol": "workspace:*",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.0",
    "ovsx": "^1.0.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.3",
    "vitest": "^2.0.4"
  },
  "patchwire": {
    "minimumCliVersion": "0.2.0"
  }
}
