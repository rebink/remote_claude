      }
      @keyframes pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }

      /* ═══════════════════════════════════════════════════════════
         HERO
         ═══════════════════════════════════════════════════════════ */
      .hero {
        position: relative;
        overflow: hidden;
        padding: clamp(72px, 9vw, 132px) var(--gutter) clamp(72px, 9vw, 120px);
      }
      .hero-bg { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
      .hero-grid-bg {
        position: absolute; inset: 0;
        background:
          linear-gradient(rgba(232, 226, 208, 0.025) 1px, transparent 1px) 0 0 / 100% 80px,
          linear-gradient(90deg, rgba(232, 226, 208, 0.025) 1px, transparent 1px) 0 0 / 80px 100%;
        mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 0%, transparent 90%);
        -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 0%, transparent 90%);
      }
      .hero-spotlight {
        --x: 50%; --y: 30%;
        position: absolute; inset: 0;
        background: radial-gradient(
          480px circle at var(--x) var(--y),
