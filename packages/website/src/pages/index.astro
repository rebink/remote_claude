---
import '../styles/custom.css';
import { ClientRouter } from 'astro:transitions';

const repo = 'https://github.com/rebink/patchwire';
const version = '0.2.4';
const rev = 'b71dc5e';
---

<!doctype html>
<html lang="en" class="rc-brand rc-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0E0E10" />
    <title>Patchwire: one remote, your whole team, their own diffs</title>
    <meta
      name="description"
      content="A shared remote runs the AI for your whole team. Per-user tokens, isolated checkouts, a fair queue. Each diff returns to the laptop that asked for it."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://patchwire.dev/" />
    <meta property="og:title" content="Patchwire" />
    <meta
      property="og:description"
      content="One shared remote runs the AI for the whole team. Per-user tokens, isolated checkouts, a fair queue. Diffs come back to each laptop for review."
    />
    <meta property="og:image" content="https://patchwire.dev/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Patchwire" />
    <meta
      name="twitter:description"
      content="One box. Every developer. Their own diffs. Patchwire runs the AI on one shared remote — per-user, isolated, queued — and returns a diff to each laptop."
    />
    <meta name="twitter:image" content="https://patchwire.dev/og.png" />
    <ClientRouter />
  </head>
  <body class="page">
    <a href="#main" class="skip-link">Skip to content</a>
    <!-- ───────── TOP BAR ───────── -->
    <header class="topbar">
      <a class="wordmark" href="/" aria-label="Patchwire home">
        <svg width="26" height="26" viewBox="0 0 22 22" aria-hidden="true">
          <rect x="0.5" y="0.5" width="9" height="9" stroke="currentColor" stroke-width="1.8" fill="none"/>
          <rect x="12.5" y="12.5" width="9" height="9" fill="currentColor"/>
          <line x1="6" y1="11" x2="16" y2="11" stroke="currentColor" stroke-width="1.4" stroke-dasharray="1.4 2"/>
          <circle cx="11" cy="11" r="1.5" fill="#C9F564"/>
        </svg>
        <span>Patchwire</span>
      </a>
      <nav class="topnav" aria-label="Primary">
        <a href="/quickstart/">Quickstart</a>
        <a href="/multi-developer/">Teams</a>
        <a href="/architecture/">Architecture</a>
        <a href="/commands/">CLI</a>
        <a href={repo} class="topnav-ext">GitHub ↗</a>
      </nav>
      <span class="meta-pill">
        <span class="meta-dot"></span>
        v{version}
      </span>
    </header>

    <!-- ───────── HERO ───────── -->
    <main id="main">
    <section class="hero" id="hero">
      <!-- background atmospherics -->
      <div class="hero-bg" aria-hidden="true">
        <div class="hero-grid-bg"></div>
        <div class="hero-spotlight" id="spotlight"></div>
        <div class="hero-glow hero-glow-phos"></div>
        <div class="hero-glow hero-glow-amber"></div>
      </div>

      <div class="hero-inner">
        <div class="hero-eyebrow reveal">
          <span class="eyebrow-tag">0.2.4 / 2026</span>
          <span class="eyebrow-sep">·</span>
          <span class="eyebrow-rev">rev {rev}</span>
          <span class="eyebrow-sep">·</span>
          <span class="eyebrow-status"><span class="eyebrow-pulse"></span>shipping</span>
        </div>

        <h1 class="hero-h reveal">
          <span class="hero-h-line">One&nbsp;box.</span>
          <span class="hero-h-line">Every developer.</span>
          <span class="hero-h-line">Their own <em>diffs.</em></span>
        </h1>

        <p class="hero-sub reveal">
          A shared remote runs the AI for the whole team. Per-user tokens,
          isolated checkouts, a fair queue. Each diff returns to the laptop
          that asked for it &mdash; nothing else crosses the wire.
        </p>

        <!-- ── The animated terminal centerpiece ── -->
        <div class="term reveal" id="term">
          <header class="term-bar">
            <span class="term-dots" aria-hidden="true">
              <span></span><span></span><span></span>
            </span>
            <span class="term-path">~/projects/team-app</span>
            <span class="term-host">you@laptop · zsh</span>
          </header>
          <div class="term-body" aria-live="polite">
            <div class="term-line" data-typewrite='$ patchwire ask "refactor login_bloc to freezed"' data-after="800"></div>
            <div class="term-line term-line-step" data-step="rsync"    data-step-detail="14 files · 84 ms"              data-after="650"></div>
            <div class="term-line term-line-step" data-step="queued"   data-step-detail="position 2 · ahead: ana, ben" data-after="1100"></div>
            <div class="term-line term-line-step" data-step="accepted" data-step-detail="slot granted · waited 3.4 s"  data-after="700"></div>
            <div class="term-line term-line-step" data-step="spawn"    data-step-detail="claude --print · 4.7 s"       data-after="1400"></div>
            <div class="term-line term-line-step" data-step="diff"     data-step-detail="31 lines · 6 files"           data-after="700"></div>
            <div class="term-spacer"></div>
            <div class="term-diff" id="termDiff">
              <div class="diff-rail">@@ <span class="rail-path">lib/auth/login_bloc.dart</span></div>
              <div class="diff-row diff-minus"><span class="num">142</span><span class="sign">−</span><span class="content">  return BlocBase.fromJson(json);</span></div>
              <div class="diff-row diff-plus" ><span class="num">142</span><span class="sign">+</span><span class="content">  return Freezed.fromJson(json);</span></div>
              <div class="diff-row diff-context"><span class="num">143</span><span class="sign">&nbsp;</span><span class="content">{`}`}</span></div>
              <div class="diff-row diff-minus"><span class="num">147</span><span class="sign">−</span><span class="content">class LoginBloc extends BlocBase {`{`}</span></div>
              <div class="diff-row diff-plus" ><span class="num">147</span><span class="sign">+</span><span class="content">@freezed</span></div>
              <div class="diff-row diff-plus" ><span class="num">148</span><span class="sign">+</span><span class="content">class LoginState with _$LoginState {`{`}</span></div>
            </div>
            <div class="term-actions" id="termActions">
              <button class="term-btn term-btn-primary" type="button">git apply <span class="term-btn-kbd">↵</span></button>
              <button class="term-btn" type="button">preview <span class="term-btn-kbd">p</span></button>
              <button class="term-btn term-btn-ghost" type="button">tweak <span class="term-btn-kbd">t</span></button>
            </div>
          </div>
        </div>

        <div class="hero-cta reveal">
          <a href="/install-extension/" class="cta cta-primary magnet">
            <span class="cta-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                <path d="M22 4.5l-9.5 7.5L22 19.5V4.5z" fill="currentColor"/>
                <path d="M3 8l5 5v6l9.5-7.5L8 4v6l-5-2z" fill="currentColor" opacity="0.85"/>
              </svg>
            </span>
            <span>Install for VS Code</span>
            <span class="cta-arrow">→</span>
          </a>
          <a href="/quickstart/" class="cta cta-ghost magnet">
            <span class="cta-icon" aria-hidden="true">$_</span>
            <span>Get the CLI</span>
            <span class="cta-arrow">→</span>
          </a>
        </div>

        <div class="hero-byline reveal">
          <span aria-hidden="true">↓ scroll</span>
          <span class="byline-line" aria-hidden="true"></span>
          <a href={repo} class="byline-link">github.com/rebink/patchwire ↗</a>
        </div>
      </div>
    </section>

    <!-- ───────── SECTION: VS CODE EXTENSION ───────── -->
    <section class="editor">
      <div class="editor-grid">
        <div class="editor-prose">
          <span class="kicker reveal"><span class="kicker-bar"></span>00 · from your editor</span>
          <h2 class="editor-h reveal">
            Or, never <em>leave</em> your editor.
          </h2>
          <p class="editor-sub reveal">
            Patchwire ships a VS Code extension. Chat in a side panel.
            Preview the diff inline. <strong>Apply with one keystroke.</strong>
            Same engine, same diff-return guarantee, just without the
            terminal context switch.
          </p>
          <ul class="editor-bullets reveal">
            <li><span class="bullet-mark">▢</span> Native side panel that feels like part of VS Code</li>
            <li><span class="bullet-mark">▢</span> Inline diff preview, hunk-by-hunk apply</li>
            <li><span class="bullet-mark">▢</span> Setup wizard discovers your Tailscale peers</li>
            <li><span class="bullet-mark">▢</span> Shares the same config as the CLI, so you can swap any time</li>
          </ul>
          <div class="editor-cta reveal">
            <a href="/install-extension/" class="cta cta-primary magnet">
              <span class="cta-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <path d="M22 4.5l-9.5 7.5L22 19.5V4.5z" fill="currentColor"/>
                  <path d="M3 8l5 5v6l9.5-7.5L8 4v6l-5-2z" fill="currentColor" opacity="0.85"/>
                </svg>
              </span>
              <span>Install for VS Code</span>
              <span class="cta-arrow">→</span>
            </a>
            <a href="/quickstart/" class="cta cta-link magnet">
              <span>or use the CLI</span>
              <span class="cta-arrow">→</span>
            </a>
          </div>
        </div>

        <div class="editor-mock reveal">
          <div class="vscode" data-tilt>
            <header class="vscode-bar">
              <span class="term-dots" aria-hidden="true">
                <span></span><span></span><span></span>
              </span>
              <span class="vscode-title">Visual Studio Code · your-app</span>
              <span class="vscode-host" aria-hidden="true">·</span>
            </header>
            <div class="vscode-body">
              <aside class="vscode-activity" aria-hidden="true">
                <span class="va">▤</span>
                <span class="va">⌕</span>
                <span class="va">⌥</span>
                <span class="va va-active" title="Patchwire">
                  <svg width="14" height="14" viewBox="0 0 22 22" aria-hidden="true">
                    <rect x="0.5" y="0.5" width="9" height="9" stroke="currentColor" stroke-width="1.8" fill="none"/>
                    <rect x="12.5" y="12.5" width="9" height="9" fill="currentColor"/>
                    <line x1="6" y1="11" x2="16" y2="11" stroke="currentColor" stroke-width="1.4" stroke-dasharray="1.4 2"/>
                    <circle cx="11" cy="11" r="1.5" fill="#C9F564"/>
                  </svg>
                </span>
                <span class="va">▦</span>
              </aside>
              <aside class="vscode-side">
                <header class="vss-head">
                  <span class="vss-title">PATCHWIRE</span>
                  <span class="vss-conn">
                    <span class="vss-conn-dot"></span>
                    <span>remote</span>
                  </span>
                </header>
                <div class="vss-thread" role="log">
                  <div class="vss-msg vss-msg-user">
                    <span class="vss-avatar">you</span>
                    <p class="vss-bubble">refactor login_bloc to freezed</p>
                  </div>
                  <div class="vss-msg vss-msg-bot">
                    <span class="vss-avatar vss-avatar-pw">pw</span>
                    <div class="vss-content">
                      <p class="vss-msg-head">
                        Done.
                        <span class="vss-stat-add">+12</span>
                        <span class="vss-stat-sep">·</span>
                        <span class="vss-stat-rm">−8</span>
                        <span class="vss-stat-sep">·</span>
                        <span class="vss-stat-files">3 files</span>
                      </p>
                      <div class="vss-diffinline">
                        <header class="vss-diff-head">lib/auth/login_bloc.dart</header>
                        <div class="vss-row vss-row-minus"><span class="vss-row-sign">−</span><span>return BlocBase.fromJson(json);</span></div>
                        <div class="vss-row vss-row-plus" ><span class="vss-row-sign">+</span><span>return Freezed.fromJson(json);</span></div>
                        <div class="vss-row vss-row-context"><span class="vss-row-sign">&nbsp;</span><span>{`}`}</span></div>
                        <div class="vss-row vss-row-plus" ><span class="vss-row-sign">+</span><span>@freezed</span></div>
                      </div>
                      <div class="vss-actions">
                        <button class="vss-btn vss-btn-primary" type="button">Apply <span class="vss-kbd">↵</span></button>
                        <button class="vss-btn" type="button">Reject</button>
                        <button class="vss-btn vss-btn-ghost" type="button">Tweak</button>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="vss-input" aria-hidden="true">
                  <span class="vss-input-text">Ask Patchwire&hellip;</span>
                  <span class="vss-input-cursor"></span>
                  <span class="vss-input-send">↵</span>
                </div>
              </aside>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────── SECTION: THE BIG CLAIM ───────── -->
    <section class="claim">
      <span class="kicker reveal"><span class="kicker-bar"></span>01 · the stance</span>
      <h2 class="claim-h reveal">
        Sharing one machine usually <em>ruins</em> it.
      </h2>
      <p class="claim-sub reveal">
        Point a whole team at one box and you get clobbered checkouts,
        colliding AI runs, and &ldquo;who&rsquo;s on the machine right now?&rdquo;
        Patchwire keeps the shared box but gives every developer their
        <strong>own token, their own checkout, and a fair place in line.</strong>
      </p>

      <div class="parallel reveal">
        <article class="par-card par-old">
          <header class="par-head">
            <span class="par-dot par-dot-amber"></span>
            <span class="par-label">SHARED BOX, THE OLD WAY</span>
          </header>
          <ul>
            <li>One checkout everyone fights over</li>
            <li>Concurrent runs clobber each other</li>
            <li>No record of who ran what</li>
            <li>First-come hogs the whole machine</li>
          </ul>
        </article>
        <article class="par-card par-new">
          <header class="par-head">
            <span class="par-dot par-dot-phos"></span>
            <span class="par-label">PATCHWIRE</span>
          </header>
          <ul>
            <li>Per-user isolated checkout</li>
            <li>Fair FIFO queue, live position</li>
            <li>Every turn in a JSONL audit log</li>
            <li>Per-user + global concurrency caps</li>
          </ul>
        </article>
      </div>
    </section>

    <!-- ───────── SECTION: HOW IT WORKS ───────── -->
    <section class="flow">
      <span class="kicker reveal"><span class="kicker-bar"></span>02 · the flow</span>
      <h2 class="flow-h reveal">
        One HTTP call. <em>End-to-end.</em>
      </h2>

      <div class="flowdiagram reveal" aria-hidden="true">
        <div class="flowbox flowbox-laptop">
          <span class="flowbox-icon">⌘</span>
          <span class="flowbox-title">Laptop</span>
          <span class="flowbox-sub">patchwire CLI</span>
        </div>
        <div class="flowwire">
          <svg viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true">
            <line x1="0" y1="30" x2="400" y2="30" stroke="rgba(232,226,208,0.18)" stroke-width="1" stroke-dasharray="2 4"/>
          </svg>
          <span class="flowparticle"></span>
          <span class="flowlabel">rsync · queue · streamed diff</span>
        </div>
        <div class="flowbox flowbox-mac">
          <span class="flowbox-icon">▣</span>
          <span class="flowbox-title">Remote</span>
          <span class="flowbox-sub">patchwire-agent</span>
        </div>
      </div>

      <ol class="steps">
        <li class="step reveal">
          <span class="step-no">01</span>
          <div class="step-body">
            <h3>Push code over rsync.</h3>
            <p>One-way, into your <em>own</em> per-user directory on the remote. Your laptop is the source of truth; the remote mirrors it. Never the other direction, never another developer's tree.</p>
          </div>
        </li>
        <li class="step reveal">
          <span class="step-no">02</span>
          <div class="step-body">
            <h3>Streamed <code>/ask</code> with your per-user token.</h3>
            <p>The agent resolves your token to your identity, drops you into the fair queue &mdash; you watch your live position stream back &mdash; then spawns the AI on your own clean checkout.</p>
          </div>
        </li>
        <li class="step reveal">
          <span class="step-no">03</span>
          <div class="step-body">
            <h3>AI edits files. Agent captures <code>git diff</code>.</h3>
            <p>The AI edits a clean checkout natively. The agent derives the diff from git, then resets the tree. Robust, no prompt fragility.</p>
          </div>
        </li>
        <li class="step reveal">
          <span class="step-no">04</span>
          <div class="step-body">
            <h3>Diff returns. <em>You</em> decide.</h3>
            <p>Colorized preview. <code>git apply</code> selectively. Nothing lands without your hand on it.</p>
          </div>
        </li>
      </ol>
    </section>

    <!-- ───────── SECTION: BUILT FOR TEAMS ───────── -->
    <section class="teams">
      <span class="kicker reveal"><span class="kicker-bar"></span>03 · for teams</span>
      <h2 class="teams-h reveal">
        No one steps on <em>anyone.</em>
      </h2>
      <p class="teams-sub reveal">
        One agent, many developers. Identity, isolation, fairness, and a paper
        trail &mdash; built into the protocol, not bolted on after.
      </p>

      <div class="teams-grid">
        <div class="teams-prose">
          <article class="teampillar reveal">
            <span class="teampillar-no">01</span>
            <div>
              <h3>Isolated checkouts</h3>
              <p>Each developer rsyncs into <code>&lt;user&gt;/&lt;project&gt;</code> on the remote. Two people can hammer the same project name and never touch each other's tree.</p>
            </div>
          </article>
          <article class="teampillar reveal">
            <span class="teampillar-no">02</span>
            <div>
              <h3>Fair queue</h3>
              <p>Per-user <em>and</em> global concurrency caps. Requests over the cap wait FIFO and stream their live position back, so one box never thunders.</p>
            </div>
          </article>
          <article class="teampillar reveal">
            <span class="teampillar-no">03</span>
            <div>
              <h3>Audit log</h3>
              <p>Every successful turn appends one JSONL line: who, which project, prompt <em>hash</em>, lines changed, duration. Plaintext prompts never touch disk.</p>
            </div>
          </article>
        </div>

        <!-- on-brand agent dashboard: live /queue snapshot + audit tail -->
        <aside class="teams-panel reveal" data-tilt aria-hidden="true">
          <header class="tp-bar">
            <span class="term-dots"><span></span><span></span><span></span></span>
            <span class="tp-bar-title">patchwire-agent</span>
            <span class="tp-bar-ep">GET /queue</span>
          </header>
          <div class="tp-body">
            <div class="tp-label">in flight · 1 / 3</div>
            <div class="tp-row tp-row-run">
              <span class="tp-user">ana</span>
              <span class="tp-meta">claude --print · 4.7s</span>
              <span class="tp-badge tp-badge-run">running</span>
            </div>

            <div class="tp-label">queued · 2</div>
            <div class="tp-row">
              <span class="tp-pos">1</span>
              <span class="tp-user">ben</span>
              <span class="tp-meta">waiting</span>
            </div>
            <div class="tp-row tp-row-you">
              <span class="tp-pos">2</span>
              <span class="tp-user">you</span>
              <span class="tp-meta">waiting</span>
            </div>

            <div class="tp-divider"></div>

            <div class="tp-label">~/.patchwire/agent.log</div>
            <pre class="tp-audit"><span class="tp-aline"><span class="tp-k">cleo</span> team-app · +12 −3 · 5.2s</span>
<span class="tp-aline"><span class="tp-k">ana</span> api · +4 −0 · 3.4s</span>
<span class="tp-aline tp-aline-live"><span class="tp-k">ana</span> team-app · streaming…</span></pre>
          </div>
        </aside>
      </div>
    </section>

    <!-- ───────── SECTION: SETUP ───────── -->
    <section class="setup">
      <span class="kicker reveal"><span class="kicker-bar"></span>04 · setup</span>
      <h2 class="setup-h reveal">
        Install once. <em>Add developers</em> forever.
      </h2>

      <div class="setup-grid">
        <article class="termcard reveal" data-tilt>
          <header class="termcard-bar">
            <span class="term-dots"><span></span><span></span><span></span></span>
            <span class="termcard-host">on the remote · admin</span>
          </header>
          <pre class="termcard-body"><span class="t-com"># once</span>
$ pnpm add -g <span class="t-str">github:rebink/patchwire</span>
$ patchwire-agent install
  <span class="t-ok">→ launchd: com.patchwire.agent</span>

<span class="t-com"># per developer</span>
$ patchwire-agent user add <span class="t-str">ana</span>
  <span class="t-ok">→ Token: pw_b9f...  (hand to ana)</span></pre>
        </article>
        <article class="termcard termcard-laptop reveal" data-tilt>
          <header class="termcard-bar">
            <span class="term-dots"><span></span><span></span><span></span></span>
            <span class="termcard-host">on each laptop · ana</span>
          </header>
          <pre class="termcard-body"><span class="t-com"># once</span>
$ pnpm add -g <span class="t-str">github:rebink/patchwire</span>
$ patchwire setup --token <span class="t-str">pw_b9f...</span>
  <span class="t-ok">→ identity: ana · remote: <your-remote-host></span>

<span class="t-com"># forever</span>
$ patchwire ask <span class="t-str">"refactor login_bloc to freezed"</span></pre>
        </article>
      </div>
    </section>

    <!-- ───────── SECTION: FEATURES ───────── -->
    <section class="feats">
      <span class="kicker reveal"><span class="kicker-bar"></span>05 · the gains</span>
      <h2 class="feats-h reveal">
        Built for the whole&nbsp;<em>team.</em>
      </h2>

      <div class="featgrid">
        <article class="feat-card reveal feat-card-tall">
          <span class="feat-no">+</span>
          <h3>Full-repo context.</h3>
          <p>Claude (or Codex, or aider, or your shell script) runs on a clean checkout with the entire tree visible. No 8&#8209;k-token truncation, no "missing import" loops.</p>
          <div class="feat-glow" aria-hidden="true"></div>
        </article>
        <article class="feat-card reveal">
          <span class="feat-no">+</span>
          <h3>Reviewable diffs.</h3>
          <p><code>git diff</code> derived, never AI-imagined. Apply selectively.</p>
        </article>
        <article class="feat-card reveal">
          <span class="feat-no">+</span>
          <h3>AI-agnostic.</h3>
          <p>Any CLI that reads stdin and edits files. Swap providers in one line of YAML.</p>
        </article>
        <article class="feat-card reveal">
          <span class="feat-no">+</span>
          <h3>One-way sync.</h3>
          <p>rsync push. Your laptop's filesystem is the source of truth. The remote can't surprise you.</p>
        </article>
        <article class="feat-card reveal">
          <span class="feat-no">+</span>
          <h3>Isolated checkouts.</h3>
