---
import '../styles/custom.css';

const repo = 'https://github.com/rebink/remote_claude';
const version = '0.1.0';
const rev = '263e2e3';
---

<!doctype html>
<html lang="en" class="rc-brand">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0E0E10" />
    <title>Remote Claude — local stays local, AI stays remote</title>
    <meta
      name="description"
      content="Push your project to a remote Mac. Run Claude Code there with the whole repo. Pull back a unified diff. Apply only what you want."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Remote Claude" />
    <meta
      property="og:description"
      content="Local-first development. AI executes remotely. Diffs come back for review."
    />
  </head>
  <body>
    <!-- ── Top bar ─────────────────────────────────────────────── -->
    <header class="topbar">
      <a class="wordmark" href="/" aria-label="Remote Claude home">
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
          <rect x="0.5" y="0.5" width="9" height="9" stroke="currentColor" fill="none"/>
          <rect x="12.5" y="12.5" width="9" height="9" fill="currentColor"/>
          <line x1="6" y1="11" x2="16" y2="11" stroke="currentColor" stroke-dasharray="1 2"/>
        </svg>
        <span>Remote Claude</span>
      </a>
      <nav class="topnav" aria-label="Primary">
        <a href="/quickstart/">Quickstart</a>
        <a href="/architecture/">Architecture</a>
        <a href="/commands/">CLI</a>
        <a href="/install-extension/">Extension</a>
        <a href={repo} class="topnav-ext">GitHub ↗</a>
      </nav>
      <span class="rev">
        <span class="rev-dot"></span>v{version} · rev {rev}
      </span>
    </header>

    <!-- ── HERO: bicameral split ───────────────────────────────── -->
    <section class="hero">
      <div class="hero-paper" aria-hidden="true"></div>
      <div class="hero-ink" aria-hidden="true"></div>

      <!-- The wire: a hairline crossing both halves with a traveling patch -->
      <div class="wire" aria-hidden="true">
        <span class="wire-line"></span>
        <span class="wire-patch">■</span>
      </div>

      <div class="hero-grid">
        <!-- LEFT: local side -->
        <div class="hero-local">
          <span class="side-label side-label-dark">
            <span class="side-dot side-dot-amber"></span>LOCAL · your laptop
          </span>
          <p class="hero-stanza">
            Your IDE. Your hot-reload. Your debugger. Your &mdash; everything &mdash; un&shy;touched.
          </p>
          <pre class="hero-snippet hero-snippet-light"><code>$ remote-claude ask <span class="sn-q">"refactor login_bloc</span>
<span class="sn-cont">                     to freezed"</span></code></pre>
        </div>

        <!-- RIGHT: remote side -->
        <div class="hero-remote">
          <span class="side-label side-label-light">
            <span class="side-dot side-dot-phosphor"></span>REMOTE · the Mac on your desk
          </span>
          <pre class="hero-snippet hero-snippet-dark"><code><span class="prompt-host">mini ~</span> <span class="prompt-arrow">›</span> claude --print
<span class="sn-out">// editing 3 files…</span>
<span class="sn-out-ok">→ wrote diff (412 lines)</span></code></pre>
        </div>

        <!-- The big headline straddles the seam; two layers, each clipped -->
        <h1 class="hero-headline" aria-label="Local stays local. AI stays remote. Diffs cross the wire.">
          <span class="headline-layer headline-paper" aria-hidden="true">
            <span class="hl-word" style="--i:0">Local</span>
            <span class="hl-word" style="--i:1">stays</span>
            <span class="hl-word" style="--i:2">local.</span>
            <br/>
            <span class="hl-word" style="--i:3">AI</span>
            <span class="hl-word" style="--i:4">stays</span>
            <span class="hl-word hl-italic" style="--i:5">remote.</span>
            <br/>
            <span class="hl-word" style="--i:6">Diffs</span>
            <span class="hl-word" style="--i:7">cross</span>
            <span class="hl-word" style="--i:8">the</span>
            <span class="hl-word hl-accent-amber" style="--i:9">wire.</span>
          </span>
          <span class="headline-layer headline-ink" aria-hidden="true">
            <span class="hl-word" style="--i:0">Local</span>
            <span class="hl-word" style="--i:1">stays</span>
            <span class="hl-word" style="--i:2">local.</span>
            <br/>
            <span class="hl-word" style="--i:3">AI</span>
            <span class="hl-word" style="--i:4">stays</span>
            <span class="hl-word hl-italic" style="--i:5">remote.</span>
            <br/>
            <span class="hl-word" style="--i:6">Diffs</span>
            <span class="hl-word" style="--i:7">cross</span>
            <span class="hl-word" style="--i:8">the</span>
            <span class="hl-word hl-accent-phosphor" style="--i:9">wire.</span>
          </span>
        </h1>

        <div class="hero-cta">
          <a href="/quickstart/" class="cta cta-primary">
            <span class="cta-cursor"></span>
            <span>Read the Quickstart</span>
            <span class="cta-arrow">→</span>
          </a>
          <a href={repo} class="cta cta-ghost">
            <span>View on GitHub</span>
            <span class="cta-arrow">↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ── SECTION: Why ────────────────────────────────────────── -->
    <section class="why">
      <div class="why-meta">
        <span class="kicker">§ 01 / The premise</span>
        <span class="meta-rule"></span>
        <span class="kicker-end">read 2 min</span>
      </div>

      <h2 class="why-title">
        Your laptop is fast. Your Mac is bigger. <em>So why is the AI&nbsp;crawling?</em>
      </h2>

      <div class="why-grid">
        <p class="why-lead">
          Code-server over SSH lags. Cursor wants to edit in&#8209;place. Mounted filesystems
          are a coin flip. We pick a different cut: <strong>local stays local, AI stays
          remote, only diffs cross the wire.</strong>
        </p>
        <div class="why-callout">
          <p class="callout-q">
            “Claude is great at editing files. It's flaky at hand-rolling diffs.
            So we let it edit a clean checkout — and derive the diff from git.”
          </p>
          <p class="callout-attr">— The honest take, from the architecture page</p>
        </div>
      </div>
    </section>

    <!-- ── SECTION: Three commands per side ────────────────────── -->
    <section class="three">
      <div class="three-meta">
        <span class="kicker">§ 02 / Three commands per side</span>
        <span class="meta-rule"></span>
        <span class="kicker-end">setup once, run forever</span>
      </div>

      <div class="three-grid">
        <!-- Local card -->
        <article class="term-card term-card-light">
          <header class="term-header">
            <span class="term-dots" aria-hidden="true">
              <span></span><span></span><span></span>
            </span>
            <span class="term-title">laptop / ~ </span>
            <span class="term-host">macbook</span>
          </header>
          <pre class="term-body"><code><span class="t-comment"># 1. install</span>
$ pnpm add -g <span class="t-str">github:rebink/remote_claude</span>

<span class="t-comment"># 2. setup (auto-detects Tailscale peers)</span>
$ remote-claude setup

<span class="t-comment"># 3. ask</span>
$ remote-claude ask <span class="t-str">"refactor login_bloc"</span>
  <span class="t-out">✓ diff returned (412 lines)</span></code></pre>
        </article>

        <!-- Remote card -->
        <article class="term-card term-card-dark">
          <header class="term-header term-header-dark">
            <span class="term-dots term-dots-dark" aria-hidden="true">
              <span></span><span></span><span></span>
            </span>
            <span class="term-title">mini / ~ </span>
            <span class="term-host">mac&#8209;mini</span>
          </header>
          <pre class="term-body term-body-dark"><code><span class="t-comment-d"># 1. install</span>
$ pnpm add -g <span class="t-str-d">github:rebink/remote_claude</span>

<span class="t-comment-d"># 2. register agent as a launchd service</span>
$ remote-claude-agent install
  <span class="t-out-d">→ TOKEN: rc_b9f...</span>

<span class="t-comment-d"># 3. nothing — the agent runs in the background</span></code></pre>
        </article>
      </div>
    </section>

    <!-- ── SECTION: The shape of a request ─────────────────────── -->
    <section class="shape">
      <div class="shape-meta">
        <span class="kicker">§ 03 / The shape of a request</span>
        <span class="meta-rule"></span>
        <span class="kicker-end">one HTTP call, end-to-end</span>
      </div>

      <pre class="shape-diagram" aria-hidden="true">
<span class="d-local">┌──────────────────────────────┐</span>          <span class="d-remote">┌──────────────────────────────┐</span>
<span class="d-local">│ <strong>MacBook</strong>                      │</span>          <span class="d-remote">│ <strong>Mac Mini</strong>                     │</span>
<span class="d-local">│ remote-claude (CLI)          │</span>          <span class="d-remote">│ remote-claude-agent          │</span>
<span class="d-local">│                              │</span>          <span class="d-remote">│                              │</span>
<span class="d-local">│  ◦ source of truth           │</span>  <span class="d-arrow">━━ rsync ━━▶</span>  <span class="d-remote">│  ◦ clean git checkout        │</span>
<span class="d-local">│  ◦ rsync push (one-way)      │</span>          <span class="d-remote">│  ◦ spawn <code>claude --print</code>     │</span>
<span class="d-local">│  ◦ HTTP /ask                 │</span>  <span class="d-arrow">━━━ HTTP ━━▶</span>  <span class="d-remote">│  ◦ capture <code>git diff</code>         │</span>
<span class="d-local">│  ◦ colorized diff preview    │</span>  <span class="d-arrow">◀━ unified ━━</span>  <span class="d-remote">│  ◦ reset working tree        │</span>
<span class="d-local">│  ◦ <code>git apply</code> (selective)    │</span>          <span class="d-remote">│                              │</span>
<span class="d-local">└──────────────────────────────┘</span>          <span class="d-remote">└──────────────────────────────┘</span>
            </pre>

      <p class="shape-note">
        Bearer-token HTTP over Tailscale. SSH keys for the initial sync. Never internet-exposed.
        See the <a href="/architecture/" class="link">architecture page</a> for the request lifecycle.
      </p>
    </section>

    <!-- ── SECTION: Pull-quote feature grid ────────────────────── -->
    <section class="features">
      <div class="features-meta">
        <span class="kicker">§ 04 / Why it's different</span>
        <span class="meta-rule"></span>
      </div>

      <div class="features-grid">
        <article class="feat feat-1">
          <span class="feat-no">01</span>
          <h3 class="feat-h">Reviewable, not magical</h3>
          <p>Every change is a unified diff. <code>git apply -p</code> what you want, drop the rest. The AI never sneaks an edit past you.</p>
        </article>

        <article class="feat feat-2 feat-quote">
          <p class="feat-q">
            “The remote machine never edits&nbsp;your laptop's filesystem&nbsp;directly.”
          </p>
          <p class="feat-q-meta">— the load&#8209;bearing&nbsp;invariant</p>
        </article>

        <article class="feat feat-3">
          <span class="feat-no">02</span>
          <h3 class="feat-h">Full repo context</h3>
          <p>Claude runs with the whole tree on a clean checkout — not the truncated context of FS&#8209;mounted scratch space.</p>
        </article>

        <article class="feat feat-4">
          <span class="feat-no">03</span>
          <h3 class="feat-h">No FS surprises</h3>
          <p>Your hot-reload, your debugger, your file-watcher — all untouched. The AI's machine is its own.</p>
        </article>

        <article class="feat feat-5">
          <span class="feat-no">04</span>
          <h3 class="feat-h">Indie&#8209;tool ergonomics</h3>
          <p>One npm install per side. One YAML config. Five commands you'll remember. No SaaS dashboard.</p>
        </article>

        <article class="feat feat-6 feat-strip">
          <ul class="strip-list">
            <li><strong>Tailscale</strong><span>recommended transport</span></li>
            <li><strong>SSH keys</strong><span>initial sync</span></li>
            <li><strong>Bearer token</strong><span>HTTP auth</span></li>
            <li><strong>MIT</strong><span>open source</span></li>
          </ul>
        </article>
      </div>
    </section>

    <!-- ── SECTION: Final CTA ──────────────────────────────────── -->
    <section class="end">
      <div class="end-grid">
        <h2 class="end-h">
          Push your code <em>there</em>.<br/>
          Pull a diff <em>back</em>.<br/>
          Stay in&nbsp;control.
        </h2>
        <div class="end-actions">
          <a href="/quickstart/" class="cta cta-primary cta-dark">
            <span class="cta-cursor"></span>
            <span>Start the Quickstart</span>
            <span class="cta-arrow">→</span>
          </a>
          <a href="/install-extension/" class="cta cta-ghost cta-ghost-dark">
            <span>Install the VS Code extension</span>
            <span class="cta-arrow">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ── Footer ──────────────────────────────────────────────── -->
    <footer class="foot">
      <div class="foot-grid">
        <div class="foot-mark">
          <span class="wordmark wordmark-dark">
            <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
              <rect x="0.5" y="0.5" width="9" height="9" stroke="currentColor" fill="none"/>
              <rect x="12.5" y="12.5" width="9" height="9" fill="currentColor"/>
              <line x1="6" y1="11" x2="16" y2="11" stroke="currentColor" stroke-dasharray="1 2"/>
            </svg>
            <span>Remote Claude</span>
          </span>
          <p class="foot-blurb">
            Built with restraint. MIT licensed. By people who like their laptops quiet.
          </p>
        </div>
        <nav class="foot-nav" aria-label="Footer">
          <div>
            <h4>Docs</h4>
            <a href="/quickstart/">Quickstart</a>
            <a href="/architecture/">Architecture</a>
            <a href="/configuration/">Configuration</a>
            <a href="/security/">Security model</a>
          </div>
          <div>
            <h4>Reference</h4>
            <a href="/commands/">CLI commands</a>
            <a href="/api/">HTTP API</a>
            <a href="/troubleshooting/">Troubleshooting</a>
            <a href="/faq/">FAQ</a>
          </div>
          <div>
            <h4>Project</h4>
            <a href={repo}>GitHub ↗</a>
            <a href={`${repo}/issues`}>Issues ↗</a>
            <a href={`${repo}/blob/main/LICENSE`}>License ↗</a>
            <a href="/roadmap/">Roadmap</a>
          </div>
        </nav>
      </div>
      <div class="foot-bottom">
        <span>© {new Date().getFullYear()} Remote Claude · v{version} · rev&nbsp;{rev}</span>
        <span class="foot-tag">local-first · ai-remote · diff-reviewable</span>
      </div>
    </footer>

    <style>
      /* ─────────────────────────────────────────────────────────
         LAYOUT TOKENS (page-scoped)
         ───────────────────────────────────────────────────────── */
      :root {
        --gutter: clamp(20px, 4vw, 56px);
        --max: 1400px;
        --seam: 52%;  /* where the bicameral split happens */
      }

      .topbar {
        position: relative;
        z-index: 10;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 32px;
        padding: 22px var(--gutter);
        border-bottom: 1px solid var(--hairline-paper);
        background: var(--paper);
      }

      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 17px;
        letter-spacing: -0.01em;
        color: var(--ink);
      }
      .wordmark svg { color: var(--ink); }

      .topnav {
        display: flex;
        justify-content: center;
        gap: 28px;
        font-size: 14px;
        letter-spacing: 0.005em;
      }
      .topnav a {
        color: var(--charcoal);
        opacity: 0.78;
        transition: opacity 0.15s ease;
      }
      .topnav a:hover { opacity: 1; }

      .rev {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--charcoal);
        opacity: 0.7;
      }
      .rev-dot {
        width: 7px; height: 7px;
        background: var(--phosphor-dim);
        border-radius: 50%;
        box-shadow: 0 0 0 3px rgba(142, 174, 63, 0.12);
        animation: rev-pulse 2.2s ease-in-out infinite;
      }
      @keyframes rev-pulse {
        0%, 100% { opacity: 0.6; }
        50%      { opacity: 1; }
      }

      /* ─────────────────────────────────────────────────────────
         HERO — the bicameral split
         The .hero itself spans the viewport (for the cream/ink fills).
         Content lives inside .hero-grid which respects max-width.
         ───────────────────────────────────────────────────────── */
      .hero {
        position: relative;
        min-height: 92vh;
        overflow: hidden;
        isolation: isolate;
      }

      .hero-paper, .hero-ink {
        position: absolute;
        top: 0;
        bottom: 0;
        z-index: 0;
      }
      .hero-paper {
        left: 0;
        right: calc(100% - var(--seam));
        background: var(--paper);
        background-image:
          radial-gradient(1px 1px at 24% 32%, rgba(14,14,16,0.07) 50%, transparent 51%),
          radial-gradient(1px 1px at 68% 78%, rgba(14,14,16,0.05) 50%, transparent 51%);
        background-size: 240px 240px, 320px 320px;
      }
      .hero-ink {
        left: var(--seam);
        right: 0;
        background: var(--ink);
        background-image:
          radial-gradient(1px 1px at 20% 30%, rgba(201,245,100,0.18) 50%, transparent 51%),
          radial-gradient(1px 1px at 70% 60%, rgba(201,245,100,0.10) 50%, transparent 51%),
          linear-gradient(180deg, transparent 0%, rgba(201,245,100,0.04) 100%);
        background-size: 280px 280px, 360px 360px, 100% 100%;
      }

      /* The wire — hairline across both halves with a traveling patch */
      .wire {
        position: absolute;
        left: 0;
        right: 0;
        top: 38%;
        z-index: 1;
        pointer-events: none;
      }
      .wire-line {
        display: block;
        height: 1px;
        background: linear-gradient(90deg,
          rgba(14,14,16,0.18) 0%,
          rgba(14,14,16,0.18) calc(var(--seam) - 1px),
          var(--phosphor) calc(var(--seam) - 1px),
          var(--phosphor) calc(var(--seam) + 60px),
          rgba(201,245,100,0.25) 100%);
      }
      .wire-patch {
        position: absolute;
        top: -7px;
        left: 0;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--ink);
        animation: patch-travel 5.2s cubic-bezier(0.7, 0, 0.3, 1) 0.6s infinite;
      }
      @keyframes patch-travel {
        0%   { left: 4%;  color: var(--amber); transform: scale(1); }
        45%  { left: calc(var(--seam) - 8px); color: var(--ink); transform: scale(1.1); }
        50%  { left: calc(var(--seam) + 8px); color: var(--phosphor); }
        90%  { left: 92%; color: var(--phosphor); transform: scale(1); }
        100% { left: 92%; color: var(--phosphor); opacity: 0; }
      }

      .hero-grid {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: var(--seam) 1fr;
        grid-template-rows: auto 1fr auto;
        grid-template-areas:
          "local    remote"
          "headline headline"
          "cta      cta";
        gap: clamp(28px, 5vh, 56px) 0;
        padding: 48px var(--gutter) clamp(40px, 5vh, 56px);
        max-width: var(--max);
        margin: 0 auto;
        min-height: 92vh;
      }

      .hero-local, .hero-remote {
        padding-top: 8px;
        max-width: 38ch;
      }
      .hero-local  { grid-area: local; padding-right: clamp(20px, 4vw, 56px); }
      .hero-remote { grid-area: remote; padding-left: clamp(20px, 4vw, 56px); color: var(--bone); }

      .side-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 18px;
      }
      .side-label-dark { color: var(--charcoal); }
      .side-label-light { color: var(--bone); opacity: 0.85; }
      .side-dot {
        width: 6px; height: 6px;
        border-radius: 50%;
        display: inline-block;
      }
      .side-dot-amber    { background: var(--amber); }
      .side-dot-phosphor { background: var(--phosphor); box-shadow: 0 0 6px rgba(201,245,100,0.6); }

      .hero-stanza {
        font-family: var(--font-display);
        font-weight: 380;
        font-size: clamp(18px, 1.6vw, 22px);
        line-height: 1.45;
        color: var(--ink);
        margin: 0 0 22px;
        font-variation-settings: "SOFT" 80, "WONK" 1;
      }

      .hero-snippet {
        font-family: var(--font-mono);
        font-size: 12.5px;
        line-height: 1.65;
        margin: 0;
        padding: 14px 16px;
        border: 1px solid var(--hairline-paper);
        background: rgba(255,255,255,0.55);
        backdrop-filter: blur(3px);
        max-width: 36ch;
      }
      .hero-snippet-dark {
        background: rgba(255,255,255,0.04);
        border-color: var(--hairline-ink);
        color: var(--bone);
      }
      .sn-q { color: var(--amber-dim); }
      .sn-cont { color: var(--charcoal); opacity: 0.7; }
      .prompt-host { color: rgba(232, 226, 208, 0.55); }
      .prompt-arrow { color: var(--phosphor); margin-right: 6px; }
      .sn-out { color: rgba(232, 226, 208, 0.55); display: inline-block; }
      .sn-out-ok { color: var(--phosphor); display: inline-block; }

      /* The headline — two layers, each color-clipped to its half.
         Lives in the grid's middle row; spans both columns so its 0–100%
         width matches the bicameral seam at exactly 52%. */
      .hero-headline {
        grid-area: headline;
        position: relative;
        z-index: 3;
        align-self: center;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(38px, 7vw, 102px);
        line-height: 0.96;
        letter-spacing: -0.035em;
        margin: 0;
        font-variation-settings: "SOFT" 30, "opsz" 144;
        pointer-events: none;
      }
      .headline-layer {
        display: block;
      }
      /* The first layer establishes the headline's natural height.
         The second layer is overlaid via absolute positioning so the two
         clipped views align perfectly across the seam. */
      .headline-paper {
        position: relative;
        color: var(--ink);
        clip-path: inset(0 calc(100% - var(--seam)) 0 0);
      }
      .headline-ink {
        position: absolute;
        inset: 0;
        color: var(--bone);
        clip-path: inset(0 0 0 var(--seam));
      }
      .hl-italic { font-style: italic; font-weight: 380; font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 144; }
      .hl-accent-amber { color: var(--amber-dim); }
      .hl-accent-phosphor { color: var(--phosphor); }

      /* Stagger reveal */
      .hl-word {
        display: inline-block;
        opacity: 0;
        transform: translateY(0.4em);
        animation: hl-rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
        animation-delay: calc(0.08s * var(--i) + 0.1s);
        margin-right: 0.22em;
      }
      @keyframes hl-rise {
        to { opacity: 1; transform: translateY(0); }
      }

      .hero-cta {
        grid-area: cta;
        position: relative;
        z-index: 4;
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        animation: cta-rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 1.1s both;
      }
      @keyframes cta-rise {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      .cta {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 14px 22px;
        font-family: var(--font-mono);
        font-size: 13px;
        letter-spacing: 0.01em;
        border: 1px solid transparent;
        transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
      }
      .cta:hover { transform: translateY(-1px); }
      .cta-arrow { transition: transform 0.18s ease; }
      .cta:hover .cta-arrow { transform: translate(2px, -1px); }

      .cta-primary {
        background: var(--phosphor);
        color: var(--ink);
        border-color: var(--phosphor);
      }
      .cta-primary:hover { background: #d4f878; }

      .cta-ghost {
        background: transparent;
        color: var(--ink);
        border-color: var(--rule-paper);
      }
      .cta-ghost:hover { background: rgba(14,14,16,0.04); border-color: var(--ink); }
      .cta-ghost-dark { color: var(--bone); border-color: rgba(232, 226, 208, 0.25); }
      .cta-ghost-dark:hover { background: rgba(232, 226, 208, 0.06); border-color: var(--bone); }
      .cta-dark { background: var(--phosphor); color: var(--ink); }

      .cta-cursor {
        width: 8px;
        height: 14px;
        background: currentColor;
        opacity: 0.85;
        animation: blink 1.1s steps(2) infinite;
      }
      @keyframes blink {
        50% { opacity: 0; }
      }

      /* ─────────────────────────────────────────────────────────
         SECTION: meta header rows (used by §01, §02, …)
         ───────────────────────────────────────────────────────── */
      .why, .three, .shape, .features {
        padding: clamp(64px, 9vw, 120px) var(--gutter);
        max-width: var(--max);
        margin: 0 auto;
      }

      .why-meta, .three-meta, .shape-meta, .features-meta {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 20px;
        margin-bottom: 56px;
      }
      .kicker, .kicker-end {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--charcoal);
        opacity: 0.55;
      }
      .meta-rule {
        height: 1px;
        background: var(--rule-paper);
      }

      /* ─────────────────────────────────────────────────────────
         WHY
         ───────────────────────────────────────────────────────── */
      .why {
        background: var(--paper);
        border-top: 1px solid var(--hairline-paper);
      }
      .why-title {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(32px, 4.6vw, 68px);
        line-height: 1.04;
        letter-spacing: -0.025em;
        margin: 0 0 48px;
        max-width: 22ch;
        font-variation-settings: "SOFT" 30, "opsz" 144;
      }
      .why-title em {
        font-style: italic;
        font-weight: 380;
        font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 144;
        color: var(--amber-dim);
      }
      .why-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: clamp(40px, 6vw, 96px);
        align-items: start;
      }
      .why-lead {
        font-size: 19px;
        line-height: 1.55;
        margin: 0;
        max-width: 38ch;
      }
      .why-lead strong { font-weight: 600; color: var(--ink); }
      .why-callout {
        border-left: 1px solid var(--ink);
        padding: 4px 0 4px 28px;
      }
      .callout-q {
        font-family: var(--font-display);
        font-weight: 380;
        font-style: italic;
        font-size: 22px;
        line-height: 1.4;
        margin: 0 0 14px;
        font-variation-settings: "SOFT" 100, "WONK" 1;
        color: var(--ink);
      }
      .callout-attr {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--charcoal);
        opacity: 0.7;
        margin: 0;
      }

      /* ─────────────────────────────────────────────────────────
         THREE (terminal cards)
         ───────────────────────────────────────────────────────── */
      .three {
        background: var(--paper);
      }
      .three-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 28px;
      }
      .term-card {
        border: 1px solid var(--hairline-paper);
        overflow: hidden;
        position: relative;
      }
      .term-card-light {
        background: #FBF8EF;
      }
      .term-card-dark {
        background: var(--ink);
        border-color: var(--hairline-ink);
        color: var(--bone);
      }
      .term-card::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          linear-gradient(90deg, transparent 0, transparent 100%);
        transition: background 0.3s ease;
      }
      .term-card:hover::before {
        background: linear-gradient(180deg, transparent 0, rgba(201,245,100,0.04) 100%);
      }
      .term-header {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 14px;
        padding: 10px 16px;
        border-bottom: 1px solid var(--hairline-paper);
        background: rgba(14,14,16,0.03);
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.05em;
        color: var(--charcoal);
      }
      .term-header-dark {
        background: rgba(232, 226, 208, 0.04);
        border-bottom-color: var(--hairline-ink);
        color: rgba(232, 226, 208, 0.7);
      }
      .term-dots { display: inline-flex; gap: 6px; }
      .term-dots span {
        width: 9px; height: 9px;
        border-radius: 50%;
        background: rgba(14,14,16,0.18);
      }
      .term-dots-dark span { background: rgba(232, 226, 208, 0.22); }
      .term-title { letter-spacing: 0.04em; opacity: 0.8; }
      .term-host { opacity: 0.5; text-transform: uppercase; font-size: 10px; }
      .term-body {
        margin: 0;
        padding: 22px 24px 26px;
        font-family: var(--font-mono);
        font-size: 13px;
        line-height: 1.7;
        color: var(--ink);
        overflow-x: auto;
      }
      .term-body-dark { color: var(--bone); }
      .t-comment { color: var(--charcoal); opacity: 0.5; }
      .t-comment-d { color: rgba(232, 226, 208, 0.45); }
      .t-str { color: var(--amber-dim); }
      .t-str-d { color: var(--amber); }
      .t-out { color: var(--phosphor-dim); }
      .t-out-d { color: var(--phosphor); }

      /* ─────────────────────────────────────────────────────────
         SHAPE — the diagram, treated as editorial art
         ───────────────────────────────────────────────────────── */
      .shape {
        background: var(--paper);
        border-top: 1px solid var(--hairline-paper);
      }
      .shape-diagram {
        font-family: var(--font-mono);
        font-size: clamp(11px, 1.05vw, 14px);
        line-height: 1.45;
        margin: 0 0 32px;
        white-space: pre;
        overflow-x: auto;
        padding: 24px;
        background: #FBF8EF;
        border: 1px solid var(--hairline-paper);
      }
      .d-local { color: var(--charcoal); }
      .d-remote { color: var(--charcoal); opacity: 0.7; }
      .d-arrow { color: var(--amber-dim); font-weight: 600; }
      .shape-diagram strong { font-weight: 700; }
      .shape-diagram code {
        font-family: inherit;
        background: rgba(201,245,100,0.20);
        padding: 0 4px;
        color: var(--ink);
      }
      .shape-note {
        font-size: 15px;
        max-width: 60ch;
        margin: 0;
        color: var(--charcoal);
      }
      .link {
        border-bottom: 1px solid var(--ink);
        padding-bottom: 1px;
        transition: color 0.15s;
      }
      .link:hover { color: var(--amber-dim); border-bottom-color: var(--amber-dim); }

      /* ─────────────────────────────────────────────────────────
         FEATURES (asymmetric grid w/ pull-quote)
         ───────────────────────────────────────────────────────── */
      .features {
        background: var(--paper);
        border-top: 1px solid var(--hairline-paper);
      }
      .features-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: 1fr 1fr auto;
        gap: 1px;
        background: var(--hairline-paper);
        border: 1px solid var(--hairline-paper);
      }
      .feat-1 { grid-area: 1 / 1 / 2 / 2; }
      .feat-2 { grid-area: 1 / 2 / 3 / 3; }   /* dark quote spans 2 rows */
      .feat-3 { grid-area: 1 / 3 / 2 / 4; }
      .feat-4 { grid-area: 2 / 1 / 3 / 2; }
      .feat-5 { grid-area: 2 / 3 / 3 / 4; }
      .feat-6 { grid-area: 3 / 1 / 4 / 4; }   /* strip across the bottom */
      .feat {
        background: var(--paper);
        padding: 36px 28px;
        position: relative;
        transition: background 0.2s ease;
      }
      .feat:hover { background: #FBF8EF; }
      .feat-no {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        color: var(--amber-dim);
        margin-bottom: 28px;
        display: inline-block;
      }
      .feat-h {
        font-family: var(--font-display);
        font-weight: 460;
        font-size: 22px;
        line-height: 1.2;
        letter-spacing: -0.015em;
        margin: 0 0 12px;
        color: var(--ink);
      }
      .feat p {
        margin: 0;
        font-size: 14.5px;
        line-height: 1.6;
        color: var(--charcoal);
      }
      .feat code {
        font-family: var(--font-mono);
        background: rgba(201,245,100,0.22);
        padding: 1px 5px;
        font-size: 0.92em;
        color: var(--ink);
      }
      .feat-quote {
        background: var(--ink);
        color: var(--bone);
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 44px 32px;
      }
      .feat-quote:hover { background: var(--ink-edge); }
      .feat-quote .feat-q {
        font-family: var(--font-display);
        font-style: italic;
        font-weight: 380;
        font-size: clamp(20px, 1.9vw, 28px);
        line-height: 1.32;
        margin: 0 0 18px;
        color: var(--bone);
        font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 144;
      }
      .feat-quote .feat-q-meta {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--phosphor);
        margin: 0;
      }
      .feat-strip {
        grid-column: span 3;
        padding: 28px;
        background: #FBF8EF;
      }
      .feat-strip:hover { background: #FBF8EF; }
      .strip-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 28px;
      }
      .strip-list li {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-family: var(--font-mono);
        font-size: 13px;
        border-left: 2px solid var(--amber);
        padding-left: 14px;
      }
      .strip-list li strong { color: var(--ink); }
      .strip-list li span { color: var(--charcoal); opacity: 0.6; font-size: 11px; }

      /* ─────────────────────────────────────────────────────────
         END / final CTA
         ───────────────────────────────────────────────────────── */
      .end {
        background: var(--ink);
        color: var(--bone);
        padding: clamp(72px, 11vw, 140px) var(--gutter);
        border-top: 1px solid var(--hairline-ink);
        position: relative;
        overflow: hidden;
      }
      .end::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
          radial-gradient(60% 80% at 80% 20%, rgba(201,245,100,0.08) 0%, transparent 70%),
          radial-gradient(40% 60% at 20% 80%, rgba(255,140,66,0.05) 0%, transparent 70%);
        pointer-events: none;
      }
      .end-grid {
        position: relative;
        max-width: var(--max);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 64px;
        align-items: end;
      }
      .end-h {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(36px, 5.4vw, 84px);
        line-height: 1.02;
        letter-spacing: -0.03em;
        margin: 0;
        font-variation-settings: "SOFT" 30, "opsz" 144;
      }
      .end-h em {
        font-style: italic;
        font-weight: 380;
        font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 144;
        color: var(--phosphor);
      }
      .end-actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
        align-items: stretch;
      }

      /* ─────────────────────────────────────────────────────────
         FOOTER
         ───────────────────────────────────────────────────────── */
      .foot {
        background: var(--ink);
        color: var(--bone);
        padding: 56px var(--gutter) 32px;
        border-top: 1px solid var(--hairline-ink);
      }
      .foot-grid {
        max-width: var(--max);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.2fr 2fr;
        gap: 56px;
        padding-bottom: 36px;
        border-bottom: 1px solid var(--hairline-ink);
      }
      .wordmark-dark { color: var(--bone); }
      .wordmark-dark svg { color: var(--bone); }
      .foot-blurb {
        margin: 14px 0 0;
        max-width: 36ch;
        font-size: 14px;
        line-height: 1.55;
        color: rgba(232, 226, 208, 0.6);
      }
      .foot-nav {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 36px;
      }
      .foot-nav h4 {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(232, 226, 208, 0.5);
        margin: 0 0 16px;
      }
      .foot-nav a {
        display: block;
        font-size: 14px;
        line-height: 1.95;
        color: rgba(232, 226, 208, 0.85);
        transition: color 0.15s;
      }
      .foot-nav a:hover { color: var(--phosphor); }
      .foot-bottom {
        max-width: var(--max);
        margin: 0 auto;
        padding-top: 24px;
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        font-family: var(--font-mono);
        font-size: 11px;
        color: rgba(232, 226, 208, 0.4);
      }
      .foot-tag {
        letter-spacing: 0.06em;
        color: var(--phosphor);
        opacity: 0.7;
      }

      /* ─────────────────────────────────────────────────────────
         REDUCED MOTION
         ───────────────────────────────────────────────────────── */
      @media (prefers-reduced-motion: reduce) {
        .hl-word, .hero-cta { animation: none; opacity: 1; transform: none; }
        .wire-patch, .rev-dot, .cta-cursor { animation: none; }
      }

      /* ─────────────────────────────────────────────────────────
         RESPONSIVE — collapse the bicameral split below 900px
         ───────────────────────────────────────────────────────── */
      @media (max-width: 900px) {
        :root { --seam: 100%; }
        .topbar { grid-template-columns: 1fr auto; gap: 16px; }
        .topnav { display: none; }
        .hero-paper { right: 0; }
        .hero-ink {
          left: 0;
          top: auto;
          bottom: 0;
          height: 50%;
        }
        .hero-grid {
          grid-template-columns: 1fr;
          grid-template-areas:
            "local"
            "remote"
            "headline"
            "cta";
          padding-top: 32px;
          min-height: auto;
        }
        .hero-local, .hero-remote {
          padding: 0;
          max-width: 100%;
        }
        .hero-remote { padding-top: 36px; }
        .hero-headline {
          margin: 8px 0 0;
          font-size: clamp(36px, 11vw, 56px);
        }
        .headline-paper { clip-path: none; }
        .headline-ink   { display: none; }
        .hero-cta { padding: 0 0 24px; }
        .wire { display: none; }
        .why-grid, .three-grid, .end-grid { grid-template-columns: 1fr; gap: 36px; }
        .features-grid { grid-template-columns: 1fr 1fr; }
        .feat-strip { grid-column: span 2; }
        .strip-list { grid-template-columns: 1fr 1fr; }
        .foot-grid { grid-template-columns: 1fr; gap: 36px; }
        .foot-nav { grid-template-columns: repeat(3, 1fr); gap: 24px; }
      }
      @media (max-width: 560px) {
        .features-grid { grid-template-columns: 1fr; }
        .feat-strip { grid-column: span 1; }
        .strip-list { grid-template-columns: 1fr; }
        .foot-nav { grid-template-columns: 1fr 1fr; }
      }
    </style>
  </body>
</html>
