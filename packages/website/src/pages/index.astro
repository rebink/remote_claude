                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="hero-cta reveal">
          <a href="vscode:extension/patchwire.patchwire-vscode" class="cta cta-primary magnet">
            <span class="cta-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                <path d="M22 4.5l-9.5 7.5L22 19.5V4.5z" fill="currentColor"/>
                <path d="M3 8l5 5v6l9.5-7.5L8 4v6l-5-2z" fill="currentColor" opacity="0.85"/>
              </svg>
            </span>
            <span>Install for VS Code</span>
            <span class="cta-arrow">→</span>
          </a>
          <a href="/install-extension/" class="cta cta-ghost magnet">
            <span>other editors / .vsix</span>
            <span class="cta-arrow">→</span>
          </a>
        </div>

        <div class="hero-byline reveal">
          <span aria-hidden="true">↓ scroll</span>
          <span class="byline-line" aria-hidden="true"></span>
          <a href={repo} class="byline-link">github.com/rebink/remote_claude ↗</a>
        </div>
      </div>
    </section>


    <!-- ───────── SECTION: SURFACES (VS CODE + CLI) ───────── -->
    <section class="editor">
      <div class="editor-grid">
        <div class="editor-prose">
          <span class="kicker reveal"><span class="kicker-bar"></span>01 · the extension</span>
          <h2 class="editor-h reveal">
            One panel. <em>Your remote, in sync.</em>
          </h2>
          <p class="editor-sub reveal">
            A side panel in VS Code that drives one thing well: a Claude Code session
            running on a machine you control. Hit <strong>Focus Claude session</strong>
            to drop into the live REPL, and two-way sync keeps your laptop and the
            remote byte-identical the whole time.
          </p>
          <ul class="editor-bullets reveal">
            <li><span class="bullet-mark">▢</span> Focus Claude session: the real Claude Code REPL, in a terminal on your remote</li>
            <li><span class="bullet-mark">▢</span> Two-way sync: laptop and remote stay byte-identical; flush or pause from the panel</li>
            <li><span class="bullet-mark">▢</span> Setup wizard: connect a remote and install a per-project key in a few clicks</li>
            <li><span class="bullet-mark">▢</span> Runs on hardware you own, never a vendor's cloud</li>
          </ul>
          <div class="editor-cta reveal">
            <a href="vscode:extension/patchwire.patchwire-vscode" class="cta cta-primary magnet">
              <span class="cta-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                  <path d="M22 4.5l-9.5 7.5L22 19.5V4.5z" fill="currentColor"/>
                  <path d="M3 8l5 5v6l9.5-7.5L8 4v6l-5-2z" fill="currentColor" opacity="0.85"/>
                </svg>
              </span>
              <span>Install for VS Code</span>
              <span class="cta-arrow">→</span>
            </a>
            <a href="/install-extension/" class="cta cta-link magnet">
              <span>other editors / .vsix</span>
              <span class="cta-arrow">→</span>
            </a>
          </div>
          <p class="editor-cta-fallback reveal">
            Button not opening VS Code? Install from the
            <a href="https://marketplace.visualstudio.com/items?itemName=patchwire.patchwire-vscode" target="_blank" rel="noopener">Marketplace</a>
            or <a href="https://open-vsx.org/extension/patchwire/patchwire-vscode" target="_blank" rel="noopener">Open VSX</a>.
          </p>
        </div>
      </div>
    </section>


    <!-- ───────── SECTION: CTA ───────── -->
    <section class="endcta">
      <div class="endcta-inner">
        <span class="kicker reveal">↓ get started</span>
        <h2 class="endcta-h reveal">
          Bring Claude into<br/>
          <em>your editor.</em>
        </h2>
        <p class="endcta-sub reveal">
          Install the extension. It runs on your machine, and your code never leaves
          your network.
        </p>
        <div class="endcta-actions reveal">
          <a href="vscode:extension/patchwire.patchwire-vscode" class="cta cta-primary magnet cta-lg">
            <span>Install for VS Code</span>
            <span class="cta-arrow">→</span>
          </a>
          <a href={repo} class="cta cta-ghost magnet cta-lg">
            <span>View on GitHub</span>
            <span class="cta-arrow">↗</span>
          </a>
        </div>
      </div>
    </section>

    </main>

    <!-- ───────── FOOTER ───────── -->
    <footer class="foot">
      <div class="foot-grid">
        <div class="foot-mark">
          <span class="wordmark wordmark-dark">
            <svg width="26" height="26" viewBox="0 0 22 22" aria-hidden="true">
              <rect x="0.5" y="0.5" width="9" height="9" stroke="currentColor" stroke-width="1.8" fill="none"/>
              <rect x="12.5" y="12.5" width="9" height="9" fill="currentColor"/>
              <line x1="6" y1="11" x2="16" y2="11" stroke="currentColor" stroke-width="1.4" stroke-dasharray="1.4 2"/>
              <circle cx="11" cy="11" r="1.5" fill="#C9F564"/>
            </svg>
            <span>Patchwire</span>
          </span>
          <p class="foot-blurb">
            Built with restraint. MIT licensed. By people who like their laptops quiet.
          </p>
        </div>
        <nav class="foot-nav" aria-label="Footer">
          <div>
            <h4>Read</h4>
            <a href="/quickstart/">Quickstart</a>
            <a href="/multi-developer/">Multi-developer</a>
            <a href="/architecture/">Architecture</a>
            <a href="/configuration/">Configuration</a>
            <a href="/security/">Security model</a>
            <a href="/faq/">FAQ</a>
          </div>
          <div>
            <h4>Build</h4>
            <a href="/commands/">CLI commands</a>
            <a href="/api/">HTTP API</a>
            <a href="/install-extension/">VS Code extension</a>
            <a href="/troubleshooting/">Troubleshooting</a>
            <a href="/roadmap/">Roadmap</a>
          </div>
        </nav>
      </div>
      <div class="foot-bottom">
        <span>© {new Date().getFullYear()} Patchwire · v{version} · rev&nbsp;{rev}</span>
        <span class="foot-project-links">
          <a href={repo}>GitHub ↗</a>
          <span class="foot-sep" aria-hidden="true">·</span>
          <a href={`${repo}/issues`}>Issues ↗</a>
          <span class="foot-sep" aria-hidden="true">·</span>
          <a href={`${repo}/blob/main/LICENSE`}>MIT License ↗</a>
        </span>
        <span class="foot-tag">self-hosted · ai-agnostic · diff-reviewable</span>
      </div>
    </footer>

    <!-- ═══════════════════════════════════════════════════════════
         INTERACTIVE JS — built with safe DOM methods.
         data-astro-rerun: re-execute these IIFEs after every
         view-transition navigation back to this page, so the
         hero typewriter / spotlight / magnet / tilt / reveal
         observers re-initialise against the fresh DOM.
         ═══════════════════════════════════════════════════════════ -->
    <script is:inline>
      // Wrap every page-side IIFE in bindAll() so we can re-attach
      // observers and event listeners after Astro view transitions.
      // bindAll() runs once on initial paint, then again on every
      // `astro:page-load` (which fires both on first load and on
      // every SPA arrival to this route).
      function bindAll() {
      // Single source-of-truth for motion preference
      const prefersReducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ─── 1. Cursor-tracking spotlight on hero ───
      (() => {
        const spot = document.getElementById('spotlight');
        const hero = document.getElementById('hero');
        if (!spot || !hero || matchMedia('(pointer: coarse)').matches || prefersReducedMotion) return;
        let raf = 0, tx = 50, ty = 30;
        function update(e) {
          const r = hero.getBoundingClientRect();
          tx = ((e.clientX - r.left) / r.width) * 100;
          ty = ((e.clientY - r.top) / r.height) * 100;
          if (!raf) raf = requestAnimationFrame(apply);
        }
        function apply() {
          spot.style.setProperty('--x', tx + '%');
          spot.style.setProperty('--y', ty + '%');
          raf = 0;
        }
        hero.addEventListener('pointermove', update);
        hero.addEventListener('pointerleave', () => {
          tx = 50; ty = 30; apply();
        });
      })();

      // ─── 2. Scroll reveal ───
      (() => {
        const els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
          els.forEach(e => e.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
        els.forEach(e => io.observe(e));
      })();

      // ─── 3. Magnetic CTA ───
      (() => {
        if (matchMedia('(pointer: coarse)').matches || prefersReducedMotion) return;
        document.querySelectorAll('.magnet').forEach(el => {
          let raf = 0, tx = 0, ty = 0;
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            tx = ((e.clientX - r.left) / r.width - 0.5) * 14;
            ty = ((e.clientY - r.top) / r.height - 0.5) * 10;
            if (!raf) raf = requestAnimationFrame(() => {
              el.style.transform = 'translate(' + tx + 'px, ' + ty + 'px)';
              raf = 0;
            });
          });
          el.addEventListener('pointerleave', () => { el.style.transform = ''; });
        });
      })();

      // ─── 4. Terminal typewriter (built with safe DOM methods) ───
      (() => {
        const term = document.getElementById('term');
        if (!term) return;
        const lines = term.querySelectorAll('.term-line');
        const diff = document.getElementById('termDiff');
        const actions = document.getElementById('termActions');
        let started = false;

        function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

        function makeEl(tag, cls, text) {
          const el = document.createElement(tag);
          if (cls) el.className = cls;
          if (text != null) el.textContent = text;
          return el;
        }

        async function typeLine(el) {
          const text = el.dataset.typewrite;
          if (!text) return 0;
          el.textContent = '';
          if (prefersReducedMotion) {
            el.textContent = text;
            return 0;
          }
          const caret = makeEl('span', 'caret');
          el.appendChild(caret);
          for (let i = 0; i < text.length; i++) {
            el.insertBefore(document.createTextNode(text[i]), caret);
            await sleep(text.length > 30 ? 18 : 28);
          }
          caret.remove();
          return parseInt(el.dataset.after || '500', 10);
        }

        function renderStep(el) {
          const step = el.dataset.step || '';
          const detail = el.dataset.stepDetail || '';
          el.textContent = '';
          el.appendChild(makeEl('span', 'step-arrow', '→'));
          el.appendChild(makeEl('span', 'step-key', step));
          el.appendChild(makeEl('span', 'step-dot'));
          el.appendChild(makeEl('span', 'step-detail', detail));
          el.appendChild(makeEl('span', 'step-ok', '✓'));
          el.classList.add('is-in');
          return parseInt(el.dataset.after || '600', 10);
        }

        async function play() {
          if (started) return;
          started = true;
          for (const line of lines) {
            let wait;
            if (line.classList.contains('term-line-step')) wait = renderStep(line);
            else wait = await typeLine(line);
            await sleep(wait);
          }
          diff.classList.add('is-in');
          await sleep(900);
          actions.classList.add('is-in');
        }

        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            for (const e of entries) {
              if (e.isIntersecting) { play(); io.disconnect(); break; }
            }
          }, { threshold: 0.2 });
          io.observe(term);
        } else {
          play();
        }
      })();

      // ─── 5. Tilt cards (lightweight 3D hover) ───
      (() => {
        if (matchMedia('(pointer: coarse)').matches || prefersReducedMotion) return;
        document.querySelectorAll('[data-tilt]').forEach(card => {
          let raf = 0, rx = 0, ry = 0;
          card.addEventListener('pointermove', (e) => {
            const r = card.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width - 0.5;
            const py = (e.clientY - r.top) / r.height - 0.5;
            ry = px * 8;
            rx = -py * 6;
            if (!raf) raf = requestAnimationFrame(() => {
              card.style.transform = 'perspective(900px) rotateX(' + rx + 'deg) rotateY(' + ry + 'deg) translateZ(2px)';
              raf = 0;
            });
          });
          card.addEventListener('pointerleave', () => { card.style.transform = ''; });
        });
      })();
      } /* end bindAll() */

      // First paint
      bindAll();
      // Subsequent SPA arrivals via Astro view transitions
      document.addEventListener('astro:page-load', bindAll);
    </script>

    <!-- ═══════════════════════════════════════════════════════════
         STYLES
         ═══════════════════════════════════════════════════════════ -->
    <style>
      /* ─── tokens / page ─── */
      :root {
        --gutter: clamp(20px, 4.5vw, 64px);
        --max: 1240px;
      }
      /* Win over custom.css's .rc-brand body cream bg with higher specificity */
      html.rc-brand body.page {
        background: var(--rc-ink);
        color: var(--rc-bone);
        font-family: var(--rc-font-body);
        font-feature-settings: 'ss01','ss02','cv11';
        -webkit-font-smoothing: antialiased;
        margin: 0;
      }
      html.rc-brand.rc-dark { background: var(--rc-ink); }
      .page ::selection { background: var(--rc-phosphor); color: var(--rc-ink); }

      /* ─── reveal animation ─── */
      .reveal {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
        will-change: opacity, transform;
      }
      .reveal.is-in { opacity: 1; transform: none; }

      /* ─── skip-to-content link ─── */
      .skip-link {
        position: absolute;
        top: -100px;
        left: 16px;
        z-index: 100;
        padding: 10px 16px;
        background: var(--rc-phosphor);
        color: var(--rc-ink);
        font-family: var(--rc-font-mono);
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        border-radius: 6px;
        box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.6);
        transition: top 0.18s ease;
      }
      .skip-link:focus-visible {
        top: 12px;
        outline: 2px solid var(--rc-ink);
        outline-offset: 2px;
      }

      /* ─── global focus-visible rings (keyboard a11y) ─── */
      .page :focus { outline: none; }
      .page a:focus-visible,
      .page button:focus-visible,
      .page [tabindex]:focus-visible {
        outline: 2px solid var(--rc-phosphor);
        outline-offset: 3px;
        border-radius: 4px;
      }
      .page .cta-primary:focus-visible {
        outline-color: var(--rc-bone);
      }

      /* ─── active nav state (aria-current=page) ─── */
      .topnav a[aria-current="page"] {
        opacity: 1;
        color: var(--rc-phosphor);
      }
      .topnav a[aria-current="page"]::after {
        right: 0;
      }

      /* ═══════════════════════════════════════════════════════════
         TOP BAR
         ═══════════════════════════════════════════════════════════ */
      .topbar {
        position: sticky;
        top: 0;
        z-index: 50;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 32px;
        padding: 18px var(--gutter);
        background: rgba(14, 14, 16, 0.72);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--rc-hairline-ink);
      }
      .wordmark {
        display: inline-flex; align-items: center; gap: 10px;
        font-family: var(--rc-font-display);
        font-weight: 500; font-size: 17px; line-height: 1; letter-spacing: -0.01em;
        color: var(--rc-bone);
        text-decoration: none;
        transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
        /* Cross-page morph: the browser animates the wordmark
           from its position on the previous page to its position
           on the next page via the View Transitions API. The
           line-height: 1 above is critical — it matches the docs
           page's .site-title so the "Patchwire" text baseline
           stays put during the morph instead of bouncing 2-3px. */
        view-transition-name: brand-wordmark;
      }
      .wordmark svg {
        transition: transform 0.4s cubic-bezier(0.32, 0.72, 0, 1);
      }
      .wordmark:hover { transform: translateX(0.5px); }
      .wordmark:hover svg { transform: translateY(-0.5px) scale(1.04); }
      .topnav { display: flex; justify-content: center; gap: 28px; font-size: 14px; }
      .topnav a {
        color: var(--rc-bone);
        opacity: 0.72;
        position: relative;
        transition: opacity 0.2s ease;
      }
      .topnav a::after {
        content: '';
        position: absolute;
        bottom: -6px; left: 0; right: 100%;
        height: 1px;
        background: var(--rc-phosphor);
        transition: right 0.28s cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      .topnav a:hover { opacity: 1; }
      .topnav a:hover::after { right: 0; }

      .meta-pill {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 6px 12px;
        border-radius: 999px;
        background: rgba(232, 226, 208, 0.05);
        border: 1px solid var(--rc-hairline-ink);
        font-family: var(--rc-font-mono);
        font-size: 11px;
        color: var(--rc-bone-dim);
      }
      .meta-dot {
        width: 6px; height: 6px; border-radius: 50%;
        background: var(--rc-phosphor);
        box-shadow: 0 0 0 3px rgba(201, 245, 100, 0.18);
        animation: pulse 2.2s ease-in-out infinite;
      }
      @keyframes pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }

      /* ═══════════════════════════════════════════════════════════
         HERO
         ═══════════════════════════════════════════════════════════ */
      .hero {
        position: relative;
        overflow: hidden;
        padding: clamp(72px, 9vw, 132px) var(--gutter) clamp(72px, 9vw, 120px);
      }
      .hero-bg { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
      .hero-grid-bg {
        position: absolute; inset: 0;
        background:
          linear-gradient(rgba(232, 226, 208, 0.025) 1px, transparent 1px) 0 0 / 100% 80px,
          linear-gradient(90deg, rgba(232, 226, 208, 0.025) 1px, transparent 1px) 0 0 / 80px 100%;
        mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 0%, transparent 90%);
        -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 0%, transparent 90%);
      }
      .hero-spotlight {
        --x: 50%; --y: 30%;
        position: absolute; inset: 0;
        background: radial-gradient(
          480px circle at var(--x) var(--y),
          rgba(201, 245, 100, 0.06),
          transparent 50%
        );
        transition: background 0.18s linear;
      }
      .hero-glow {
        position: absolute;
        width: 520px; height: 520px;
        border-radius: 50%;
        filter: blur(140px);
        opacity: 0.14;
      }
      .hero-glow-phos { background: var(--rc-phosphor); top: -220px; right: -220px; }
      .hero-glow-amber { background: var(--rc-amber-dim); bottom: -240px; left: -260px; opacity: 0.10; }

      .hero-inner {
        position: relative;
        z-index: 1;
        max-width: var(--max);
        margin: 0 auto;
        display: grid;
        gap: clamp(28px, 3.5vw, 40px);
      }

      .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--rc-bone-dim);
        flex-wrap: wrap;
      }
      .eyebrow-tag {
        padding: 4px 10px;
        border: 1px solid var(--rc-hairline-ink);
        border-radius: 4px;
        color: var(--rc-phosphor);
        background: rgba(201, 245, 100, 0.06);
      }
      .eyebrow-sep { opacity: 0.4; }
      .eyebrow-status { display: inline-flex; align-items: center; gap: 6px; }
      .eyebrow-pulse {
        width: 6px; height: 6px;
        border-radius: 50%;
        background: var(--rc-phosphor);
        box-shadow: 0 0 0 3px rgba(201, 245, 100, 0.18);
        animation: pulse 2.2s ease-in-out infinite;
      }

      .hero-h {
        font-family: var(--rc-font-display);
        font-weight: 400;
        font-size: clamp(48px, 9.6vw, 148px);
        line-height: 0.92;
        letter-spacing: -0.04em;
        color: var(--rc-bone);
        margin: 0;
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
        max-width: 14ch;
      }
      .hero-h-line {
        display: block;
        opacity: 0;
        transform: translateY(0.4em);
        animation: hero-rise 0.85s cubic-bezier(0.16, 0.85, 0.3, 1) forwards;
      }
      .hero-h-line:nth-child(1) { animation-delay: 0.12s; }
      .hero-h-line:nth-child(2) { animation-delay: 0.24s; }
      .hero-h-line:nth-child(3) { animation-delay: 0.36s; }
      .hero-h em {
        font-style: italic;
        font-weight: 380;
        color: var(--rc-phosphor);
        font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
      }
      @keyframes hero-rise { to { opacity: 1; transform: none; } }

      .hero-sub {
        font-size: clamp(17px, 1.55vw, 22px);
        line-height: 1.5;
        color: var(--rc-bone-dim);
        margin: 0;
        max-width: 52ch;
      }
      .hero-sub strong { color: var(--rc-bone); font-weight: 600; }

      /* ─── Hero VS Code mock (the star) ─── */
      .hero-mock {
        width: 100%;
        max-width: 840px;
        margin: 8px auto 0;
        perspective: 1600px;
      }
      .hero-mock .vscode { width: 100%; }
      .term-dots { display: inline-flex; gap: 6px; }
      .term-dots span {
        width: 10px; height: 10px;
        border-radius: 50%;
        background: rgba(232, 226, 208, 0.16);
      }
      .term-dots span:nth-child(1) { background: #FF5F57; opacity: 0.85; }
      .term-dots span:nth-child(2) { background: #FEBC2E; opacity: 0.85; }
      .term-dots span:nth-child(3) { background: #28C840; opacity: 0.85; }
      .term-line { display: block; min-height: 1.75em; color: var(--rc-bone); }
      .term-line-step {
        opacity: 0;
        transform: translateY(4px);
        transition: opacity 0.3s ease, transform 0.3s ease;
        display: grid;
        grid-template-columns: 18px 80px 14px 1fr auto;
        align-items: center;
        gap: 8px;
      }
      .term-line-step.is-in { opacity: 1; transform: none; }
      @keyframes pop-in { from { transform: scale(0.4); opacity: 0; } to { transform: scale(1); opacity: 1; } }
      @keyframes blink { 50% { opacity: 0; } }
      .term-diff.is-in { opacity: 1; }
      .term-actions.is-in { opacity: 1; transform: none; }

      /* ─── CTAs ───
         Selectors are intentionally bumped to .page .cta-* so they
         beat custom.css's `html.rc-brand a { color: inherit }` which
         would otherwise force the button text to inherit body's bone
         color (terrible contrast on phosphor). */
      .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 8px; }
      .page .cta {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 14px 22px;
        font-family: var(--rc-font-mono);
        font-weight: 500;
        font-size: 13px;
        letter-spacing: 0.01em;
        border: 1px solid transparent;
        border-radius: 6px;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.25s ease;
        white-space: nowrap;
        will-change: transform;
        text-decoration: none;
      }
      .page .cta-arrow { transition: transform 0.2s ease; color: inherit; }
      .page .cta:hover .cta-arrow { transform: translate(2px, -1px); }
      .page .cta-primary {
        background: var(--rc-phosphor);
        color: var(--rc-ink);
        border-color: var(--rc-phosphor);
        box-shadow: 0 0 0 0 rgba(201, 245, 100, 0.5), 0 1px 0 rgba(255, 255, 255, 0.2) inset;
        font-weight: 600;
      }
      .page .cta-primary:hover {
        background: #d4f878;
        color: var(--rc-ink);
        box-shadow: 0 0 0 6px rgba(201, 245, 100, 0.18), 0 1px 0 rgba(255, 255, 255, 0.25) inset;
      }
      .page .cta-primary span { color: inherit; }
      .page .cta-ghost {
        background: rgba(232, 226, 208, 0.04);
        color: var(--rc-bone);
        border-color: rgba(232, 226, 208, 0.18);
      }
      .page .cta-ghost:hover {
        background: rgba(232, 226, 208, 0.08);
        color: var(--rc-bone);
        border-color: rgba(232, 226, 208, 0.42);
      }
      .page .cta-ghost span { color: inherit; }
      .page .cta-lg { padding: 18px 28px; font-size: 14px; }

      /* New: link-style CTA (for "or use the CLI") */
      .page .cta-link {
        background: transparent;
        border-color: transparent;
        color: var(--rc-bone-dim);
        padding-inline: 4px;
      }
      .page .cta-link:hover {
        background: transparent;
        color: var(--rc-phosphor);
      }

      /* Small leading glyph next to CTA text (mono `$_` for CLI,
         square SVG for VS Code) */
      .page .cta-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--rc-font-mono);
        font-size: 12px;
        opacity: 0.9;
        margin-right: -2px;
      }

      .hero-byline {
        display: inline-flex; align-items: center; gap: 14px;
        margin-top: 18px;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--rc-bone-dim);
        opacity: 0.7;
      }
      .byline-line { width: 60px; height: 1px; background: rgba(232, 226, 208, 0.2); }
      .byline-link {
        color: var(--rc-bone-dim);
        text-decoration: none;
        transition: color 0.2s ease;
      }
      .byline-link:hover { color: var(--rc-phosphor); }

      /* ═══════════════════════════════════════════════════════════
         SECTION : EDITOR (VS Code extension showcase)
         ═══════════════════════════════════════════════════════════ */
      .editor {
        padding: clamp(80px, 11vw, 140px) var(--gutter);
        max-width: var(--max);
        margin: 0 auto;
        border-top: 1px solid var(--rc-hairline-ink);
      }
      .editor-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(40px, 5vw, 64px);
        align-items: center;
      }
      /* extension section is now prose-only (the mock lives in the hero) */
      .editor-prose { max-width: 640px; }

      .editor-h {
        font-family: var(--rc-font-display);
        font-weight: 400;
        font-size: clamp(36px, 5.6vw, 76px);
        line-height: 1.02;
        letter-spacing: -0.03em;
        color: var(--rc-bone);
        margin: 0 0 22px;
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
        max-width: 16ch;
        text-wrap: balance;
      }
      .editor-h em {
        font-style: italic;
        font-weight: 380;
        color: var(--rc-amber);
        font-variation-settings: 'SOFT' 100, 'WONK' 1;
      }
      .editor-sub {
        font-size: 17px;
        line-height: 1.55;
        color: var(--rc-bone-dim);
        margin: 0 0 24px;
        max-width: 44ch;
      }
      .editor-sub strong { color: var(--rc-bone); font-weight: 600; }

      .editor-bullets {
        list-style: none;
        margin: 0 0 32px;
        padding: 0;
        max-width: 44ch;
      }
      .editor-bullets li {
        font-size: 15px;
        line-height: 1.6;
        color: var(--rc-bone);
        padding: 8px 0;
        border-bottom: 1px dashed var(--rc-hairline-ink);
        display: grid;
        grid-template-columns: 22px 1fr;
        gap: 8px;
        align-items: baseline;
      }
      .editor-bullets li:last-child { border-bottom: none; }
      .editor-bullets li code {
        font-family: var(--rc-font-mono);
        font-size: 0.86em;
        background: rgba(201, 245, 100, 0.10);
        padding: 1px 5px;
        border-radius: 3px;
        color: var(--rc-phosphor);
      }
      .bullet-mark {
        color: var(--rc-phosphor);
        font-family: var(--rc-font-mono);
        opacity: 0.9;
        line-height: 1;
      }

      .editor-cta {
        display: flex;
        gap: 14px;
        align-items: center;
        flex-wrap: wrap;
      }
      .editor-cta-fallback {
        margin-top: 14px;
        font-size: 0.85rem;
        color: var(--rc-bone-dim);
      }
      .editor-cta-fallback a {
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .editor-cta-fallback a:hover {
        color: var(--rc-bone);
      }
      .vscode {
        background: #16161A;
        border: 1px solid var(--rc-hairline-ink);
        border-radius: 12px;
        overflow: hidden;
        box-shadow:
          0 1px 0 rgba(232, 226, 208, 0.04) inset,
          0 40px 100px -40px rgba(0, 0, 0, 0.75),
          0 0 0 1px rgba(201, 245, 100, 0.04);
        transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
        will-change: transform;
      }
      .vscode-bar {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 14px;
        padding: 10px 16px;
        background: #0F0F12;
        border-bottom: 1px solid var(--rc-hairline-ink);
        font-family: var(--rc-font-mono);
        font-size: 11.5px;
        color: var(--rc-bone-dim);
      }
      .vscode-title { text-align: center; opacity: 0.65; }
      .vscode-host { opacity: 0; font-size: 0; }   /* spacer for grid balance */

      .vscode-body {
        display: grid;
        grid-template-columns: 44px minmax(190px, 38%) 1fr;
        min-height: 470px;
      }
      @media (max-width: 720px) {
        .vscode-body { grid-template-columns: 40px 1fr; }
        .vscode-main { display: none; }
      }

      /* Activity bar */
      .vscode-activity {
        background: #0F0F12;
        border-right: 1px solid var(--rc-hairline-ink);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        padding: 10px 0;
      }
      .va {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--rc-font-mono);
        font-size: 16px;
        color: var(--rc-bone-dim);
        opacity: 0.55;
        border-left: 2px solid transparent;
        transition: opacity 0.18s ease, color 0.18s ease;
      }
      .va-active {
        opacity: 1;
        color: var(--rc-phosphor);
        border-left-color: var(--rc-phosphor);
      }
      .va:hover { opacity: 0.85; }
      .va-active:hover { opacity: 1; }

      /* Patchwire side panel */
      /* Patchwire side panel (the real extension) */
      .vscode-side {
        background: #181818;
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 16px 14px;
        border-right: 1px solid var(--rc-hairline-ink);
        min-width: 0;
        font-family: var(--rc-font-body);
      }
      .pw-head {
        font-family: var(--rc-font-mono);
        font-size: 10.5px;
        letter-spacing: 0.12em;
        color: var(--rc-bone-dim);
        opacity: 0.75;
      }
      .pw-project { display: grid; gap: 3px; min-width: 0; }
      .pw-project-name { font-size: 15px; font-weight: 600; color: var(--rc-bone); }
      .pw-meta {
        font-family: var(--rc-font-mono);
        font-size: 11px;
        color: var(--rc-bone-dim);
        opacity: 0.7;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      }
      .pw-session {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 9px 14px;
        background: #1f6feb;
        color: #fff;
        border: none; border-radius: 4px;
        font-family: var(--rc-font-body); font-size: 13px; font-weight: 500;
        cursor: pointer;
        transition: background 0.18s ease;
      }
      .pw-session:hover { background: #2b7cf0; }
      .pw-session-ico { font-size: 13px; }
      .pw-sync {
        border: 1px solid var(--rc-hairline-ink);
        border-radius: 6px;
        padding: 12px;
        display: grid; gap: 12px;
        background: rgba(232, 226, 208, 0.02);
      }
      .pw-sync-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
      .pw-sync-label { font-family: var(--rc-font-mono); font-size: 10px; letter-spacing: 0.1em; color: var(--rc-bone-dim); }
      .pw-sync-pill {
        display: inline-flex; align-items: center; gap: 4px;
        font-size: 11px; font-weight: 600;
        color: #0c1f12;
        background: #9be6a8;
        padding: 3px 9px; border-radius: 999px;
        white-space: nowrap;
      }
      .pw-sync-row { display: flex; gap: 18px; font-size: 12px; color: var(--rc-bone-dim); }
      .pw-sync-act { opacity: 0.85; }
      .pw-links { display: flex; gap: 18px; font-size: 12px; }
      .pw-links span { color: var(--rc-bone-dim); text-decoration: underline; text-underline-offset: 2px; opacity: 0.8; }

      /* Editor + Claude terminal column */
      .vscode-main {
        display: flex;
        flex-direction: column;
        background: #1e1e1e;
        min-width: 0;
      }
      .vscode-editor {
        flex: 1;
        display: flex; align-items: center; justify-content: center;
        min-height: 150px;
      }
      .vscode-wm { color: #2b2b2f; }
      .vscode-term {
        border-top: 1px solid var(--rc-hairline-ink);
        background: #181818;
      }
      .vt-tabs {
        display: flex; align-items: center; gap: 16px;
        padding: 7px 14px;
        border-bottom: 1px solid var(--rc-hairline-ink);
        font-family: var(--rc-font-mono); font-size: 10px; letter-spacing: 0.06em;
        color: var(--rc-bone-dim);
      }
      .vt-tab { opacity: 0.45; }
      .vt-tab-active { opacity: 1; color: var(--rc-bone); border-bottom: 1.5px solid var(--rc-phosphor); padding-bottom: 6px; margin-bottom: -7px; }
      .vt-session { margin-left: auto; opacity: 0.55; }
      .vt-body {
        padding: 12px 14px 16px;
        font-family: var(--rc-font-mono);
        font-size: 11.5px; line-height: 1.7;
        color: var(--rc-bone-dim);
        display: grid; gap: 1px;
      }
      .vt-pw { color: #57b6ff; }
      .vt-banner { display: inline-flex; align-items: center; gap: 10px; margin: 2px 0; }
      .vt-pig { color: #f0a0a8; font-size: 13px; letter-spacing: -1px; }
      .vt-strong { color: var(--rc-bone); font-weight: 600; }
      .vt-dim { opacity: 0.55; }
      .vt-prompt { display: inline-flex; align-items: center; gap: 8px; margin-top: 8px; }
      .vt-caret { color: var(--rc-phosphor); }
      .vt-ph { color: var(--rc-bone-dim); opacity: 0.5; }
      .vt-cur {
        width: 7px; height: 14px; background: var(--rc-bone-dim);
        opacity: 0.7; animation: blink 1.1s steps(2) infinite;
      }

      /* ═══════════════════════════════════════════════════════════
         SECTION : CLAIM
         ═══════════════════════════════════════════════════════════ */
      .kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--rc-bone-dim);
        margin-bottom: 28px;
      }
      .kicker-bar { width: 24px; height: 1px; background: var(--rc-phosphor); }
      @keyframes travel {
        0%   { left: 4%; opacity: 0; }
        15%  { opacity: 1; }
        85%  { opacity: 1; }
        100% { left: 96%; opacity: 0; }
      }
      .step {
        display: grid;
        grid-template-columns: 64px 1fr;
        gap: 28px;
        padding: 28px 0;
        border-bottom: 1px solid var(--rc-hairline-ink);
      }
      .step:last-child { border-bottom: none; }
      .pricecard .cta { justify-content: center; }

      /* ═══════════════════════════════════════════════════════════
         SECTION : END CTA
         ═══════════════════════════════════════════════════════════ */
      .endcta {
        padding: clamp(96px, 14vw, 180px) var(--gutter);
        border-top: 1px solid var(--rc-hairline-ink);
        position: relative;
        overflow: hidden;
      }
      .endcta::before {
        content: '';
        position: absolute; inset: 0;
        background:
          radial-gradient(60% 80% at 70% 30%, rgba(201,245,100,0.10) 0%, transparent 70%),
          radial-gradient(40% 70% at 20% 80%, rgba(255,140,66,0.06) 0%, transparent 70%);
        pointer-events: none;
      }
      .endcta-inner { position: relative; max-width: var(--max); margin: 0 auto; text-align: center; }
      .endcta .kicker { color: var(--rc-phosphor); opacity: 0.85; }
      .endcta-h {
        font-family: var(--rc-font-display);
        font-weight: 400;
        font-size: clamp(44px, 8.5vw, 124px);
        line-height: 0.96;
        letter-spacing: -0.035em;
        color: var(--rc-bone);
        margin: 0 auto 44px;
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
        max-width: 14ch;
      }
      .endcta-h em {
        font-style: italic;
        font-weight: 380;
        color: var(--rc-phosphor);
        font-variation-settings: 'SOFT' 100, 'WONK' 1;
      }
      .endcta-actions { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }

      /* ═══════════════════════════════════════════════════════════
         FOOTER
         ═══════════════════════════════════════════════════════════ */
      .foot {
        background: #0A0A0C;
        color: var(--rc-bone);
        padding: 56px var(--gutter) 32px;
        border-top: 1px solid var(--rc-hairline-ink);
      }
      .foot-grid {
        max-width: var(--max);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.2fr 2fr;
        gap: 56px;
        padding-bottom: 36px;
        border-bottom: 1px solid var(--rc-hairline-ink);
      }
      .wordmark-dark { color: var(--rc-bone); }
      .foot-blurb {
        margin: 14px 0 0;
        max-width: 36ch;
        font-size: 14px;
        line-height: 1.55;
        color: var(--rc-bone-dim);
      }
      .foot-nav { display: grid; grid-template-columns: repeat(2, 1fr); gap: 56px; }
      .foot-nav h4 {
        font-family: var(--rc-font-mono);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--rc-bone-dim);
        margin: 0 0 16px;
      }
      .foot-nav a {
        display: block;
        font-size: 14px;
        line-height: 1.95;
        color: rgba(232, 226, 208, 0.85);
        transition: color 0.15s;
      }
      .foot-nav a:hover { color: var(--rc-phosphor); }
      .foot-bottom {
        max-width: var(--max);
        margin: 0 auto;
        padding-top: 24px;
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        color: rgba(232, 226, 208, 0.4);
      }
      .foot-tag { letter-spacing: 0.06em; color: var(--rc-phosphor); opacity: 0.7; }
      .foot-project-links {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }
      .foot-project-links a {
        color: rgba(232, 226, 208, 0.78);
        transition: color 0.15s ease;
      }
      .foot-project-links a:hover { color: var(--rc-phosphor); }
      .foot-sep { opacity: 0.35; }

      /* ═══════════════════════════════════════════════════════════
         REDUCED MOTION
         ═══════════════════════════════════════════════════════════ */
      @media (prefers-reduced-motion: reduce) {
        .reveal,
        .term-line-step,
        .term-diff,
        .term-actions {
          opacity: 1;
          transform: none;
          transition: none;
        }
        .hero-h-line,
        .meta-dot,
        .eyebrow-pulse,
        .vt-cur {
          animation: none;
        }
        .hero-spotlight { transition: none; }
        .vscode {
          transition: none;
        }
        .cta-arrow { transition: none; }
      }

      /* ═══════════════════════════════════════════════════════════
         RESPONSIVE
         ═══════════════════════════════════════════════════════════ */
      @media (max-width: 900px) {
        .topbar { grid-template-columns: auto auto; gap: 12px; padding: 14px var(--gutter); }
        .topnav { display: none; }
        .meta-pill { font-size: 10px; padding: 5px 10px; }

        .hero { padding-block: 56px; }
        .hero-h { font-size: clamp(40px, 11vw, 64px); line-height: 0.96; max-width: 100%; }
        .hero-sub { font-size: 16px; }

        .hero-cta { flex-direction: column; align-items: stretch; }
        .hero-cta .cta { justify-content: center; }

        .endcta-h, .editor-h {
          font-size: clamp(32px, 9vw, 48px);
        }

        /* Extension section mobile */
        .editor { padding-block: 56px; }
        .editor-cta { flex-direction: column; align-items: stretch; }
        .editor-cta .cta { justify-content: center; }
        .vscode-body { min-height: 420px; }

        .endcta-actions { flex-direction: column; align-items: stretch; }
        .endcta-actions .cta {
          justify-content: center;
          white-space: normal;
          text-align: center;
          line-height: 1.3;
        }
        .endcta-actions .cta span:first-child { flex: 1; }

        .foot-grid { grid-template-columns: 1fr; gap: 32px; }
        .foot-nav { grid-template-columns: repeat(2, 1fr); gap: 28px; }
        .foot-bottom { flex-direction: column; align-items: flex-start; gap: 8px; font-size: 10px; }
      }
      @media (max-width: 540px) {
        .foot-nav { grid-template-columns: 1fr; gap: 22px; }
      }
    </style>
  </body>
</html>
