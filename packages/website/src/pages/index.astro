      @keyframes blink { 50% { opacity: 0; } }
      .term-spacer { height: 12px; }
      .term-diff {
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid var(--rc-hairline-ink);
        opacity: 0;
        transition: opacity 0.6s ease;
      }
      .term-diff.is-in { opacity: 1; }
      .diff-rail {
        font-size: 10.5px;
        letter-spacing: 0.04em;
        color: var(--rc-bone-dim);
        opacity: 0.55;
        margin-bottom: 8px;
      }
      .rail-path { color: var(--rc-amber); opacity: 0.85; }
      .diff-row {
        display: grid;
        grid-template-columns: 38px 18px 1fr;
        align-items: baseline;
        gap: 6px;
        padding: 1px 6px;
        margin: 0 -6px;
        font-size: 12.5px;
      }
      .diff-row .num { color: rgba(232, 226, 208, 0.28); text-align: right; font-size: 10.5px; }
      .diff-row .sign { font-weight: 600; text-align: center; }
      .diff-context  { color: var(--rc-bone); opacity: 0.65; }
      .diff-plus     { background: rgba(201, 245, 100, 0.08); }
      .diff-plus .sign { color: var(--rc-phosphor); }
      .diff-minus    { background: rgba(255, 140, 66, 0.07); }
      .diff-minus .sign { color: var(--rc-amber); }
      .diff-minus .content { color: var(--rc-bone-dim); }

      .term-actions {
        display: flex;
        gap: 10px;
        margin-top: 18px;
        flex-wrap: wrap;
        opacity: 0;
        transform: translateY(8px);
        transition: opacity 0.6s ease, transform 0.6s ease;
      }
      .term-actions.is-in { opacity: 1; transform: none; }
      .term-btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 8px 14px;
        font-family: var(--rc-font-mono);
        font-size: 12px;
        color: var(--rc-bone);
        background: rgba(232, 226, 208, 0.04);
        border: 1px solid var(--rc-hairline-ink);
        border-radius: 5px;
        cursor: pointer;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
      }
      .term-btn:hover {
        background: rgba(232, 226, 208, 0.07);
        border-color: rgba(232, 226, 208, 0.32);
      }
      .term-btn-primary {
        background: var(--rc-phosphor);
        color: var(--rc-ink);
        border-color: var(--rc-phosphor);
      }
      .term-btn-primary:hover { background: #d4f878; }
      .term-btn-ghost { color: var(--rc-bone-dim); }
      .term-btn-kbd {
        font-size: 10.5px;
        padding: 1px 5px;
        background: rgba(14, 14, 16, 0.5);
        border-radius: 3px;
        color: inherit;
        opacity: 0.7;
      }
      .term-btn-primary .term-btn-kbd { background: rgba(14, 14, 16, 0.15); }

      /* ─── CTAs ───
         Selectors are intentionally bumped to .page .cta-* so they
         beat custom.css's `html.rc-brand a { color: inherit }` which
         would otherwise force the button text to inherit body's bone
         color (terrible contrast on phosphor). */
      .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 8px; }
      .page .cta {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 14px 22px;
        font-family: var(--rc-font-mono);
        font-weight: 500;
        font-size: 13px;
        letter-spacing: 0.01em;
        border: 1px solid transparent;
        border-radius: 6px;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.25s ease;
        white-space: nowrap;
        will-change: transform;
        text-decoration: none;
      }
      .page .cta-arrow { transition: transform 0.2s ease; color: inherit; }
      .page .cta:hover .cta-arrow { transform: translate(2px, -1px); }
      .page .cta-primary {
        background: var(--rc-phosphor);
        color: var(--rc-ink);
        border-color: var(--rc-phosphor);
        box-shadow: 0 0 0 0 rgba(201, 245, 100, 0.5), 0 1px 0 rgba(255, 255, 255, 0.2) inset;
        font-weight: 600;
      }
      .page .cta-primary:hover {
        background: #d4f878;
        color: var(--rc-ink);
        box-shadow: 0 0 0 6px rgba(201, 245, 100, 0.18), 0 1px 0 rgba(255, 255, 255, 0.25) inset;
      }
      .page .cta-primary span { color: inherit; }
      .page .cta-ghost {
        background: rgba(232, 226, 208, 0.04);
        color: var(--rc-bone);
        border-color: rgba(232, 226, 208, 0.18);
      }
      .page .cta-ghost:hover {
        background: rgba(232, 226, 208, 0.08);
        color: var(--rc-bone);
        border-color: rgba(232, 226, 208, 0.42);
      }
      .page .cta-ghost span { color: inherit; }
      .page .cta-lg { padding: 18px 28px; font-size: 14px; }

      /* New: link-style CTA (for "or use the CLI") */
      .page .cta-link {
        background: transparent;
        border-color: transparent;
        color: var(--rc-bone-dim);
        padding-inline: 4px;
      }
      .page .cta-link:hover {
        background: transparent;
        color: var(--rc-phosphor);
      }

      /* Small leading glyph next to CTA text (mono `$_` for CLI,
         square SVG for VS Code) */
      .page .cta-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--rc-font-mono);
        font-size: 12px;
        opacity: 0.9;
        margin-right: -2px;
      }

      .hero-byline {
        display: inline-flex; align-items: center; gap: 14px;
        margin-top: 18px;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--rc-bone-dim);
        opacity: 0.7;
      }
      .byline-line { width: 60px; height: 1px; background: rgba(232, 226, 208, 0.2); }
      .byline-link {
        color: var(--rc-bone-dim);
        text-decoration: none;
        transition: color 0.2s ease;
      }
      .byline-link:hover { color: var(--rc-phosphor); }

      /* ═══════════════════════════════════════════════════════════
         SECTION : EDITOR (VS Code extension showcase)
         ═══════════════════════════════════════════════════════════ */
      .editor {
        padding: clamp(80px, 11vw, 140px) var(--gutter);
        max-width: var(--max);
        margin: 0 auto;
        border-top: 1px solid var(--rc-hairline-ink);
      }
      .editor-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(40px, 5vw, 64px);
        align-items: center;
      }
      @media (min-width: 1024px) {
        .editor-grid { grid-template-columns: 0.95fr 1.05fr; }
      }

      .editor-h {
        font-family: var(--rc-font-display);
        font-weight: 400;
        font-size: clamp(36px, 5.6vw, 76px);
        line-height: 1.02;
        letter-spacing: -0.03em;
        color: var(--rc-bone);
        margin: 0 0 22px;
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
        max-width: 16ch;
        text-wrap: balance;
      }
      .editor-h em {
        font-style: italic;
        font-weight: 380;
        color: var(--rc-amber);
        font-variation-settings: 'SOFT' 100, 'WONK' 1;
      }
      .editor-sub {
        font-size: 17px;
        line-height: 1.55;
        color: var(--rc-bone-dim);
        margin: 0 0 24px;
        max-width: 44ch;
      }
      .editor-sub strong { color: var(--rc-bone); font-weight: 600; }

      .editor-bullets {
        list-style: none;
        margin: 0 0 32px;
        padding: 0;
        max-width: 44ch;
      }
      .editor-bullets li {
        font-size: 15px;
        line-height: 1.6;
        color: var(--rc-bone);
        padding: 8px 0;
        border-bottom: 1px dashed var(--rc-hairline-ink);
        display: grid;
        grid-template-columns: 22px 1fr;
        gap: 8px;
        align-items: baseline;
      }
      .editor-bullets li:last-child { border-bottom: none; }
      .editor-bullets li code {
        font-family: var(--rc-font-mono);
        font-size: 0.86em;
        background: rgba(201, 245, 100, 0.10);
        padding: 1px 5px;
        border-radius: 3px;
        color: var(--rc-phosphor);
      }
      .bullet-mark {
        color: var(--rc-phosphor);
        font-family: var(--rc-font-mono);
        opacity: 0.9;
        line-height: 1;
      }

      .editor-cta {
        display: flex;
        gap: 14px;
        align-items: center;
        flex-wrap: wrap;
      }

      /* ─── VS Code mock window ─── */
      .editor-mock {
        position: relative;
        perspective: 1400px;
      }
      .vscode {
        background: #16161A;
        border: 1px solid var(--rc-hairline-ink);
        border-radius: 12px;
        overflow: hidden;
        box-shadow:
          0 1px 0 rgba(232, 226, 208, 0.04) inset,
          0 40px 100px -40px rgba(0, 0, 0, 0.75),
          0 0 0 1px rgba(201, 245, 100, 0.04);
        transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
        will-change: transform;
      }
      .vscode-bar {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 14px;
        padding: 10px 16px;
        background: #0F0F12;
        border-bottom: 1px solid var(--rc-hairline-ink);
        font-family: var(--rc-font-mono);
        font-size: 11.5px;
        color: var(--rc-bone-dim);
      }
      .vscode-title { text-align: center; opacity: 0.65; }
      .vscode-host { opacity: 0; font-size: 0; }   /* spacer for grid balance */

      .vscode-body {
        display: grid;
        grid-template-columns: 44px 1fr;
        min-height: 460px;
      }

      /* Activity bar */
      .vscode-activity {
        background: #0F0F12;
        border-right: 1px solid var(--rc-hairline-ink);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        padding: 10px 0;
      }
      .va {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--rc-font-mono);
        font-size: 16px;
        color: var(--rc-bone-dim);
        opacity: 0.55;
        border-left: 2px solid transparent;
        transition: opacity 0.18s ease, color 0.18s ease;
      }
      .va-active {
        opacity: 1;
        color: var(--rc-phosphor);
        border-left-color: var(--rc-phosphor);
      }
      .va:hover { opacity: 0.85; }
      .va-active:hover { opacity: 1; }

      /* Patchwire side panel */
      .vscode-side {
        background: #131318;
        display: grid;
        grid-template-rows: auto 1fr auto;
        min-height: 0;
      }
      .vss-head {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        background: #0F0F12;
        border-bottom: 1px solid var(--rc-hairline-ink);
      }
      .vss-title {
        font-family: var(--rc-font-mono);
        font-size: 10.5px;
        letter-spacing: 0.12em;
        color: var(--rc-bone-dim);
      }
      .vss-conn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--rc-font-mono);
        font-size: 10.5px;
        color: var(--rc-bone-dim);
      }
      .vss-conn-dot {
        width: 6px; height: 6px;
        border-radius: 50%;
        background: var(--rc-phosphor);
        box-shadow: 0 0 6px rgba(201, 245, 100, 0.55);
        animation: pulse 2.2s ease-in-out infinite;
      }

      .vss-thread {
        padding: 16px 14px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        overflow: hidden;
      }
      .vss-msg {
        display: grid;
        grid-template-columns: 30px 1fr;
        gap: 10px;
        align-items: start;
      }
      .vss-avatar {
        width: 26px; height: 26px;
        border-radius: 6px;
        background: rgba(232, 226, 208, 0.06);
        font-family: var(--rc-font-mono);
        font-size: 10px;
        letter-spacing: 0.04em;
        color: var(--rc-bone-dim);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-transform: uppercase;
        flex-shrink: 0;
      }
      .vss-avatar-pw {
        background: var(--rc-phosphor);
        color: var(--rc-ink);
        font-weight: 600;
      }
      .vss-bubble {
        margin: 2px 0 0;
        font-family: var(--rc-font-body);
        font-size: 13px;
        line-height: 1.4;
        color: var(--rc-bone);
        background: rgba(232, 226, 208, 0.04);
        border: 1px solid var(--rc-hairline-ink);
        padding: 8px 12px;
        border-radius: 6px;
        max-width: max-content;
      }
      .vss-content { display: grid; gap: 10px; min-width: 0; }
      .vss-msg-head {
        margin: 4px 0 0;
        font-family: var(--rc-font-mono);
        font-size: 11.5px;
        color: var(--rc-bone-dim);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
      }
      .vss-stat-add  { color: var(--rc-phosphor); font-weight: 600; }
      .vss-stat-rm   { color: var(--rc-amber); font-weight: 600; }
      .vss-stat-sep  { opacity: 0.4; }
      .vss-stat-files { opacity: 0.7; }

      .vss-diffinline {
        background: rgba(14, 14, 16, 0.5);
        border: 1px solid var(--rc-hairline-ink);
        border-radius: 6px;
        overflow: hidden;
        font-family: var(--rc-font-mono);
        font-size: 11.5px;
      }
      .vss-diff-head {
        padding: 6px 10px;
        background: rgba(232, 226, 208, 0.03);
        color: var(--rc-amber);
        font-size: 10.5px;
        letter-spacing: 0.04em;
        border-bottom: 1px solid var(--rc-hairline-ink);
        opacity: 0.85;
      }
      .vss-row {
        display: grid;
        grid-template-columns: 18px 1fr;
        gap: 6px;
        padding: 1px 8px;
        line-height: 1.6;
      }
      .vss-row-sign { text-align: center; font-weight: 600; }
      .vss-row-context { color: var(--rc-bone); opacity: 0.65; }
      .vss-row-plus    { background: rgba(201, 245, 100, 0.10); color: var(--rc-bone); }
      .vss-row-plus  .vss-row-sign { color: var(--rc-phosphor); }
      .vss-row-minus   { background: rgba(255, 140, 66, 0.10); color: var(--rc-bone-dim); }
      .vss-row-minus .vss-row-sign { color: var(--rc-amber); }

      .vss-actions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
      }
      .vss-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        font-family: var(--rc-font-mono);
        font-size: 11.5px;
        color: var(--rc-bone);
        background: rgba(232, 226, 208, 0.04);
        border: 1px solid var(--rc-hairline-ink);
        border-radius: 4px;
        cursor: pointer;
        transition: background 0.2s ease, border-color 0.2s ease;
      }
      .vss-btn:hover {
        background: rgba(232, 226, 208, 0.08);
        border-color: rgba(232, 226, 208, 0.3);
      }
      .vss-btn-primary {
        background: var(--rc-phosphor);
        color: var(--rc-ink);
        border-color: var(--rc-phosphor);
        font-weight: 600;
      }
      .vss-btn-primary:hover { background: #d4f878; color: var(--rc-ink); }
      .vss-btn-ghost { color: var(--rc-bone-dim); }
      .vss-kbd {
        font-size: 10px;
        padding: 1px 5px;
        background: rgba(14, 14, 16, 0.4);
        border-radius: 3px;
        opacity: 0.7;
      }
      .vss-btn-primary .vss-kbd { background: rgba(14, 14, 16, 0.18); }

      .vss-input {
        display: grid;
        grid-template-columns: 1fr auto auto;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        background: #0F0F12;
        border-top: 1px solid var(--rc-hairline-ink);
        font-family: var(--rc-font-mono);
        font-size: 12px;
      }
      .vss-input-text { color: var(--rc-bone-dim); opacity: 0.55; }
      .vss-input-cursor {
        width: 7px; height: 14px;
        background: var(--rc-phosphor);
        opacity: 0.75;
        animation: blink 1.1s steps(2) infinite;
      }
      .vss-input-send {
        width: 22px; height: 22px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(232, 226, 208, 0.04);
        border-radius: 4px;
        color: var(--rc-bone-dim);
      }

      /* ═══════════════════════════════════════════════════════════
         SECTION : CLAIM
         ═══════════════════════════════════════════════════════════ */
      .kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--rc-bone-dim);
        margin-bottom: 28px;
      }
      .kicker-bar { width: 24px; height: 1px; background: var(--rc-phosphor); }

      .claim {
        padding: clamp(80px, 11vw, 140px) var(--gutter);
        max-width: var(--max);
        margin: 0 auto;
        border-top: 1px solid var(--rc-hairline-ink);
      }
      .claim-h {
        font-family: var(--rc-font-display);
        font-weight: 400;
        font-size: clamp(38px, 6.6vw, 92px);
        line-height: 1.04;
        letter-spacing: -0.03em;
        color: var(--rc-bone);
        margin: 0 0 28px;
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
        max-width: 22ch;
        text-wrap: balance;
      }
      .claim-h em {
        font-style: italic;
        font-weight: 380;
        color: var(--rc-amber);
        font-variation-settings: 'SOFT' 100, 'WONK' 1;
      }
      .claim-sub {
        font-size: 18px;
        line-height: 1.6;
        color: var(--rc-bone-dim);
        max-width: 60ch;
        margin: 0 0 48px;
      }
      .claim-sub strong { color: var(--rc-bone); font-weight: 600; }

      .parallel { display: grid; grid-template-columns: 1fr; gap: 22px; }
      @media (min-width: 760px) {
        .parallel { grid-template-columns: 1fr 1fr; gap: 28px; }
      }
      .par-card {
        background: rgba(232, 226, 208, 0.025);
        border: 1px solid var(--rc-hairline-ink);
        border-radius: 12px;
        padding: 28px;
        transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
      }
      .par-card:hover {
        background: rgba(232, 226, 208, 0.05);
        border-color: rgba(232, 226, 208, 0.18);
        transform: translateY(-2px);
      }
      .par-head {
        display: inline-flex; align-items: center; gap: 8px;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 20px;
      }
      .par-dot { width: 6px; height: 6px; border-radius: 50%; }
      .par-dot-amber { background: var(--rc-amber); }
      .par-dot-phos  { background: var(--rc-phosphor); box-shadow: 0 0 8px rgba(201, 245, 100, 0.55); }
      .par-old .par-label { color: var(--rc-amber); opacity: 0.85; }
      .par-new .par-label { color: var(--rc-phosphor); }
      .par-card ul { list-style: none; margin: 0; padding: 0; font-size: 15.5px; line-height: 1.5; }
      .par-card li { padding: 10px 0; border-bottom: 1px dashed var(--rc-hairline-ink); }
      .par-card li:last-child { border-bottom: none; }
      .par-old li {
        color: var(--rc-bone-dim);
        text-decoration: line-through;
        text-decoration-color: rgba(255, 140, 66, 0.55);
      }
      .par-new li { color: var(--rc-bone); }

      /* ═══════════════════════════════════════════════════════════
         SECTION : FLOW
         ═══════════════════════════════════════════════════════════ */
      .flow {
        padding: clamp(80px, 11vw, 140px) var(--gutter);
        max-width: var(--max);
        margin: 0 auto;
        border-top: 1px solid var(--rc-hairline-ink);
      }
      .flow-h {
        font-family: var(--rc-font-display);
        font-weight: 400;
        font-size: clamp(36px, 6vw, 84px);
        line-height: 1.04;
        letter-spacing: -0.03em;
        color: var(--rc-bone);
        margin: 0 0 56px;
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
      }
      /* Variation: outlined-stroke treatment instead of italic-phosphor */
      .flow-h em {
        font-style: normal;
        font-weight: 500;
        color: transparent;
        -webkit-text-stroke: 1.5px var(--rc-phosphor);
        text-stroke: 1.5px var(--rc-phosphor);
        font-variation-settings: 'opsz' 144;
      }

      .flowdiagram {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 24px;
        padding: 28px 28px 36px;
        background: rgba(232, 226, 208, 0.025);
        border: 1px solid var(--rc-hairline-ink);
        border-radius: 12px;
        margin-bottom: 56px;
        position: relative;
        overflow: hidden;
      }
      .flowbox {
        display: grid; gap: 4px;
        text-align: center;
        padding: 14px 18px;
        min-width: 120px;
      }
      .flowbox-icon { font-family: var(--rc-font-mono); font-size: 22px; color: var(--rc-bone); opacity: 0.7; }
      .flowbox-title { font-family: var(--rc-font-display); font-size: 17px; font-weight: 500; color: var(--rc-bone); }
      .flowbox-sub {
        font-family: var(--rc-font-mono);
        font-size: 10.5px;
        color: var(--rc-bone-dim);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .flowbox-laptop .flowbox-icon { color: var(--rc-amber); }
      .flowbox-mac    .flowbox-icon { color: var(--rc-phosphor); }

      .flowwire {
        position: relative;
        height: 60px;
        display: flex; align-items: center; justify-content: center;
      }
      .flowwire svg { position: absolute; inset: 0; width: 100%; height: 100%; }
      .flowparticle {
        position: absolute;
        top: 50%; left: 0;
        transform: translate(0, -50%);
        width: 8px; height: 8px;
        border-radius: 50%;
        background: var(--rc-phosphor);
        box-shadow: 0 0 12px rgba(201, 245, 100, 0.75);
        animation: travel 3.4s cubic-bezier(0.6, 0, 0.4, 1) infinite;
      }
      @keyframes travel {
        0%   { left: 4%; opacity: 0; }
        15%  { opacity: 1; }
        85%  { opacity: 1; }
        100% { left: 96%; opacity: 0; }
      }
      .flowlabel {
        position: relative;
        z-index: 1;
        font-family: var(--rc-font-mono);
        font-size: 10.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--rc-bone-dim);
        background: rgba(14, 14, 16, 0.7);
        padding: 4px 10px;
        border-radius: 999px;
        border: 1px solid var(--rc-hairline-ink);
      }

      .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
      .step {
        display: grid;
        grid-template-columns: 64px 1fr;
        gap: 28px;
        padding: 28px 0;
        border-bottom: 1px solid var(--rc-hairline-ink);
      }
      .step:last-child { border-bottom: none; }
      .step-no {
        font-family: var(--rc-font-mono);
        font-size: 14px;
        color: var(--rc-phosphor);
        letter-spacing: 0.06em;
        padding-top: 4px;
      }
      .step-body h3 {
        font-family: var(--rc-font-display);
        font-weight: 500;
        font-size: clamp(20px, 2vw, 26px);
        line-height: 1.2;
        letter-spacing: -0.015em;
        color: var(--rc-bone);
        margin: 0 0 6px;
      }
      .step-body h3 em { font-style: italic; font-weight: 380; color: var(--rc-amber); }
      .step-body p { font-size: 16px; line-height: 1.55; color: var(--rc-bone-dim); margin: 0; }
      .step-body code {
        font-family: var(--rc-font-mono);
        font-size: 0.86em;
        background: rgba(201, 245, 100, 0.10);
        padding: 1px 5px;
        border-radius: 3px;
        color: var(--rc-phosphor);
      }

      /* ═══════════════════════════════════════════════════════════
         SECTION : TEAMS  (the v0.2 multi-developer centerpiece)
         ═══════════════════════════════════════════════════════════ */
      .teams {
        padding: clamp(80px, 11vw, 140px) var(--gutter);
        max-width: var(--max);
        margin: 0 auto;
        border-top: 1px solid var(--rc-hairline-ink);
      }
      .teams-h {
        font-family: var(--rc-font-display);
        font-weight: 400;
        font-size: clamp(36px, 6vw, 84px);
        line-height: 1.04;
        letter-spacing: -0.03em;
        color: var(--rc-bone);
        margin: 0 0 18px;
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
      }
      .teams-h em {
        font-style: italic; font-weight: 380; color: var(--rc-phosphor);
        font-variation-settings: 'SOFT' 100, 'WONK' 1;
      }
      .teams-sub {
        font-size: 18px; line-height: 1.6; color: var(--rc-bone-dim);
        max-width: 56ch; margin: 0 0 52px;
      }
      .teams-grid {
        display: grid; grid-template-columns: 1fr; gap: clamp(36px, 5vw, 60px);
        align-items: center;
      }
      @media (min-width: 1024px) { .teams-grid { grid-template-columns: 1fr 1fr; } }

      .teams-prose { display: grid; gap: 0; }
      .teampillar {
        display: grid; grid-template-columns: 46px 1fr; gap: 16px;
        padding: 22px 0; border-bottom: 1px dashed var(--rc-hairline-ink);
      }
      .teampillar:last-child { border-bottom: none; }
      .teampillar-no {
        font-family: var(--rc-font-mono); font-size: 13px; color: var(--rc-phosphor);
        letter-spacing: 0.06em; padding-top: 5px;
      }
      .teampillar h3 {
        font-family: var(--rc-font-display); font-weight: 500; font-size: 22px;
        line-height: 1.2; letter-spacing: -0.015em; color: var(--rc-bone); margin: 0 0 6px;
      }
      .teampillar p { font-size: 15.5px; line-height: 1.55; color: var(--rc-bone-dim); margin: 0; }
      .teampillar code {
        font-family: var(--rc-font-mono); font-size: 0.84em;
        background: rgba(201, 245, 100, 0.10); padding: 1px 5px; border-radius: 3px; color: var(--rc-phosphor);
      }
      .teampillar em { font-style: italic; color: var(--rc-bone); }

      /* agent dashboard panel — live /queue snapshot + audit tail */
      .teams-panel {
        background: #131318; border: 1px solid var(--rc-hairline-ink); border-radius: 12px;
        overflow: hidden;
        box-shadow:
          0 1px 0 rgba(232, 226, 208, 0.04) inset,
          0 30px 80px -34px rgba(0, 0, 0, 0.7),
          0 0 0 1px rgba(201, 245, 100, 0.04);
        transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
        will-change: transform;
      }
      .tp-bar {
        display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px;
        padding: 10px 16px; background: #0F0F12; border-bottom: 1px solid var(--rc-hairline-ink);
        font-family: var(--rc-font-mono); font-size: 11.5px; color: var(--rc-bone-dim);
      }
      .tp-bar-title { text-align: center; opacity: 0.7; }
      .tp-bar-ep { color: var(--rc-phosphor); opacity: 0.85; font-size: 10.5px; letter-spacing: 0.04em; }
      .tp-body { padding: 18px 18px 22px; font-family: var(--rc-font-mono); font-size: 12.5px; color: var(--rc-bone); }
      .tp-label {
        font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase;
        color: var(--rc-bone-dim); opacity: 0.6; margin: 14px 0 8px;
      }
      .tp-label:first-child { margin-top: 0; }
      .tp-row {
        display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 10px;
        padding: 7px 10px; margin: 0 -10px; border-radius: 6px;
      }
      .tp-row-run { background: rgba(201, 245, 100, 0.06); }
      .tp-row-you { background: rgba(232, 226, 208, 0.04); }
      .tp-pos {
        min-width: 18px; height: 18px; display: inline-flex; align-items: center; justify-content: center;
        font-size: 10.5px; color: var(--rc-bone-dim);
        border: 1px solid var(--rc-hairline-ink); border-radius: 4px;
      }
      .tp-user { color: var(--rc-bone); font-weight: 500; }
      .tp-row-you .tp-user { color: var(--rc-phosphor); }
      .tp-meta { color: var(--rc-bone-dim); opacity: 0.7; font-size: 11px; }
      .tp-badge {
        font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase;
        padding: 2px 7px; border-radius: 999px;
      }
      .tp-badge-run { color: var(--rc-ink); background: var(--rc-phosphor); font-weight: 600; }
      .tp-divider { height: 1px; background: var(--rc-hairline-ink); margin: 16px 0 4px; }
      .tp-audit {
        margin: 0; font-family: var(--rc-font-mono); font-size: 11px; line-height: 1.7;
        color: var(--rc-bone-dim); white-space: pre-wrap; word-break: break-word;
      }
      .tp-aline { display: block; }
      .tp-k { color: var(--rc-amber); }
      .tp-aline-live { color: var(--rc-bone); }
      .tp-aline-live .tp-k { color: var(--rc-phosphor); }

      /* ═══════════════════════════════════════════════════════════
         SECTION : SETUP
         ═══════════════════════════════════════════════════════════ */
      .setup {
        padding: clamp(80px, 11vw, 140px) var(--gutter);
        max-width: var(--max);
        margin: 0 auto;
        border-top: 1px solid var(--rc-hairline-ink);
      }
      .setup-h {
        font-family: var(--rc-font-display);
        font-weight: 400;
        font-size: clamp(36px, 6vw, 84px);
        line-height: 1.04;
        letter-spacing: -0.03em;
        color: var(--rc-bone);
        margin: 0 0 56px;
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
      }
      /* Variation: underline-marker treatment instead of italic-phosphor */
      .setup-h em {
        font-style: normal;
        font-weight: 500;
        color: var(--rc-bone);
        background: linear-gradient(transparent 78%, rgba(201, 245, 100, 0.55) 78%, rgba(201, 245, 100, 0.55) 94%, transparent 94%);
        padding: 0 0.04em;
        font-variation-settings: 'opsz' 144;
      }
      .setup-grid { display: grid; grid-template-columns: 1fr; gap: 22px; }
      @media (min-width: 860px) { .setup-grid { grid-template-columns: 1fr 1fr; gap: 28px; } }
      .termcard {
        background: #131318;
        border: 1px solid var(--rc-hairline-ink);
        border-radius: 12px;
        overflow: hidden;
        transition: border-color 0.25s ease, background 0.25s ease;
        will-change: transform;
      }
      .termcard:hover {
        border-color: rgba(232, 226, 208, 0.2);
        background: #17171c;
      }
      .termcard-bar {
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: center;
        gap: 14px;
        padding: 10px 16px;
        background: #0F0F12;
        border-bottom: 1px solid var(--rc-hairline-ink);
      }
      .termcard-host {
        text-align: right;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        color: var(--rc-bone-dim);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .termcard-body {
        padding: 22px 22px 26px;
        font-family: var(--rc-font-mono);
        font-size: clamp(12px, 1vw, 13.5px);
        line-height: 1.85;
        color: var(--rc-bone);
        margin: 0;
        white-space: pre-wrap;
        overflow-wrap: break-word;
      }
      .t-com { color: var(--rc-bone-dim); opacity: 0.55; }
      .t-str { color: var(--rc-amber); }
      .t-ok  { color: var(--rc-phosphor); }

      /* ═══════════════════════════════════════════════════════════
         SECTION : FEATURES
         ═══════════════════════════════════════════════════════════ */
      .feats {
        padding: clamp(80px, 11vw, 140px) var(--gutter);
        max-width: var(--max);
        margin: 0 auto;
        border-top: 1px solid var(--rc-hairline-ink);
      }
      .feats-h {
        font-family: var(--rc-font-display);
        font-weight: 400;
        font-size: clamp(36px, 6vw, 84px);
        line-height: 1.04;
        letter-spacing: -0.03em;
        color: var(--rc-bone);
        margin: 0 0 56px;
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
        max-width: 18ch;
      }
      .feats-h em {
        font-style: italic; font-weight: 380; color: var(--rc-phosphor);
        font-variation-settings: 'SOFT' 100, 'WONK' 1;
      }

      .featgrid { display: grid; grid-template-columns: 1fr; gap: 16px; }
      @media (min-width: 760px) {
        .featgrid {
          grid-template-columns: 1.4fr 1fr 1fr;
          grid-template-rows: auto auto auto;
          gap: 18px;
        }
        .feat-card-tall { grid-column: span 1; grid-row: span 2; }
        .feat-card-quote { grid-column: span 2; }
        .feat-card-strip { grid-column: span 3; }
      }
      .feat-card {
        position: relative;
        background: rgba(232, 226, 208, 0.025);
        border: 1px solid var(--rc-hairline-ink);
        border-radius: 12px;
        padding: 28px;
        overflow: hidden;
        transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
      }
      .feat-card:hover {
        background: rgba(232, 226, 208, 0.05);
        border-color: rgba(232, 226, 208, 0.22);
        transform: translateY(-3px);
      }
      .feat-no {
        font-family: var(--rc-font-mono);
        font-size: 22px;
        color: var(--rc-phosphor);
        line-height: 1;
        margin-bottom: 22px;
        display: inline-block;
      }
      .feat-card h3 {
        font-family: var(--rc-font-display);
        font-weight: 500;
        font-size: 22px;
        line-height: 1.2;
        letter-spacing: -0.015em;
        color: var(--rc-bone);
        margin: 0 0 10px;
      }
      .feat-card p { font-size: 15px; line-height: 1.55; color: var(--rc-bone-dim); margin: 0; }
      .feat-card code {
        font-family: var(--rc-font-mono);
        font-size: 0.86em;
        background: rgba(201, 245, 100, 0.10);
        padding: 1px 5px;
        border-radius: 3px;
        color: var(--rc-phosphor);
      }
      .feat-glow {
        position: absolute;
        bottom: -120px; right: -100px;
        width: 280px; height: 280px;
        background: radial-gradient(circle, rgba(201, 245, 100, 0.16), transparent 70%);
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.4s ease;
      }
      .feat-card-tall:hover .feat-glow { opacity: 1; }

      .feat-card-quote {
        background: linear-gradient(135deg, rgba(201, 245, 100, 0.04), rgba(255, 140, 66, 0.04));
      }
      .feat-q {
        font-family: var(--rc-font-display);
        font-style: italic;
        font-weight: 380;
        font-size: clamp(18px, 1.8vw, 24px);
        line-height: 1.35;
        color: var(--rc-bone);
        margin: 0 0 14px;
        font-variation-settings: 'SOFT' 100, 'WONK' 1;
        text-wrap: balance;
      }
      .feat-q em { font-style: italic; color: var(--rc-phosphor); }
      .feat-q-meta {
        font-family: var(--rc-font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--rc-bone-dim);
        margin: 0;
      }

      .feat-card-strip { padding: 24px 28px; }
      .strip {
        list-style: none; margin: 0; padding: 0;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
      }
      @media (max-width: 760px) { .strip { grid-template-columns: 1fr 1fr; gap: 18px; } }
      .strip li {
        display: flex; flex-direction: column; gap: 2px;
        font-family: var(--rc-font-mono);
        font-size: 13px;
        border-left: 2px solid var(--rc-phosphor);
        padding-left: 14px;
      }
      .strip li strong { color: var(--rc-bone); font-weight: 500; }
      .strip li span { color: var(--rc-bone-dim); font-size: 11px; opacity: 0.7; }

      /* ═══════════════════════════════════════════════════════════
         SECTION : END CTA
         ═══════════════════════════════════════════════════════════ */
      .endcta {
        padding: clamp(96px, 14vw, 180px) var(--gutter);
        border-top: 1px solid var(--rc-hairline-ink);
        position: relative;
        overflow: hidden;
      }
      .endcta::before {
        content: '';
        position: absolute; inset: 0;
        background:
          radial-gradient(60% 80% at 70% 30%, rgba(201,245,100,0.10) 0%, transparent 70%),
          radial-gradient(40% 70% at 20% 80%, rgba(255,140,66,0.06) 0%, transparent 70%);
        pointer-events: none;
      }
      .endcta-inner { position: relative; max-width: var(--max); margin: 0 auto; text-align: center; }
      .endcta .kicker { color: var(--rc-phosphor); opacity: 0.85; }
      .endcta-h {
        font-family: var(--rc-font-display);
        font-weight: 400;
        font-size: clamp(44px, 8.5vw, 124px);
        line-height: 0.96;
        letter-spacing: -0.035em;
        color: var(--rc-bone);
        margin: 0 auto 44px;
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
        max-width: 14ch;
      }
      .endcta-h em {
        font-style: italic;
        font-weight: 380;
        color: var(--rc-phosphor);
        font-variation-settings: 'SOFT' 100, 'WONK' 1;
      }
      .endcta-actions { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }

      /* ═══════════════════════════════════════════════════════════
         FOOTER
         ═══════════════════════════════════════════════════════════ */
      .foot {
        background: #0A0A0C;
        color: var(--rc-bone);
        padding: 56px var(--gutter) 32px;
        border-top: 1px solid var(--rc-hairline-ink);
      }
      .foot-grid {
        max-width: var(--max);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.2fr 2fr;
        gap: 56px;
        padding-bottom: 36px;
        border-bottom: 1px solid var(--rc-hairline-ink);
      }
      .wordmark-dark { color: var(--rc-bone); }
      .foot-blurb {
        margin: 14px 0 0;
        max-width: 36ch;
        font-size: 14px;
        line-height: 1.55;
        color: var(--rc-bone-dim);
      }
      .foot-nav { display: grid; grid-template-columns: repeat(2, 1fr); gap: 56px; }
      .foot-nav h4 {
        font-family: var(--rc-font-mono);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--rc-bone-dim);
        margin: 0 0 16px;
      }
      .foot-nav a {
        display: block;
        font-size: 14px;
        line-height: 1.95;
        color: rgba(232, 226, 208, 0.85);
        transition: color 0.15s;
      }
      .foot-nav a:hover { color: var(--rc-phosphor); }
      .foot-bottom {
        max-width: var(--max);
        margin: 0 auto;
        padding-top: 24px;
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        color: rgba(232, 226, 208, 0.4);
      }
      .foot-tag { letter-spacing: 0.06em; color: var(--rc-phosphor); opacity: 0.7; }
      .foot-project-links {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }
      .foot-project-links a {
        color: rgba(232, 226, 208, 0.78);
        transition: color 0.15s ease;
      }
      .foot-project-links a:hover { color: var(--rc-phosphor); }
      .foot-sep { opacity: 0.35; }

      /* ═══════════════════════════════════════════════════════════
         REDUCED MOTION
         ═══════════════════════════════════════════════════════════ */
      @media (prefers-reduced-motion: reduce) {
        .reveal,
        .term-line-step,
        .term-diff,
        .term-actions {
          opacity: 1;
          transform: none;
          transition: none;
        }
        .hero-h-line,
        .meta-dot,
        .eyebrow-pulse,
        .flowparticle,
        .caret,
        .step-ok,
        .vss-conn-dot {
          animation: none;
        }
        .hero-spotlight { transition: none; }
        .vscode,
        .termcard,
        .par-card,
        .feat-card,
        .teams-panel {
          transition: none;
        }
        .cta-arrow { transition: none; }
      }

      /* ═══════════════════════════════════════════════════════════
         RESPONSIVE
         ═══════════════════════════════════════════════════════════ */
      @media (max-width: 900px) {
        .topbar { grid-template-columns: auto auto; gap: 12px; padding: 14px var(--gutter); }
        .topnav { display: none; }
        .meta-pill { font-size: 10px; padding: 5px 10px; }

        .hero { padding-block: 56px; }
        .hero-h { font-size: clamp(40px, 11vw, 64px); line-height: 0.96; max-width: 100%; }
        .hero-sub { font-size: 16px; }
        .term { box-shadow: 0 12px 40px -20px rgba(0,0,0,0.7); }
        .term-body { padding: 16px 14px 20px; min-height: 320px; font-size: 11.5px; }
        .term-line-step { grid-template-columns: 14px 60px 8px 1fr auto; gap: 6px; }
        .step-detail { font-size: 0.95em; }

        .hero-cta { flex-direction: column; align-items: stretch; }
        .hero-cta .cta { justify-content: center; }

        .claim-h, .flow-h, .setup-h, .feats-h, .endcta-h, .editor-h, .teams-h {
          font-size: clamp(32px, 9vw, 48px);
        }

        /* Teams section mobile */
        .teams { padding-block: 56px; }
        .teampillar { grid-template-columns: 36px 1fr; gap: 12px; padding-block: 18px; }
        .tp-body { font-size: 11.5px; }

        /* Editor section mobile */
        .editor { padding-block: 56px; }
        .editor-cta { flex-direction: column; align-items: stretch; }
        .editor-cta .cta { justify-content: center; }
        .vscode-body { min-height: 420px; }
        .vss-thread { padding: 14px 12px; gap: 14px; }
        .vss-bubble { font-size: 12.5px; }
        .vss-row { font-size: 10.5px; }
        .vss-diff-head { font-size: 10px; }
        .vss-actions { gap: 4px; }
        .vss-btn { padding: 5px 9px; font-size: 11px; }
        .vss-msg-head { font-size: 11px; }

        .flowdiagram { grid-template-columns: 1fr; gap: 14px; padding: 22px; }
        .flowwire { height: 40px; }

        .step { grid-template-columns: 44px 1fr; gap: 16px; padding-block: 20px; }
        .step-body h3 { font-size: 18px; }

        .featgrid { grid-template-columns: 1fr; }
        .feat-card-tall, .feat-card-quote, .feat-card-strip { grid-column: auto; grid-row: auto; }

        .endcta-actions { flex-direction: column; align-items: stretch; }
        .endcta-actions .cta {
          justify-content: center;
          white-space: normal;
          text-align: center;
          line-height: 1.3;
        }
        .endcta-actions .cta span:first-child { flex: 1; }

        .foot-grid { grid-template-columns: 1fr; gap: 32px; }
        .foot-nav { grid-template-columns: repeat(2, 1fr); gap: 28px; }
        .foot-bottom { flex-direction: column; align-items: flex-start; gap: 8px; font-size: 10px; }
      }
      @media (max-width: 540px) {
        .foot-nav { grid-template-columns: 1fr; gap: 22px; }
      }
    </style>
  </body>
</html>
