      }
      .hero-glow-phos { background: var(--rc-phosphor); top: -220px; right: -220px; }
      .hero-glow-amber { background: var(--rc-amber-dim); bottom: -240px; left: -260px; opacity: 0.10; }

      .hero-inner {
        position: relative;
        z-index: 1;
