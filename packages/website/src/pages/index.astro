      }

      /* ─── Terminal ─── */
      .term {
        background: #131318;
        border: 1px solid var(--rc-hairline-ink);
        border-radius: 12px;
        overflow: hidden;
        max-width: 880px;
        box-shadow:
          0 1px 0 rgba(232, 226, 208, 0.04) inset,
          0 30px 80px -30px rgba(0, 0, 0, 0.7),
          0 0 0 1px rgba(201, 245, 100, 0.04);
      }
      .term-bar {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 14px;
        padding: 10px 16px;
        background: #0F0F12;
        border-bottom: 1px solid var(--rc-hairline-ink);
        font-family: var(--rc-font-mono);
        font-size: 11.5px;
        color: var(--rc-bone-dim);
      }
      .term-dots { display: inline-flex; gap: 6px; }
      .term-dots span {
        width: 10px; height: 10px;
        border-radius: 50%;
