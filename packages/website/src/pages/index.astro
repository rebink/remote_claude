---
import '../styles/custom.css';
import { ClientRouter } from 'astro:transitions';
// Read the shipped version straight from the extension package at build time so the
// version pill never drifts behind a release (the bump commit lands on main, which
// rebuilds the site). See memory: website-version-pill-drift.
import extPkg from '../../../extension/package.json';

const repo = 'https://github.com/rebink/remote_claude';
const version = extPkg.version;
// Deep link: opens the VS Code app straight to the extension page (Install button there).
const ext = 'vscode:extension/patchwire.patchwire-vscode';
// Fallback hub for anyone without the app, or on another editor (Marketplace, Open VSX, .vsix).
const installFallback = '/install-extension/';
const ogDesc =
  'A VS Code extension that runs a Claude Code session on a machine you own, with two-way sync keeping your laptop and the remote byte-identical. Your code stays on your own network.';
---

<!doctype html>
<html lang="en" class="rc-brand rc-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B0B0D" />
    <title>Patchwire · Run Claude Code on your own remote machine</title>
    <meta name="description" content={ogDesc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://patchwire.vercel.app/" />
    <meta property="og:title" content="Patchwire · Run Claude Code on your own remote machine" />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:image" content="https://patchwire.vercel.app/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Patchwire · Run Claude Code on your own remote machine" />
    <meta name="twitter:description" content={ogDesc} />
    <meta name="twitter:image" content="https://patchwire.vercel.app/og.png" />
    <ClientRouter />
  </head>
  <body class="page">
    <a href="#main" class="skip-link">Skip to content</a>

    <!-- ───────── TOP BAR ───────── -->
    <header class="topbar">
      <a class="wordmark" href="/" aria-label="Patchwire home">
        <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 9.5 L12 5.5 Q12 3 9.5 3 L5.5 3 Q3 3 3 5.5 L3 9.5 Q3 12 5.5 12 L10 12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M16 13 L18.5 13 Q21 13 21 15.5 L21 18.5 Q21 21 18.5 21 L15.5 21 Q13 21 13 18.5 L13 16 A3 3 0 0 0 16 13 Z" fill="currentColor"/>
          <circle cx="12.5" cy="12.5" r="2.4" fill="#C9F564"/>
        </svg>
        <span>Patchwire</span>
      </a>
      <nav class="topnav" aria-label="Primary">
        <a href="/quickstart/">Quickstart</a>
        <a href="/multi-developer/">Teams</a>
        <a href="/architecture/">Architecture</a>
        <a href="/commands/">CLI</a>
        <a href={repo} class="topnav-ext">GitHub ↗</a>
      </nav>
      <div class="topbar-right">
        <span class="meta-pill"><span class="meta-dot"></span>v{version}</span>
        <a href={ext} class="topbar-install magnet">Install for VS Code</a>
      </div>
    </header>

    <main id="main">

    <!-- ───────── HERO ───────── -->
    <section class="hero" id="hero">
      <div class="hero-bg" aria-hidden="true">
        <div class="grid-lines"></div>
        <div class="hero-glow"></div>
        <div class="hero-spot" id="spotlight"></div>
      </div>

      <div class="hero-inner">
        <div class="hero-copy">
          <span class="eyebrow reveal">The VS Code extension</span>
          <h1 class="hero-h reveal">
            Run Claude Code on
            <span class="hero-h-2">your own <em>remote machine.</em></span>
          </h1>
          <p class="hero-sub reveal">
            It runs a Claude Code session on a machine you own. Two-way sync keeps
            your laptop and the remote identical, live, so you build and debug right
            where you always have.
          </p>
          <div class="cta-row reveal">
            <a href={ext} class="cta cta-primary magnet">
              <span>Install for VS Code</span><span class="cta-arrow">→</span>
            </a>
            <a href="/quickstart/" class="cta cta-ghost magnet">
              <span>Read the docs</span><span class="cta-arrow">↗</span>
            </a>
          </div>
          <p class="cta-fallback reveal">
            Opens VS Code at the extension. No VS Code, or another editor?
            <a href={installFallback}>Other ways to install ↗</a>
          </p>
        </div>

        <!-- The patch cable: two machines, signal both ways = two-way sync -->
        <figure class="wire reveal" aria-label="Diagram: your editor and a machine you own, connected by two-way sync.">
          <div class="node node-local">
            <div class="node-top">
              <span class="node-glyph">▣</span>
              <span class="node-kind">your editor</span>
            </div>
            <div class="node-body">
              <span class="node-line">you@laptop</span>
              <span class="node-line node-prompt">❯ build the importer</span>
            </div>
          </div>

          <div class="wire-mid" aria-hidden="true">
            <div class="wire-track">
              <span class="pulse pulse-down"></span>
              <span class="pulse pulse-up"></span>
            </div>
            <span class="wire-chip">⇄ two-way sync</span>
          </div>

          <div class="node node-remote">
            <div class="node-top">
              <span class="node-glyph">⊟</span>
              <span class="node-kind">a machine you own</span>
            </div>
            <div class="node-body">
              <span class="node-line">~/workspace/your-app</span>
              <span class="node-line node-run">claude · opus · max</span>
            </div>
          </div>
        </figure>
      </div>
    </section>

    <!-- ───────── SECTION: THE LOOP ───────── -->
    <section class="loop">
      <div class="wrap">
        <h2 class="sec-h reveal">From zero to a synced session.</h2>
        <p class="sec-lead reveal">
          Three steps the first time. After that you just click into the session and
          your files stay in step on their own.
        </p>

        <ol class="stations reveal" aria-label="How the extension connects">
          <li class="station">
            <span class="station-dot"></span>
            <h3 class="station-h">Connect</h3>
            <p class="station-p">
              The setup wizard finds your machine over SSH and installs a per-project
              key. No router config, no public ports.
            </p>
          </li>
          <li class="station">
            <span class="station-dot"></span>
            <h3 class="station-h">Focus</h3>
            <p class="station-p">
              One click opens the real Claude Code session running on that machine,
              right inside a VS Code terminal.
            </p>
          </li>
          <li class="station">
            <span class="station-dot"></span>
            <h3 class="station-h">Sync</h3>
            <p class="station-p">
              Two-way sync mirrors every edit between your laptop and the remote, so
              you run, hot-reload, and debug locally.
            </p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ───────── SECTION: THE PANEL ───────── -->
    <section class="panelsec">
      <div class="wrap panelsec-grid">
        <div class="panelsec-copy">
          <span class="eyebrow reveal">The panel</span>
          <h2 class="sec-h reveal">It all lives in one side panel.</h2>
          <p class="sec-lead reveal">
            Not a chat window pretending to be your editor. A small control panel that
            drives the session and the sync, and gets out of the way.
          </p>
          <ul class="featlist reveal">
            <li>
              <span class="feat-k">Focus Claude session</span>
              <span class="feat-v">Opens the real Claude Code REPL in a terminal on your remote.</span>
            </li>
            <li>
              <span class="feat-k">Two-way sync</span>
              <span class="feat-v">Laptop and remote stay byte-identical. Flush or pause from the panel.</span>
            </li>
            <li>
              <span class="feat-k">Setup wizard</span>
              <span class="feat-v">Connect a machine and install a per-project key in a few clicks.</span>
            </li>
          </ul>
        </div>

        <!-- Faithful preview of the real panel controls, anonymized -->
        <div class="panel reveal" role="img" aria-label="The Patchwire panel: project your-app, a Focus Claude session button, and a two-way sync card showing In sync.">
          <div class="panel-head">PATCHWIRE: CHAT</div>
          <div class="panel-project">
            <span class="pp-name">your-app</span>
            <span class="pp-meta">you@your-remote</span>
            <span class="pp-meta">~/workspace/your-app</span>
          </div>
          <div class="panel-btn">❄ Focus Claude session</div>
          <div class="panel-sync">
            <span class="ps-label">TWO-WAY SYNC</span>
            <div class="ps-row">
              <span class="ps-pill">✓ In sync</span>
              <span class="ps-act">⇄ Flush now</span>
              <span class="ps-act">❚❚ Pause</span>
            </div>
          </div>
          <div class="panel-links">
            <span>Show output</span>
            <span class="dotsep" aria-hidden="true">·</span>
            <span>Setup wizard</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────── SECTION: YOUR HARDWARE ───────── -->
    <section class="hardware">
      <div class="wrap">
        <h2 class="sec-h reveal">It runs on your hardware. <em>Not a vendor's cloud.</em></h2>
        <div class="hw-cols reveal">
          <div class="hw-col">
            <span class="hw-num">01</span>
            <p>The session runs on your own Mac or Linux box, reachable over SSH or a Tailscale tailnet.</p>
          </div>
          <div class="hw-col">
            <span class="hw-num">02</span>
            <p>Your code lives on machines you control. Nothing is handed to a third-party agent service.</p>
          </div>
          <div class="hw-col">
            <span class="hw-num">03</span>
            <p>The same project, byte-identical on both ends, for the whole session. No surprises on apply.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────── SECTION: CLI ───────── -->
    <section class="cli">
      <div class="wrap cli-grid">
        <div class="cli-copy">
          <h2 class="sec-h reveal">Prefer the terminal? <em>It ships as a CLI.</em></h2>
          <p class="sec-lead reveal">
            Same idea, no editor. Sync a project to your machine, ask, and review the
            diff before a single line lands locally.
          </p>
        </div>
        <pre class="cli-block reveal" aria-label="Example Patchwire CLI commands"><code><span class="cl"><span class="pr">$</span> patchwire setup            <span class="cm"># connect a machine you own</span></span>
<span class="cl"><span class="pr">$</span> patchwire ask <span class="st">"add a retry to the uploader"</span></span>
<span class="cl"><span class="ok">  ↳</span> reviewing diff … apply? [y/N]</span></code></pre>
      </div>
    </section>

    <!-- ───────── SECTION: END CTA ───────── -->
    <section class="endcta">
      <div class="wrap endcta-inner">
        <h2 class="endcta-h reveal">Bring Claude into <em>your editor.</em></h2>
        <p class="endcta-sub reveal">
          Install the extension. It runs on your machine, and your code never leaves
          your network.
        </p>
        <div class="cta-row cta-center reveal">
          <a href={ext} class="cta cta-primary cta-lg magnet">
            <span>Install for VS Code</span><span class="cta-arrow">→</span>
          </a>
          <a href={repo} class="cta cta-ghost cta-lg magnet">
            <span>View on GitHub</span><span class="cta-arrow">↗</span>
          </a>
        </div>
        <p class="cta-fallback reveal">
          Opens VS Code at the extension. No VS Code, or another editor?
          <a href={installFallback}>Other ways to install ↗</a>
        </p>
      </div>
    </section>

    </main>

    <!-- ───────── FOOTER ───────── -->
    <footer class="foot">
      <div class="wrap foot-grid">
        <div class="foot-mark">
          <span class="wordmark wordmark-foot">
            <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 9.5 L12 5.5 Q12 3 9.5 3 L5.5 3 Q3 3 3 5.5 L3 9.5 Q3 12 5.5 12 L10 12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M16 13 L18.5 13 Q21 13 21 15.5 L21 18.5 Q21 21 18.5 21 L15.5 21 Q13 21 13 18.5 L13 16 A3 3 0 0 0 16 13 Z" fill="currentColor"/>
              <circle cx="12.5" cy="12.5" r="2.4" fill="#C9F564"/>
            </svg>
            <span>Patchwire</span>
          </span>
          <p class="foot-blurb">
            Claude Code on a machine you own, in step with your editor. MIT licensed.
          </p>
        </div>
        <nav class="foot-nav" aria-label="Footer">
          <div>
            <h4>Read</h4>
            <a href="/quickstart/">Quickstart</a>
            <a href="/multi-developer/">Multi-developer</a>
            <a href="/architecture/">Architecture</a>
            <a href="/configuration/">Configuration</a>
            <a href="/security/">Security model</a>
            <a href="/faq/">FAQ</a>
          </div>
          <div>
            <h4>Build</h4>
            <a href="/commands/">CLI commands</a>
            <a href="/api/">HTTP API</a>
            <a href="/install-extension/">VS Code extension</a>
            <a href="/troubleshooting/">Troubleshooting</a>
            <a href="/roadmap/">Roadmap</a>
          </div>
        </nav>
      </div>
      <div class="wrap foot-bottom">
        <span>© {new Date().getFullYear()} Patchwire · v{version}</span>
        <span class="foot-project-links">
          <a href={repo}>GitHub ↗</a>
          <span class="foot-sep" aria-hidden="true">·</span>
          <a href={`${repo}/issues`}>Issues ↗</a>
          <span class="foot-sep" aria-hidden="true">·</span>
          <a href={`${repo}/blob/main/LICENSE`}>MIT License ↗</a>
        </span>
        <span class="foot-tag">self-hosted · your hardware · two-way sync</span>
      </div>
    </footer>

    <!-- ───────── INTERACTIVE JS ─────────
         Wrapped in bindAll() and re-run on every astro:page-load so
         observers and listeners reattach after view-transition nav. -->
    <script is:inline>
      function bindAll() {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const coarse = matchMedia('(pointer: coarse)').matches;

        // Scroll reveal
        (() => {
          const els = document.querySelectorAll('.reveal');
          if (!('IntersectionObserver' in window)) {
            els.forEach(e => e.classList.add('is-in'));
            return;
          }
          const io = new IntersectionObserver((entries) => {
            entries.forEach(e => {
              if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
          els.forEach(e => io.observe(e));
        })();

        // Cursor spotlight on hero
        (() => {
          const spot = document.getElementById('spotlight');
          const hero = document.getElementById('hero');
          if (!spot || !hero || coarse || reduce) return;
          let raf = 0, tx = 60, ty = 40;
          hero.addEventListener('pointermove', (e) => {
            const r = hero.getBoundingClientRect();
            tx = ((e.clientX - r.left) / r.width) * 100;
            ty = ((e.clientY - r.top) / r.height) * 100;
            if (!raf) raf = requestAnimationFrame(() => {
              spot.style.setProperty('--x', tx + '%');
              spot.style.setProperty('--y', ty + '%');
              raf = 0;
            });
          });
          hero.addEventListener('pointerleave', () => {
            spot.style.setProperty('--x', '60%'); spot.style.setProperty('--y', '40%');
          });
        })();

        // Magnetic affordances
        (() => {
          if (coarse || reduce) return;
          document.querySelectorAll('.magnet').forEach(el => {
            let raf = 0, tx = 0, ty = 0;
            el.addEventListener('pointermove', (e) => {
              const r = el.getBoundingClientRect();
              tx = ((e.clientX - r.left) / r.width - 0.5) * 12;
              ty = ((e.clientY - r.top) / r.height - 0.5) * 8;
              if (!raf) raf = requestAnimationFrame(() => {
                el.style.transform = 'translate(' + tx + 'px,' + ty + 'px)'; raf = 0;
              });
            });
            el.addEventListener('pointerleave', () => { el.style.transform = ''; });
          });
        })();
      }

      bindAll();
      document.addEventListener('astro:page-load', bindAll);
    </script>

    <style>
      /* ════════ PAGE BASE (dark) ════════ */
      html.rc-brand.rc-dark,
      html.rc-brand.rc-dark body.page {
        background: #0B0B0D;
        color: var(--rc-bone);
        font-family: var(--rc-font-body);
      }
      .page {
        --bg: #0B0B0D;
        --panel: #131317;
        --panel-2: #17171C;
        --line: rgba(232, 226, 208, 0.10);
        --line-2: rgba(232, 226, 208, 0.18);
        --text: var(--rc-bone);
        --dim: var(--rc-bone-dim);
        --soft: var(--rc-bone-soft);
        --signal: var(--rc-phosphor);
        --signal-dim: var(--rc-phosphor-dim);
        --mono: var(--rc-font-mono);
        --disp: var(--rc-font-body);
        --r: 8px;
        margin: 0;
        overflow-x: hidden;
      }
      .wrap { max-width: 1180px; margin-inline: auto; padding-inline: clamp(20px, 4.5vw, 64px); }

      /* Skip link: offscreen until a keyboard user tabs to it. */
      .skip-link {
        position: absolute; left: 8px; top: -48px; z-index: 300;
        padding: 9px 16px; border-radius: var(--r);
        background: var(--signal); color: #0B0B0D;
        font-family: var(--mono); font-size: 13px;
        transition: top 0.18s ease;
      }
      .skip-link:focus { top: 8px; }

      /* ════════ SHARED TYPE ════════ */
      .eyebrow {
        display: inline-block;
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--signal-dim);
        margin-bottom: 18px;
      }
      .sec-h {
        font-family: var(--disp);
        font-weight: 600;
        font-size: clamp(28px, 4.2vw, 46px);
        line-height: 1.02;
        letter-spacing: -0.02em;
        margin: 0;
        color: var(--text);
      }
      .sec-h em { font-style: normal; color: var(--signal); }
      .sec-lead {
        font-size: 17px;
        line-height: 1.6;
        color: var(--dim);
        max-width: 62ch;
        margin: 18px 0 0;
      }

      /* ════════ CTA ════════ */
      .cta {
        display: inline-flex; align-items: center; gap: 10px;
        padding: 12px 20px;
        border-radius: var(--r);
        font-size: 14px; font-weight: 500;
        font-family: var(--disp);
        white-space: nowrap;
        transition: transform 0.18s cubic-bezier(0.32,0.72,0,1), background 0.2s, border-color 0.2s, color 0.2s;
        will-change: transform;
      }
      .cta-arrow { transition: transform 0.2s cubic-bezier(0.32,0.72,0,1); }
      .cta:hover .cta-arrow { transform: translateX(3px); }
      .cta:active { transform: translateY(1px) scale(0.99); }
      .cta-primary { background: var(--signal); color: #0B0B0D; }
      .cta-primary:hover { background: #d6ff77; }
      /* custom.css sets `html.rc-brand a { color: inherit }` at higher specificity,
         which would force bone text onto the lime button. Win it back for dark text. */
      .page a.cta-primary { color: #0B0B0D; }
      .page a.topbar-install { color: #0B0B0D; }
      .cta-ghost { color: var(--text); border: 1px solid var(--line-2); }
      .cta-ghost:hover { border-color: var(--signal); color: var(--signal); }
      .cta-lg { padding: 15px 26px; font-size: 15px; }
      .cta-row { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 30px; }
      .cta-center { justify-content: center; }
      .cta-fallback { font-family: var(--mono); font-size: 12px; color: var(--soft); margin: 14px 0 0; }
      .cta-fallback a { color: var(--dim); border-bottom: 1px solid var(--line-2); transition: color 0.2s, border-color 0.2s; }
      .cta-fallback a:hover { color: var(--signal); border-color: var(--signal); }
      .cta-center + .cta-fallback { text-align: center; }

      /* ════════ REVEAL ════════ */
      .reveal { opacity: 0; transform: translateY(16px); transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1); }
      .reveal.is-in { opacity: 1; transform: none; }

      /* ════════ TOP BAR ════════ */
      .topbar {
        position: sticky; top: 0; z-index: 100;
        display: flex; align-items: center; gap: 24px;
        padding: 14px clamp(20px, 4.5vw, 64px);
        background: rgba(11, 11, 13, 0.72);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
      }
      .wordmark {
        display: inline-flex; align-items: center; gap: 10px;
        font-family: var(--disp); font-weight: 600; font-size: 17px; line-height: 1;
        letter-spacing: -0.01em; color: var(--text);
        view-transition-name: brand-wordmark;
      }
      .wordmark svg { color: var(--text); transition: transform 0.4s cubic-bezier(0.32,0.72,0,1); }
      .wordmark:hover svg { transform: translateY(-0.5px) scale(1.04); }
      .topnav { display: flex; align-items: center; gap: 26px; margin-left: 14px; }
      .topnav a { font-size: 13.5px; color: var(--dim); transition: color 0.2s; }
      .topnav a:hover { color: var(--text); }
      .topnav-ext { color: var(--soft); }
      .topbar-right { display: flex; align-items: center; gap: 16px; margin-left: auto; }
      .meta-pill {
        display: inline-flex; align-items: center; gap: 7px;
        font-family: var(--mono); font-size: 11px; color: var(--dim);
        padding: 5px 11px; border: 1px solid var(--line); border-radius: 999px;
      }
      .meta-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--signal); box-shadow: 0 0 8px var(--signal); }
      .topbar-install {
        font-family: var(--disp); font-size: 13.5px; font-weight: 500;
        color: #0B0B0D; background: var(--signal);
        padding: 8px 15px; border-radius: var(--r);
        transition: transform 0.18s cubic-bezier(0.32,0.72,0,1), background 0.2s; will-change: transform;
      }
      .topbar-install:hover { background: #d6ff77; }

      /* ════════ HERO ════════ */
      .hero { position: relative; padding-block: clamp(64px, 11vh, 130px) clamp(72px, 12vh, 140px); overflow: hidden; }
      .hero-bg { position: absolute; inset: 0; pointer-events: none; }
      .grid-lines {
        position: absolute; inset: -1px;
        background-image:
          linear-gradient(var(--line) 1px, transparent 1px),
          linear-gradient(90deg, var(--line) 1px, transparent 1px);
        background-size: 56px 56px;
        mask-image: radial-gradient(120% 90% at 70% 0%, #000 30%, transparent 78%);
        -webkit-mask-image: radial-gradient(120% 90% at 70% 0%, #000 30%, transparent 78%);
        opacity: 0.6;
      }
      .hero-glow {
        position: absolute; top: -12%; right: -6%; width: 60vw; height: 60vw; max-width: 760px; max-height: 760px;
        background: radial-gradient(circle, rgba(201, 245, 100, 0.16), transparent 62%);
        filter: blur(20px);
      }
      .hero-spot {
        position: absolute; inset: 0;
        background: radial-gradient(420px circle at var(--x, 60%) var(--y, 40%), rgba(201,245,100,0.10), transparent 70%);
        transition: background 0.18s ease-out;
      }
      .hero-inner {
        position: relative;
        max-width: 1180px; margin-inline: auto; padding-inline: clamp(20px, 4.5vw, 64px);
        display: grid; grid-template-columns: 1.35fr 0.65fr; gap: clamp(32px, 5vw, 72px); align-items: center;
      }
      .hero-h {
        font-family: var(--disp); font-weight: 600;
        font-size: clamp(32px, 4.6vw, 54px); line-height: 1.04; letter-spacing: -0.03em;
        margin: 0; color: var(--text);
      }
      .hero-h-2 { display: block; color: var(--text); }
      .hero-h em { font-style: normal; color: var(--signal); }
      .hero-sub { font-size: 18px; line-height: 1.6; color: var(--dim); max-width: 46ch; margin: 24px 0 0; }
      .hero-sub strong { color: var(--text); font-weight: 600; }

      /* ── Patch-cable diagram ── */
      .wire { margin: 0; display: flex; flex-direction: column; align-items: stretch; gap: 0; }
      .node {
        background: var(--panel); border: 1px solid var(--line-2); border-radius: 12px;
        padding: 16px 18px; box-shadow: 0 18px 50px rgba(0,0,0,0.4);
      }
      .node-remote { border-color: rgba(201,245,100,0.32); box-shadow: 0 18px 50px rgba(0,0,0,0.4), 0 0 0 1px rgba(201,245,100,0.06); }
      .node-top { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
      .node-glyph { font-family: var(--mono); font-size: 16px; color: var(--signal); }
      .node-kind { font-family: var(--mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim); }
      .node-body { display: flex; flex-direction: column; gap: 5px; }
      .node-line { font-family: var(--mono); font-size: 13px; color: var(--soft); }
      .node-prompt { color: var(--text); }
      .node-run { color: var(--signal-dim); }

      .wire-mid { position: relative; height: 96px; display: flex; align-items: center; justify-content: center; }
      .wire-track {
        position: absolute; top: 0; bottom: 0; left: 50%; transform: translateX(-50%);
        width: 2px; background: linear-gradient(180deg, transparent, var(--line-2) 14%, var(--line-2) 86%, transparent);
      }
      .pulse {
        position: absolute; left: 50%; transform: translateX(-50%);
        width: 8px; height: 8px; border-radius: 50%;
        background: var(--signal); box-shadow: 0 0 12px 2px rgba(201,245,100,0.7);
      }
      .pulse-down { animation: travel-down 2.8s cubic-bezier(0.45,0,0.55,1) infinite; }
      .pulse-up { animation: travel-up 2.8s cubic-bezier(0.45,0,0.55,1) infinite; animation-delay: 1.4s; }
      @keyframes travel-down { 0% { top: -2px; opacity: 0; } 12% { opacity: 1; } 88% { opacity: 1; } 100% { top: calc(100% - 6px); opacity: 0; } }
      @keyframes travel-up { 0% { top: calc(100% - 6px); opacity: 0; } 12% { opacity: 1; } 88% { opacity: 1; } 100% { top: -2px; opacity: 0; } }
      .wire-chip {
        position: relative; z-index: 1;
        font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; color: var(--text);
        background: var(--bg); border: 1px solid var(--line-2); border-radius: 999px;
        padding: 5px 12px;
      }

      /* ════════ LOOP / STATIONS ════════ */
      .loop { padding-block: clamp(70px, 10vh, 120px); border-top: 1px solid var(--line); }
      .stations {
        list-style: none; margin: 48px 0 0; padding: 0;
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 0;
        counter-reset: st;
      }
      .station { position: relative; padding: 0 30px; }
      .station + .station { border-left: 1px solid var(--line); }
      .station-dot {
        display: block; width: 11px; height: 11px; border-radius: 50%;
        background: var(--signal); box-shadow: 0 0 10px rgba(201,245,100,0.7); margin-bottom: 20px;
      }
      .station-h { font-family: var(--disp); font-size: 20px; font-weight: 600; letter-spacing: -0.01em; margin: 0 0 8px; color: var(--text); }
      .station-p { font-size: 15px; line-height: 1.58; color: var(--dim); margin: 0; }

      /* ════════ PANEL SECTION ════════ */
      .panelsec { padding-block: clamp(70px, 10vh, 120px); border-top: 1px solid var(--line); }
      .panelsec-grid { display: grid; grid-template-columns: 1fr 0.82fr; gap: clamp(36px, 6vw, 80px); align-items: center; }
      .featlist { list-style: none; margin: 30px 0 0; padding: 0; display: flex; flex-direction: column; gap: 0; }
      .featlist li { display: flex; flex-direction: column; gap: 4px; padding: 18px 0; border-top: 1px solid var(--line); }
      .featlist li:last-child { border-bottom: 1px solid var(--line); }
      .feat-k { font-family: var(--mono); font-size: 13px; letter-spacing: 0.02em; color: var(--signal); }
      .feat-v { font-size: 15px; line-height: 1.55; color: var(--dim); }

      /* faithful panel preview */
      .panel {
        background: var(--panel); border: 1px solid var(--line-2); border-radius: 14px;
        padding: 18px; box-shadow: 0 24px 60px rgba(0,0,0,0.45); max-width: 360px; margin-inline: auto; width: 100%;
        font-family: var(--mono);
      }
      .panel-head { font-size: 10.5px; letter-spacing: 0.16em; color: var(--soft); margin-bottom: 16px; }
      .panel-project { display: flex; flex-direction: column; gap: 4px; margin-bottom: 16px; }
      .pp-name { font-family: var(--disp); font-size: 15px; font-weight: 600; color: var(--text); }
      .pp-meta { font-size: 11.5px; color: var(--soft); }
      .panel-btn {
        background: var(--signal); color: #0B0B0D; font-family: var(--disp); font-weight: 600; font-size: 13px;
        text-align: center; padding: 10px; border-radius: 7px; margin-bottom: 16px;
      }
      .panel-sync { border: 1px solid var(--line-2); border-radius: 9px; padding: 12px; margin-bottom: 14px; }
      .ps-label { display: block; font-size: 9.5px; letter-spacing: 0.14em; color: var(--soft); margin-bottom: 10px; }
      .ps-row { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
      .ps-pill { font-size: 11.5px; color: #0B0B0D; background: var(--signal); padding: 3px 9px; border-radius: 999px; font-family: var(--disp); font-weight: 600; }
      .ps-act { font-size: 11.5px; color: var(--dim); }
      .panel-links { font-size: 11.5px; color: var(--soft); display: flex; gap: 8px; }
      .panel-links span:not(.dotsep) { color: var(--dim); }

      /* ════════ HARDWARE ════════ */
      .hardware { padding-block: clamp(70px, 10vh, 120px); border-top: 1px solid var(--line); }
      .hw-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin-top: 44px; }
      .hw-col { padding: 0 30px; }
      .hw-col + .hw-col { border-left: 1px solid var(--line); }
      .hw-num { font-family: var(--mono); font-size: 12px; color: var(--signal-dim); letter-spacing: 0.12em; }
      .hw-col p { font-size: 15.5px; line-height: 1.55; color: var(--dim); margin: 14px 0 0; }

      /* ════════ CLI ════════ */
      .cli { padding-block: clamp(70px, 10vh, 120px); border-top: 1px solid var(--line); }
      .cli-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
      .cli-block {
        margin: 0; background: var(--panel); border: 1px solid var(--line-2); border-radius: 12px;
        padding: 22px 24px; overflow-x: auto; box-shadow: 0 18px 50px rgba(0,0,0,0.4);
      }
      .cli-block code { font-family: var(--mono); font-size: 13.5px; line-height: 1.9; color: var(--text); display: block; }
      .cli-block .cl { display: block; white-space: pre; }
      .cli-block .pr { color: var(--signal); }
      .cli-block .cm { color: var(--soft); }
      .cli-block .st { color: var(--signal-dim); }
      .cli-block .ok { color: var(--signal); }

      /* ════════ END CTA ════════ */
      .endcta { padding-block: clamp(80px, 12vh, 150px); border-top: 1px solid var(--line); text-align: center; }
      .endcta-inner { display: flex; flex-direction: column; align-items: center; }
      .endcta-h {
        font-family: var(--disp); font-weight: 600;
        font-size: clamp(34px, 6vw, 60px); line-height: 1.0; letter-spacing: -0.03em; margin: 0; color: var(--text);
      }
      .endcta-h em { font-style: normal; color: var(--signal); }
      .endcta-sub { font-size: 18px; line-height: 1.6; color: var(--dim); max-width: 50ch; margin: 22px 0 0; }

      /* ════════ FOOTER ════════ */
      .foot { border-top: 1px solid var(--line); padding-block: 64px 40px; }
      .foot-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; }
      .wordmark-foot { color: var(--text); }
      .foot-blurb { font-size: 14px; line-height: 1.6; color: var(--soft); max-width: 38ch; margin: 16px 0 0; }
      .foot-nav { display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px; }
      .foot-nav h4 { font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--soft); margin: 0 0 14px; }
      .foot-nav a { display: block; font-size: 14px; color: var(--dim); padding: 4px 0; transition: color 0.2s; }
      .foot-nav a:hover { color: var(--signal); }
      .foot-bottom {
        display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap;
        margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--line);
        font-family: var(--mono); font-size: 11.5px; color: var(--soft);
      }
      .foot-project-links a { color: var(--dim); }
      .foot-project-links a:hover { color: var(--signal); }
      .foot-sep { color: var(--line-2); margin: 0 4px; }

      /* ════════ RESPONSIVE ════════ */
      @media (max-width: 980px) {
        .hero-inner { grid-template-columns: 1fr; gap: 48px; }
        .wire { max-width: 420px; }
        .panelsec-grid { grid-template-columns: 1fr; gap: 40px; }
        .cli-grid { grid-template-columns: 1fr; gap: 28px; }
      }
      @media (max-width: 820px) {
        .topnav { display: none; }
        .stations, .hw-cols { grid-template-columns: 1fr; gap: 0; }
        .station, .hw-col { padding: 22px 0; }
        .station + .station, .hw-col + .hw-col { border-left: none; border-top: 1px solid var(--line); }
        .hero-sub { font-size: 16px; }
      }
      @media (max-width: 560px) {
        .topbar-install { display: none; }
        .foot-grid { grid-template-columns: 1fr; gap: 36px; }
        .cta-row { flex-direction: column; align-items: stretch; }
        .cta-row .cta { justify-content: center; }
        .cta-center { align-items: center; }
        .cta-center .cta { width: 100%; max-width: 320px; }
        .foot-bottom { flex-direction: column; align-items: flex-start; }
      }

      /* ════════ REDUCED MOTION ════════ */
      @media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1; transform: none; transition: none; }
        .pulse-down, .pulse-up { animation: none; }
        .pulse-down { top: 18px; } .pulse-up { top: calc(100% - 24px); }
        .hero-spot { display: none; }
        .cta, .cta-arrow, .wordmark svg, .topbar-install { transition: none; }
      }
    </style>
  </body>
</html>
