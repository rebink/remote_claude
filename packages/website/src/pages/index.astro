---
import '../styles/custom.css';
import { ClientRouter } from 'astro:transitions';

const repo = 'https://github.com/rebink/remote_claude';
const version = '0.3.0';
const rev = 'b71dc5e';
---

<!doctype html>
<html lang="en" class="rc-brand rc-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0E0E10" />
    <title>Patchwire: shared AI infrastructure for engineering teams</title>
    <meta
      name="description"
      content="Run Claude, Codex, or Aider on machines you control. Every change comes back as a reviewable git diff. Shared, governed AI for your whole team, not individual seats."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://patchwire.dev/" />
    <meta property="og:title" content="Patchwire" />
    <meta
      property="og:description"
      content="Run Claude, Codex, or Aider on machines you control. Every change comes back as a reviewable git diff. Shared, governed AI for your whole team, not individual seats."
    />
    <meta property="og:image" content="https://patchwire.dev/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Patchwire" />
    <meta
      name="twitter:description"
      content="Only diffs cross the wire. Run Claude, Codex, or Aider on a machine you control, not a vendor's cloud; review every change as a real git diff before it lands."
    />
    <meta name="twitter:image" content="https://patchwire.dev/og.png" />
    <ClientRouter />
  </head>
  <body class="page">
    <a href="#main" class="skip-link">Skip to content</a>
    <!-- ───────── TOP BAR ───────── -->
    <header class="topbar">
      <a class="wordmark" href="/" aria-label="Patchwire home">
        <svg width="26" height="26" viewBox="0 0 22 22" aria-hidden="true">
          <rect x="0.5" y="0.5" width="9" height="9" stroke="currentColor" stroke-width="1.8" fill="none"/>
          <rect x="12.5" y="12.5" width="9" height="9" fill="currentColor"/>
          <line x1="6" y1="11" x2="16" y2="11" stroke="currentColor" stroke-width="1.4" stroke-dasharray="1.4 2"/>
          <circle cx="11" cy="11" r="1.5" fill="#C9F564"/>
        </svg>
        <span>Patchwire</span>
      </a>
      <nav class="topnav" aria-label="Primary">
        <a href="/quickstart/">Quickstart</a>
        <a href="/multi-developer/">Teams</a>
        <a href="/architecture/">Architecture</a>
        <a href="/commands/">CLI</a>
        <a href={repo} class="topnav-ext">GitHub ↗</a>
      </nav>
      <span class="meta-pill">
        <span class="meta-dot"></span>
        v{version}
      </span>
    </header>

    <!-- ───────── HERO ───────── -->
    <main id="main">
    <section class="hero" id="hero">
      <!-- background atmospherics -->
      <div class="hero-bg" aria-hidden="true">
        <div class="hero-grid-bg"></div>
        <div class="hero-spotlight" id="spotlight"></div>
        <div class="hero-glow hero-glow-phos"></div>
        <div class="hero-glow hero-glow-amber"></div>
      </div>

      <div class="hero-inner">
        <div class="hero-eyebrow reveal">
          <span class="eyebrow-tag">VS Code extension</span>
          <span class="eyebrow-sep">·</span>
          <span class="eyebrow-rev">0.3.6</span>
          <span class="eyebrow-sep">·</span>
          <span class="eyebrow-status"><span class="eyebrow-pulse"></span>shipping</span>
        </div>

        <h1 class="hero-h reveal">
          <span class="hero-h-line">Your AI, in</span>
          <span class="hero-h-line">your editor.</span>
          <span class="hero-h-line"><em>On hardware you own.</em></span>
        </h1>

        <p class="hero-sub reveal">
          Install the VS Code extension and it opens a Claude Code session on a machine
          <strong>you</strong> control. Two-way sync keeps your laptop and the remote
          byte-identical, so the edits Claude makes land on your machine as it makes
          them, and you run, hot-reload, and debug locally exactly as before.
        </p>
        <p class="hero-tagline reveal">Only diffs cross the wire.</p>

        <!-- ── The VS Code extension, the star ── -->
        <div class="hero-mock reveal">
          <div class="vscode" data-tilt>
            <header class="vscode-bar">
              <span class="term-dots" aria-hidden="true">
                <span></span><span></span><span></span>
              </span>
              <span class="vscode-title">your-app — Visual Studio Code</span>
              <span class="vscode-host" aria-hidden="true">·</span>
            </header>
            <div class="vscode-body">
              <aside class="vscode-activity" aria-hidden="true">
                <span class="va">▤</span>
                <span class="va">⌕</span>
                <span class="va">⎇</span>
                <span class="va va-active" title="Patchwire">
                  <svg width="14" height="14" viewBox="0 0 22 22" aria-hidden="true">
                    <rect x="0.5" y="0.5" width="9" height="9" stroke="currentColor" stroke-width="1.8" fill="none"/>
                    <rect x="12.5" y="12.5" width="9" height="9" fill="currentColor"/>
                    <line x1="6" y1="11" x2="16" y2="11" stroke="currentColor" stroke-width="1.4" stroke-dasharray="1.4 2"/>
                    <circle cx="11" cy="11" r="1.5" fill="#C9F564"/>
                  </svg>
                </span>
                <span class="va">▦</span>
              </aside>

              <aside class="vscode-side">
                <span class="pw-head">PATCHWIRE: CHAT</span>
                <div class="pw-project">
                  <span class="pw-project-name">your-app</span>
                  <span class="pw-meta">you@remote</span>
                  <span class="pw-meta">~/workspace/your-app</span>
                </div>
                <button class="pw-session" type="button">
                  <span class="pw-session-ico" aria-hidden="true">❄</span> Focus Claude session
                </button>
                <div class="pw-sync">
                  <div class="pw-sync-top">
                    <span class="pw-sync-label">TWO-WAY SYNC</span>
                    <span class="pw-sync-pill">✓ In sync</span>
                  </div>
                  <div class="pw-sync-row">
                    <span class="pw-sync-act">⇄ Flush now</span>
                    <span class="pw-sync-act">❚❚ Pause</span>
