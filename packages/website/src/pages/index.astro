---
import '../styles/custom.css';

const repo = 'https://github.com/rebink/patchwire';
const version = '0.1.0';
const rev = '263e2e3';
const date = 'Mon, 01 Jun 2026';
---

<!doctype html>
<html lang="en" class="rc-brand">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F5F1E8" />
    <title>Patchwire — local stays local, AI stays remote</title>
    <meta
      name="description"
      content="Push your project to a remote Mac. Run an AI CLI there with the whole repo. Pull back a unified diff. Apply only what you want."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Patchwire" />
    <meta
      property="og:description"
      content="Local-first development. AI executes remotely. Diffs come back for review."
    />
  </head>
  <body>
    <!-- ───────── TOP BAR ───────── -->
    <header class="topbar">
      <a class="wordmark" href="/" aria-label="Patchwire home">
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
          <rect x="0.5" y="0.5" width="9" height="9" stroke="currentColor" fill="none"/>
          <rect x="12.5" y="12.5" width="9" height="9" fill="currentColor"/>
          <line x1="6" y1="11" x2="16" y2="11" stroke="currentColor" stroke-dasharray="1 2"/>
        </svg>
        <span>Patchwire</span>
      </a>
      <nav class="topnav" aria-label="Primary">
        <a href="/quickstart/">Quickstart</a>
        <a href="/architecture/">Architecture</a>
        <a href="/commands/">CLI</a>
        <a href="/install-extension/">Extension</a>
        <a href={repo} class="topnav-ext">GitHub ↗</a>
      </nav>
      <span class="patch-meta">
        <span class="patch-no">PATCH 0001</span>
        <span class="patch-sep">·</span>
        <span class="patch-rev">rev {rev}</span>
      </span>
    </header>

    <!-- ───────── HERO: Patch #1 cover ───────── -->
    <section class="cover">
      <div class="cover-grid">
        <!-- Email-style patch header (left rail) -->
        <aside class="patch-email" aria-hidden="true">
          <div class="patch-row"><span class="patch-key">From:</span> <span class="patch-val">patchwire &lt;hi@patchwire.dev&gt;</span></div>
          <div class="patch-row"><span class="patch-key">Date:</span> <span class="patch-val">{date}</span></div>
          <div class="patch-row"><span class="patch-key">Subject:</span> <span class="patch-val">[PATCH 0001] Welcome.</span></div>
          <div class="patch-row patch-row-meta">
            <span class="patch-key">In-Reply-To:</span>
            <span class="patch-val patch-val-dim">your-workflow@{rev}</span>
          </div>
        </aside>

        <!-- Body -->
        <div class="cover-body">
          <span class="kicker"><span class="kicker-dot"></span>0001-welcome.patch · 4 insertions(+), 2 deletions(−)</span>

          <h1 class="cover-h">
            <span class="cover-h-w" style="--i:0">Welcome</span>
            <span class="cover-h-w" style="--i:1">to</span>
            <span class="cover-h-w cover-h-mark" style="--i:2">Patchwire.</span>
          </h1>

          <p class="cover-lede">
            Push your project to a faster machine. Run an AI there with
            the whole&nbsp;repo. Pull back a <em>diff</em> you preview
            and <code>git apply</code> &mdash; nothing else crosses the wire.
          </p>

          <!-- ── The hero diff ── -->
          <pre class="diff diff-hero" aria-label="Welcome patch">
<span class="diff-meta"><span class="diff-meta-key">diff --git</span> <span class="diff-meta-path">a/your-workflow.md</span> <span class="diff-meta-path">b/your-workflow.md</span></span>
<span class="diff-meta diff-meta-dim">index 0000000..{rev} 100644</span>
<span class="diff-hunk">@@ -1,4 +1,5 @@ how AI fits into your workflow</span>
<span class="diff-line diff-context" style="--i:1"><span class="num">1</span><span class="sign"> </span><span class="content">You keep coding on your laptop.</span></span>
<span class="diff-line diff-minus"   style="--i:2"><span class="num">2</span><span class="sign">-</span><span class="content">Your AI lives in your editor &mdash; slow over SSH.</span></span>
<span class="diff-line diff-plus"    style="--i:3"><span class="num">2</span><span class="sign">+</span><span class="content">Your AI runs on the Mac, with the whole repo.</span></span>
<span class="diff-line diff-minus"   style="--i:4"><span class="num">3</span><span class="sign">-</span><span class="content">It edits files. You hope it didn't break anything.</span></span>
<span class="diff-line diff-plus"    style="--i:5"><span class="num">3</span><span class="sign">+</span><span class="content">It returns a diff. You preview. You <strong>git apply</strong>.</span></span>
<span class="diff-line diff-context" style="--i:6"><span class="num">4</span><span class="sign"> </span><span class="content">Diffs come back. You review them. You apply them.</span></span>
<span class="diff-line diff-plus"    style="--i:7"><span class="num">5</span><span class="sign">+</span><span class="content">&mdash; Patchwire</span></span>
</pre>

          <div class="cover-cta">
            <a href="/quickstart/" class="cta cta-primary">
              <span class="cta-cursor"></span>
              <span>Apply patch</span>
              <span class="cta-arrow">→</span>
            </a>
            <a href={repo} class="cta cta-ghost">
              <span>View on GitHub</span>
              <span class="cta-arrow">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────── HUNK 1: The local-first stance ───────── -->
    <section class="hunk">
      <div class="hunk-marker">@@ HUNK 1 · the local-first stance @@</div>
      <div class="hunk-grid">
        <div class="hunk-prose">
          <h2 class="hunk-h">Local stays local. <em>AI stays remote.</em></h2>
          <p>
            Code-server over SSH is laggy. Cursor wants to edit in place.
            Mounted filesystems are a coin flip. Patchwire picks the
            difficult cut: <strong>your code never leaves your laptop's
            editor, and the AI never touches it directly.</strong> Only
            the result crosses the wire.
          </p>
        </div>

        <!-- Side-by-side LOCAL vs REMOTE -->
        <div class="splitcard">
          <article class="splitcard-side splitcard-local">
            <header class="splitcard-head">
              <span class="splitcard-dot splitcard-dot-amber" aria-hidden="true"></span>
              <span class="splitcard-label">LOCAL</span>
              <span class="splitcard-host">macbook&nbsp;~</span>
            </header>
            <ul class="splitcard-list">
              <li>Your IDE, hot-reload, debugger</li>
              <li>Source of truth — never edited remotely</li>
              <li>Diff preview &amp; selective <code>git apply</code></li>
            </ul>
          </article>
          <article class="splitcard-side splitcard-remote">
            <header class="splitcard-head splitcard-head-dark">
              <span class="splitcard-dot splitcard-dot-phosphor" aria-hidden="true"></span>
              <span class="splitcard-label">REMOTE</span>
              <span class="splitcard-host">mac&#8209;mini&nbsp;~</span>
            </header>
            <ul class="splitcard-list splitcard-list-dark">
              <li>Clean checkout per request</li>
              <li>Runs <code>claude --print</code> (or any AI CLI)</li>
              <li>Captures <code>git diff</code>, resets the tree</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- ───────── HUNK 2: One install per side ───────── -->
    <section class="hunk">
      <div class="hunk-marker">@@ HUNK 2 · one install per side @@</div>
      <h2 class="hunk-h hunk-h-center">
        Three commands. <em>Forever.</em>
      </h2>
      <p class="hunk-lede">
        Patchwire isn't a SaaS. Install one binary on each Mac, drop a
        YAML in your project, you're done.
      </p>

      <pre class="diff diff-install" aria-label="Install commands">
<span class="diff-meta"><span class="diff-meta-key">diff --git</span> <span class="diff-meta-path">a/install.sh</span> <span class="diff-meta-path">b/install.sh</span></span>
<span class="diff-hunk">@@ on the Mac Mini @@</span>
<span class="diff-line diff-plus"   ><span class="num">1</span><span class="sign">+</span><span class="content">pnpm add -g github:rebink/patchwire</span></span>
<span class="diff-line diff-plus"   ><span class="num">2</span><span class="sign">+</span><span class="content">patchwire-agent install   # launchd, prints a token</span></span>
<span class="diff-hunk">@@ on your laptop @@</span>
<span class="diff-line diff-plus"   ><span class="num">1</span><span class="sign">+</span><span class="content">pnpm add -g github:rebink/patchwire</span></span>
<span class="diff-line diff-plus"   ><span class="num">2</span><span class="sign">+</span><span class="content">patchwire setup           # auto-detects Tailscale peers</span></span>
<span class="diff-line diff-plus"   ><span class="num">3</span><span class="sign">+</span><span class="content">patchwire ask "refactor login_bloc to freezed"</span></span>
</pre>
    </section>

    <!-- ───────── HUNK 3: The request lifecycle ───────── -->
    <section class="hunk">
      <div class="hunk-marker">@@ HUNK 3 · the request lifecycle @@</div>
      <h2 class="hunk-h">One HTTP call. <em>End&#8209;to&#8209;end.</em></h2>

      <ol class="lifecycle">
        <li class="lifecycle-step">
          <span class="lifecycle-no">01</span>
          <div class="lifecycle-body">
            <h3 class="lifecycle-h">Read the config.</h3>
            <p>CLI reads <code>patchwire.yml</code> for host, user, project path, agent URL, AI command.</p>
          </div>
        </li>
        <li class="lifecycle-step">
          <span class="lifecycle-no">02</span>
          <div class="lifecycle-body">
            <h3 class="lifecycle-h">Push code over rsync.</h3>
            <p>One-way push with your excludes. The remote always mirrors your local; never the other direction.</p>
          </div>
        </li>
        <li class="lifecycle-step">
          <span class="lifecycle-no">03</span>
          <div class="lifecycle-body">
            <h3 class="lifecycle-h">HTTP <code>/ask</code> with bearer token.</h3>
            <p>Agent verifies the project is a clean git tree, then spawns the configured AI CLI with the prompt on stdin.</p>
          </div>
        </li>
        <li class="lifecycle-step">
          <span class="lifecycle-no">04</span>
          <div class="lifecycle-body">
            <h3 class="lifecycle-h">AI edits files. Agent captures <code>git diff</code>.</h3>
            <p>The AI edits a clean checkout natively. The agent derives the diff from git, then resets the tree. Robust, no prompt fragility.</p>
          </div>
        </li>
        <li class="lifecycle-step">
          <span class="lifecycle-no">05</span>
          <div class="lifecycle-body">
            <h3 class="lifecycle-h">Diff returns. You decide.</h3>
            <p>Colorized preview. <code>git apply</code> selectively. Nothing lands without your hand on it.</p>
          </div>
        </li>
      </ol>
    </section>

    <!-- ───────── HUNK 4: What's added vs removed ───────── -->
    <section class="hunk hunk-changelog">
      <div class="hunk-marker">@@ HUNK 4 · summary of changes @@</div>
      <h2 class="hunk-h">Compared to the alternatives.</h2>

      <div class="changelog">
        <div class="changelog-col changelog-removed">
          <header class="changelog-head">
            <span class="changelog-sign">−</span>
            <span class="changelog-label">REMOVED</span>
          </header>
          <ul>
            <li>SSH-mounted filesystems with editor lag</li>
            <li>Edit-in-place AI that commits on its own</li>
            <li>Lock-in to one AI provider</li>
            <li>Bidirectional sync &amp; conflict hell</li>
            <li>SaaS billing for "AI compute"</li>
          </ul>
        </div>
        <div class="changelog-col changelog-added">
          <header class="changelog-head">
            <span class="changelog-sign">+</span>
            <span class="changelog-label">ADDED</span>
          </header>
          <ul>
            <li>Full-repo context on a heavier machine</li>
            <li>Unified diffs, reviewed before they land</li>
            <li>AI-agnostic: Claude, Codex, aider, anything</li>
            <li>One-way rsync push (no surprises locally)</li>
            <li>Self-hosted. MIT. Two binaries.</li>
          </ul>
        </div>
      </div>

      <p class="changelog-stat">
        <span class="changelog-stat-key">1 file changed,</span>
        <span class="changelog-plus">5 insertions(+),</span>
        <span class="changelog-minus">5 deletions(−)</span>
      </p>
    </section>

    <!-- ───────── APPLY: final CTA ───────── -->
    <section class="apply">
      <div class="apply-meta">
        <span class="patch-key">Subject:</span>
        <span class="patch-val">[PATCH 0002] You're ready.</span>
      </div>
      <h2 class="apply-h">
        Apply <em>patch</em>.
      </h2>
      <p class="apply-lede">
        Three commands per side, one YAML, five minutes. Reviewable diffs the whole way.
      </p>
      <div class="apply-cta">
        <a href="/quickstart/" class="cta cta-primary cta-dark">
          <span class="cta-cursor"></span>
          <span>Start the Quickstart</span>
          <span class="cta-arrow">→</span>
        </a>
        <a href="/install-extension/" class="cta cta-ghost cta-ghost-dark">
          <span>Install the VS Code extension</span>
          <span class="cta-arrow">→</span>
        </a>
      </div>
    </section>

    <!-- ───────── FOOTER ───────── -->
    <footer class="foot">
      <div class="foot-grid">
        <div class="foot-mark">
          <span class="wordmark wordmark-dark">
            <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
              <rect x="0.5" y="0.5" width="9" height="9" stroke="currentColor" fill="none"/>
              <rect x="12.5" y="12.5" width="9" height="9" fill="currentColor"/>
              <line x1="6" y1="11" x2="16" y2="11" stroke="currentColor" stroke-dasharray="1 2"/>
            </svg>
            <span>Patchwire</span>
          </span>
          <p class="foot-blurb">
            Built with restraint. MIT licensed. By people who like their laptops quiet.
          </p>
        </div>
        <nav class="foot-nav" aria-label="Footer">
          <div>
            <h4>Docs</h4>
            <a href="/quickstart/">Quickstart</a>
            <a href="/architecture/">Architecture</a>
            <a href="/configuration/">Configuration</a>
            <a href="/security/">Security model</a>
          </div>
          <div>
            <h4>Reference</h4>
            <a href="/commands/">CLI commands</a>
            <a href="/api/">HTTP API</a>
            <a href="/troubleshooting/">Troubleshooting</a>
            <a href="/faq/">FAQ</a>
          </div>
          <div>
            <h4>Project</h4>
            <a href={repo}>GitHub ↗</a>
            <a href={`${repo}/issues`}>Issues ↗</a>
            <a href={`${repo}/blob/main/LICENSE`}>License ↗</a>
            <a href="/roadmap/">Roadmap</a>
          </div>
        </nav>
      </div>
      <div class="foot-bottom">
        <span>© {new Date().getFullYear()} Patchwire · v{version} · rev&nbsp;{rev}</span>
        <span class="foot-tag">local-first · ai-remote · diff-reviewable</span>
      </div>
    </footer>

    <style>
      /* ═══════════════════════════════════════════════════════════
         PAGE TOKENS
         ═══════════════════════════════════════════════════════════ */
      :root {
        --gutter: clamp(20px, 4vw, 56px);
        --max: 1200px;
        --rc-line-num: rgba(14, 14, 16, 0.32);
      }

      /* ═══════════════════════════════════════════════════════════
         TOP BAR
         ═══════════════════════════════════════════════════════════ */
      .topbar {
        position: relative;
        z-index: 10;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 32px;
        padding: 22px var(--gutter);
        border-bottom: 1px solid var(--rc-hairline-paper);
        background: var(--rc-paper);
      }
      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: var(--rc-font-display);
        font-weight: 500;
        font-size: 17px;
        letter-spacing: -0.01em;
        color: var(--rc-ink);
      }
      .topnav {
        display: flex;
        justify-content: center;
        gap: 28px;
        font-size: 14px;
      }
      .topnav a {
        color: var(--rc-charcoal);
        opacity: 0.78;
        transition: opacity 0.15s ease;
      }
      .topnav a:hover { opacity: 1; }

      .patch-meta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        color: var(--rc-charcoal);
        opacity: 0.66;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .patch-no  { color: var(--rc-ink); opacity: 0.9; }
      .patch-sep { opacity: 0.5; }
      .patch-rev { color: var(--rc-charcoal); }

      /* ═══════════════════════════════════════════════════════════
         COVER (HERO)
         ═══════════════════════════════════════════════════════════ */
      .cover {
        padding: clamp(48px, 7vw, 96px) var(--gutter) clamp(60px, 9vw, 120px);
        max-width: var(--max);
        margin: 0 auto;
        position: relative;
      }
      /* Hairline corner registration marks — editorial flourish */
      .cover::before,
      .cover::after {
        content: '';
        position: absolute;
        width: 18px;
        height: 18px;
        border-color: var(--rc-rule-paper);
        border-style: solid;
      }
      .cover::before {
        top: clamp(28px, 4vw, 56px);
        left: clamp(8px, 1.5vw, 24px);
        border-width: 1px 0 0 1px;
      }
      .cover::after {
        bottom: clamp(28px, 4vw, 56px);
        right: clamp(8px, 1.5vw, 24px);
        border-width: 0 1px 1px 0;
      }

      .cover-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: clamp(28px, 4vw, 56px);
      }
      @media (min-width: 1000px) {
        .cover-grid {
          grid-template-columns: 220px minmax(0, 1fr);
          gap: 64px;
        }
      }

      /* Email-style patch header (left rail) */
      .patch-email {
        font-family: var(--rc-font-mono);
        font-size: 11.5px;
        line-height: 1.85;
        color: var(--rc-charcoal-dim);
        border-left: 1px solid var(--rc-amber);
        padding: 4px 0 4px 16px;
        align-self: start;
      }
      .patch-row { display: block; }
      .patch-row-meta { margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--rc-hairline-paper); }
      .patch-key {
        display: inline-block;
        min-width: 78px;
        color: var(--rc-amber-dim);
        opacity: 0.9;
      }
      .patch-val { color: var(--rc-charcoal); }
      .patch-val-dim { color: var(--rc-charcoal-dim); }

      /* Cover body */
      .cover-body { min-width: 0; }

      .kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--rc-charcoal);
        opacity: 0.68;
        margin-bottom: 28px;
      }
      .kicker-dot {
        width: 6px; height: 6px;
        background: var(--rc-phosphor-dim);
        border-radius: 50%;
        box-shadow: 0 0 0 3px rgba(142, 174, 63, 0.12);
        animation: kicker-pulse 2.2s ease-in-out infinite;
      }
      @keyframes kicker-pulse {
        0%, 100% { opacity: 0.7; }
        50%      { opacity: 1; }
      }

      .cover-h {
        font-family: var(--rc-font-display);
        font-weight: 400;
        font-size: clamp(40px, 7.8vw, 112px);
        line-height: 0.96;
        letter-spacing: -0.035em;
        color: var(--rc-ink);
        margin: 0 0 32px;
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
        text-wrap: balance;
      }
      .cover-h-w {
        display: inline-block;
        opacity: 0;
        transform: translateY(0.35em);
        animation: word-rise 0.65s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
        animation-delay: calc(var(--i) * 0.08s + 0.05s);
        margin-right: 0.22em;
      }
      @keyframes word-rise {
        to { opacity: 1; transform: translateY(0); }
      }
      .cover-h-mark {
        font-style: italic;
        font-weight: 380;
        font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
        color: var(--rc-amber-dim);
      }

      .cover-lede {
        font-family: var(--rc-font-display);
        font-weight: 380;
        font-size: clamp(18px, 1.5vw, 22px);
        line-height: 1.55;
        color: var(--rc-charcoal);
        margin: 0 0 36px;
        max-width: 48ch;
        font-variation-settings: 'SOFT' 60;
        text-wrap: pretty;
      }
      .cover-lede em {
        font-style: italic;
        color: var(--rc-ink);
        font-variation-settings: 'SOFT' 100, 'WONK' 1;
      }
      .cover-lede code {
        font-family: var(--rc-font-mono);
        font-size: 0.86em;
        background: rgba(201, 245, 100, 0.20);
        padding: 0.1em 0.45em;
        border-radius: 4px;
        color: var(--rc-ink);
      }

      /* ─────────── DIFF BLOCK (the recurring unit) ─────────── */
      .diff {
        font-family: var(--rc-font-mono);
        font-size: clamp(11.5px, 1.05vw, 13.5px);
        line-height: 1.7;
        background: var(--rc-paper-warm);
        border: 1px solid var(--rc-hairline-paper);
        border-radius: var(--rc-radius-md);
        margin: 0 0 36px;
        overflow-x: auto;
        padding: 16px 0;
        white-space: pre;
        color: var(--rc-charcoal);
      }
      .diff > * { display: block; }
      .diff-meta {
        padding: 1px clamp(14px, 2vw, 22px);
        color: var(--rc-charcoal-dim);
        opacity: 0.82;
      }
      .diff-meta-dim { opacity: 0.5; }
      .diff-meta-key { color: var(--rc-amber-dim); font-weight: 500; }
      .diff-meta-path { color: var(--rc-charcoal); }
      .diff-hunk {
        margin: 10px 0;
        padding: 4px clamp(14px, 2vw, 22px);
        color: var(--rc-charcoal-dim);
        background: rgba(14, 14, 16, 0.025);
        border-block: 1px solid var(--rc-hairline-paper);
        font-size: 0.92em;
        opacity: 0.85;
      }
      .diff-line {
        display: grid;
        grid-template-columns: 38px 22px 1fr;
        align-items: baseline;
        padding: 0 clamp(8px, 1.6vw, 18px);
        column-gap: 0;
      }
      .diff-line .num {
        color: var(--rc-line-num);
        font-size: 0.86em;
        text-align: right;
        padding-right: 12px;
        user-select: none;
      }
      .diff-line .sign { font-weight: 600; text-align: center; }
      .diff-line .content { padding-left: 8px; }
      .diff-line .content strong {
        font-weight: 600;
        color: var(--rc-ink);
      }
      .diff-context { background: transparent; }
      .diff-plus    { background: rgba(201, 245, 100, 0.18); }
      .diff-plus .sign  { color: var(--rc-phosphor-dim); }
      .diff-minus   { background: rgba(255, 140, 66, 0.10); }
      .diff-minus .sign { color: var(--rc-amber-dim); }
      .diff-minus .content { color: var(--rc-charcoal-dim); }

      /* Hero diff: line reveal cascade */
      .diff-hero .diff-line {
        opacity: 0;
        transform: translateX(-4px);
        animation: line-reveal 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
        animation-delay: calc(var(--i) * 0.09s + 0.35s);
      }
      @keyframes line-reveal {
        to { opacity: 1; transform: translateX(0); }
      }

      .cover-cta {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        margin-top: 8px;
        animation: word-rise 0.6s cubic-bezier(0.2,0.7,0.2,1) 1.1s both;
      }
      .cta {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 14px 22px;
        font-family: var(--rc-font-mono);
        font-size: 13px;
        letter-spacing: 0.01em;
        border: 1px solid transparent;
        transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
        border-radius: var(--rc-radius-sm);
        white-space: nowrap;
      }
      .cta:hover { transform: translateY(-1px); }
      .cta-arrow { transition: transform 0.18s ease; }
      .cta:hover .cta-arrow { transform: translate(2px, -1px); }
      .cta-primary {
        background: var(--rc-phosphor);
        color: var(--rc-ink);
        border-color: var(--rc-phosphor);
      }
      .cta-primary:hover { background: #d4f878; }
      .cta-ghost {
        background: transparent;
        color: var(--rc-ink);
        border-color: var(--rc-rule-paper);
      }
      .cta-ghost:hover { background: rgba(14,14,16,0.04); border-color: var(--rc-ink); }
      .cta-ghost-dark { color: var(--rc-bone); border-color: rgba(232,226,208,0.25); }
      .cta-ghost-dark:hover { background: rgba(232,226,208,0.06); border-color: var(--rc-bone); }
      .cta-dark { background: var(--rc-phosphor); color: var(--rc-ink); }
      .cta-cursor {
        width: 8px; height: 14px;
        background: currentColor;
        opacity: 0.85;
        animation: blink 1.1s steps(2) infinite;
      }
      @keyframes blink { 50% { opacity: 0; } }

      /* ═══════════════════════════════════════════════════════════
         HUNKS (the recurring section)
         ═══════════════════════════════════════════════════════════ */
      .hunk {
        padding: clamp(56px, 8vw, 110px) var(--gutter);
        max-width: var(--max);
        margin: 0 auto;
        position: relative;
      }
      .hunk + .hunk { border-top: 1px solid var(--rc-hairline-paper); }

      .hunk-marker {
        font-family: var(--rc-font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--rc-charcoal);
        opacity: 0.55;
        margin-bottom: 32px;
        padding: 6px 12px;
        background: rgba(14, 14, 16, 0.04);
        border-radius: var(--rc-radius-sm);
        display: inline-block;
      }
      .hunk-h {
        font-family: var(--rc-font-display);
        font-weight: 400;
        font-size: clamp(30px, 4.6vw, 60px);
        line-height: 1.04;
        letter-spacing: -0.025em;
        color: var(--rc-ink);
        margin: 0 0 24px;
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
        max-width: 22ch;
        text-wrap: balance;
      }
      .hunk-h-center { text-align: center; margin-inline: auto; }
      .hunk-h em {
        font-style: italic;
        font-weight: 380;
        color: var(--rc-amber-dim);
        font-variation-settings: 'SOFT' 100, 'WONK' 1;
      }
      .hunk-lede {
        font-size: 17px;
        line-height: 1.55;
        color: var(--rc-charcoal);
        max-width: 56ch;
        margin: 0 auto 36px;
        text-align: center;
      }

      /* ─── HUNK 1 (split card) ─── */
      .hunk-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 36px;
        align-items: start;
      }
      @media (min-width: 900px) {
        .hunk-grid { grid-template-columns: 1.05fr 1fr; gap: 64px; }
      }
      .hunk-prose p {
        font-size: 17px;
        line-height: 1.6;
        color: var(--rc-charcoal);
        margin: 0;
      }
      .hunk-prose p strong { color: var(--rc-ink); font-weight: 600; }

      .splitcard {
        display: grid;
        grid-template-columns: 1fr;
        border: 1px solid var(--rc-hairline-paper);
        border-radius: var(--rc-radius-md);
        overflow: hidden;
      }
      @media (min-width: 600px) {
        .splitcard { grid-template-columns: 1fr 1fr; }
      }
      .splitcard-side {
        padding: 22px 24px 26px;
      }
      .splitcard-local  { background: var(--rc-paper-warm); }
      .splitcard-remote {
        background: var(--rc-ink);
        color: var(--rc-bone);
        border-top: 1px solid var(--rc-hairline-ink);
      }
      @media (min-width: 600px) {
        .splitcard-remote { border-top: none; border-left: 1px solid var(--rc-hairline-ink); }
      }
      .splitcard-head {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--rc-charcoal);
        margin-bottom: 16px;
      }
      .splitcard-head-dark { color: var(--rc-bone-dim); }
      .splitcard-dot {
        width: 6px; height: 6px;
        border-radius: 50%;
      }
      .splitcard-dot-amber    { background: var(--rc-amber); }
      .splitcard-dot-phosphor { background: var(--rc-phosphor); box-shadow: 0 0 6px rgba(201,245,100,0.55); }
      .splitcard-host {
        font-family: var(--rc-font-mono);
        font-size: 10.5px;
        margin-left: auto;
        opacity: 0.55;
        text-transform: none;
        letter-spacing: 0;
      }
      .splitcard-label { letter-spacing: 0.12em; }
      .splitcard-list {
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 14.5px;
        line-height: 1.5;
      }
      .splitcard-list li {
        padding: 6px 0;
        border-bottom: 1px dashed var(--rc-hairline-paper);
      }
      .splitcard-list li:last-child { border-bottom: none; }
      .splitcard-list-dark li { border-bottom-color: var(--rc-hairline-ink); }
      .splitcard-list code {
        font-family: var(--rc-font-mono);
        font-size: 0.88em;
        background: rgba(201,245,100,0.22);
        padding: 1px 4px;
        border-radius: 3px;
        color: var(--rc-ink);
      }
      .splitcard-list-dark code {
        background: rgba(201,245,100,0.15);
        color: var(--rc-phosphor);
      }

      /* ─── HUNK 3 (lifecycle) ─── */
      .lifecycle {
        list-style: none;
        margin: 36px 0 0;
        padding: 0;
        display: grid;
        gap: 0;
        max-width: 720px;
      }
      .lifecycle-step {
        display: grid;
        grid-template-columns: 56px 1fr;
        gap: 24px;
        padding: 22px 0;
        border-bottom: 1px solid var(--rc-hairline-paper);
        position: relative;
      }
      .lifecycle-step:last-child { border-bottom: none; }
      .lifecycle-no {
        font-family: var(--rc-font-mono);
        font-size: 13px;
        color: var(--rc-amber-dim);
        letter-spacing: 0.06em;
        padding-top: 4px;
      }
      .lifecycle-h {
        font-family: var(--rc-font-display);
        font-weight: 500;
        font-size: 22px;
        line-height: 1.2;
        letter-spacing: -0.015em;
        color: var(--rc-ink);
        margin: 0 0 6px;
      }
      .lifecycle-body p {
        font-size: 15.5px;
        line-height: 1.55;
        color: var(--rc-charcoal);
        margin: 0;
      }
      .lifecycle-h code,
      .lifecycle-body p code {
        font-family: var(--rc-font-mono);
        font-size: 0.86em;
        background: rgba(201, 245, 100, 0.20);
        padding: 1px 5px;
        border-radius: 3px;
        color: var(--rc-ink);
      }

      /* ─── HUNK 4 (changelog) ─── */
      .changelog {
        display: grid;
        grid-template-columns: 1fr;
        gap: 28px;
        margin-top: 36px;
      }
      @media (min-width: 760px) {
        .changelog { grid-template-columns: 1fr 1fr; gap: 1px; background: var(--rc-hairline-paper); border: 1px solid var(--rc-hairline-paper); border-radius: var(--rc-radius-md); overflow: hidden; }
      }
      .changelog-col {
        background: var(--rc-paper);
        padding: 30px 28px;
      }
      .changelog-removed { background: rgba(255, 140, 66, 0.05); }
      .changelog-added   { background: rgba(201, 245, 100, 0.07); }
      .changelog-head {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 16px;
      }
      .changelog-removed .changelog-head { color: var(--rc-amber-dim); }
      .changelog-added   .changelog-head { color: var(--rc-phosphor-dim); }
      .changelog-sign {
        font-size: 18px;
        line-height: 1;
        font-weight: 700;
      }
      .changelog-col ul {
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 15.5px;
        line-height: 1.55;
      }
      .changelog-col li {
        padding: 8px 0;
        position: relative;
        padding-left: 22px;
        border-bottom: 1px dashed var(--rc-hairline-paper);
      }
      .changelog-col li:last-child { border-bottom: none; }
      .changelog-col li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 18px;
        width: 12px;
        height: 1px;
        background: currentColor;
        opacity: 0.4;
      }
      .changelog-removed li { color: var(--rc-charcoal-dim); }
      .changelog-added   li { color: var(--rc-charcoal); }
      .changelog-added   li::before { background: var(--rc-phosphor-dim); opacity: 0.7; }
      .changelog-removed li::before { background: var(--rc-amber-dim); opacity: 0.7; }

      .changelog-stat {
        font-family: var(--rc-font-mono);
        font-size: 12px;
        letter-spacing: 0.04em;
        color: var(--rc-charcoal);
        opacity: 0.78;
        margin: 28px 0 0;
        text-align: center;
      }
      .changelog-plus  { color: var(--rc-phosphor-dim); }
      .changelog-minus { color: var(--rc-amber-dim); }

      /* ═══════════════════════════════════════════════════════════
         APPLY (final CTA on ink)
         ═══════════════════════════════════════════════════════════ */
      .apply {
        background: var(--rc-ink);
        color: var(--rc-bone);
        padding: clamp(72px, 11vw, 140px) var(--gutter);
        text-align: center;
        position: relative;
        overflow: hidden;
      }
      .apply::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
          radial-gradient(50% 80% at 70% 30%, rgba(201,245,100,0.06) 0%, transparent 70%),
          radial-gradient(40% 60% at 20% 80%, rgba(255,140,66,0.04) 0%, transparent 70%);
        pointer-events: none;
      }
      .apply-meta {
        position: relative;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--rc-bone-dim);
        margin-bottom: 32px;
      }
      .apply-meta .patch-key { color: var(--rc-phosphor); opacity: 1; }
      .apply-meta .patch-val { color: var(--rc-bone); }
      .apply-h {
        position: relative;
        font-family: var(--rc-font-display);
        font-weight: 400;
        font-size: clamp(48px, 9vw, 124px);
        line-height: 1.0;
        letter-spacing: -0.035em;
        color: var(--rc-bone);
        margin: 0 0 24px;
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
      }
      .apply-h em {
        font-style: italic;
        font-weight: 380;
        font-variation-settings: 'SOFT' 100, 'WONK' 1;
        color: var(--rc-phosphor);
      }
      .apply-lede {
        position: relative;
        font-size: 17px;
        line-height: 1.55;
        color: var(--rc-bone-dim);
        max-width: 56ch;
        margin: 0 auto 40px;
      }
      .apply-cta {
        position: relative;
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        justify-content: center;
      }

      /* ═══════════════════════════════════════════════════════════
         FOOTER
         ═══════════════════════════════════════════════════════════ */
      .foot {
        background: var(--rc-ink);
        color: var(--rc-bone);
        padding: 56px var(--gutter) 32px;
        border-top: 1px solid var(--rc-hairline-ink);
      }
      .foot-grid {
        max-width: var(--max);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.2fr 2fr;
        gap: 56px;
        padding-bottom: 36px;
        border-bottom: 1px solid var(--rc-hairline-ink);
      }
      .wordmark-dark { color: var(--rc-bone); }
      .foot-blurb {
        margin: 14px 0 0;
        max-width: 36ch;
        font-size: 14px;
        line-height: 1.55;
        color: var(--rc-bone-dim);
      }
      .foot-nav {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 36px;
      }
      .foot-nav h4 {
        font-family: var(--rc-font-mono);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--rc-bone-dim);
        margin: 0 0 16px;
      }
      .foot-nav a {
        display: block;
        font-size: 14px;
        line-height: 1.95;
        color: rgba(232, 226, 208, 0.85);
        transition: color 0.15s;
      }
      .foot-nav a:hover { color: var(--rc-phosphor); }
      .foot-bottom {
        max-width: var(--max);
        margin: 0 auto;
        padding-top: 24px;
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        color: rgba(232, 226, 208, 0.4);
      }
      .foot-tag {
        letter-spacing: 0.06em;
        color: var(--rc-phosphor);
        opacity: 0.7;
      }

      /* ═══════════════════════════════════════════════════════════
         REDUCED MOTION
         ═══════════════════════════════════════════════════════════ */
      @media (prefers-reduced-motion: reduce) {
        .cover-h-w, .cover-cta, .diff-hero .diff-line {
          animation: none; opacity: 1; transform: none;
        }
        .kicker-dot, .cta-cursor { animation: none; }
      }

      /* ═══════════════════════════════════════════════════════════
         RESPONSIVE
         ═══════════════════════════════════════════════════════════ */
      @media (max-width: 900px) {
        .topbar { grid-template-columns: 1fr auto; gap: 12px; padding: 16px var(--gutter); }
        .topnav { display: none; }
        .patch-meta { font-size: 10px; }

        .cover { padding-top: 36px; padding-bottom: 60px; }
        .cover::before, .cover::after { display: none; }
        .patch-email { font-size: 11px; }
        .patch-key { min-width: 64px; }
        .cover-cta { flex-direction: column; align-items: stretch; }
        .cover-cta .cta { justify-content: center; }

        .hunk { padding-block: 56px; }
        .hunk-h { font-size: clamp(28px, 7.5vw, 40px); }
        .hunk-h-center { text-align: left; margin: 0 0 24px; }
        .hunk-lede { text-align: left; margin-inline: 0; }

        .lifecycle-step { grid-template-columns: 38px 1fr; gap: 16px; padding-block: 18px; }
        .lifecycle-h { font-size: 18px; }

        .changelog-stat { text-align: left; }

        .apply-h { font-size: clamp(40px, 12vw, 64px); }
        .apply-cta { flex-direction: column; align-items: stretch; }
        .apply-cta .cta { justify-content: center; }

        .foot-grid { grid-template-columns: 1fr; gap: 36px; }
        .foot-nav { grid-template-columns: repeat(3, 1fr); gap: 20px; }
        .foot-bottom { font-size: 10px; flex-direction: column; align-items: flex-start; gap: 8px; }
      }
      @media (max-width: 540px) {
        .foot-nav { grid-template-columns: 1fr 1fr; }
      }
    </style>
  </body>
</html>
