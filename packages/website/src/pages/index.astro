---
import '../styles/custom.css';

const repo = 'https://github.com/rebink/patchwire';
const version = '0.1.0';
const rev = '263e2e3';
---

<!doctype html>
<html lang="en" class="rc-brand rc-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0E0E10" />
    <title>Patchwire — local stays local, AI stays remote</title>
    <meta
      name="description"
      content="Push your project to a remote Mac. Run an AI CLI there. Pull back a unified diff. Apply only what you want."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Patchwire" />
    <meta
      property="og:description"
      content="Local-first development. AI executes remotely. Diffs come back for review."
    />
  </head>
  <body class="page">
    <!-- ───────── TOP BAR ───────── -->
    <header class="topbar">
      <a class="wordmark" href="/" aria-label="Patchwire home">
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
          <rect x="0.5" y="0.5" width="9" height="9" stroke="currentColor" fill="none"/>
          <rect x="12.5" y="12.5" width="9" height="9" fill="currentColor"/>
          <line x1="6" y1="11" x2="16" y2="11" stroke="currentColor" stroke-dasharray="1 2"/>
        </svg>
        <span>Patchwire</span>
      </a>
      <nav class="topnav" aria-label="Primary">
        <a href="/quickstart/">Quickstart</a>
        <a href="/architecture/">Architecture</a>
        <a href="/commands/">CLI</a>
        <a href="/install-extension/">Extension</a>
        <a href={repo} class="topnav-ext">GitHub ↗</a>
      </nav>
      <span class="meta-pill">
        <span class="meta-dot"></span>
        v{version}
      </span>
    </header>

    <!-- ───────── HERO ───────── -->
    <section class="hero" id="hero">
      <!-- background atmospherics -->
      <div class="hero-bg" aria-hidden="true">
        <div class="hero-grid-bg"></div>
        <div class="hero-spotlight" id="spotlight"></div>
        <div class="hero-glow hero-glow-phos"></div>
        <div class="hero-glow hero-glow-amber"></div>
      </div>

      <div class="hero-inner">
        <div class="hero-eyebrow reveal">
          <span class="eyebrow-tag">0.1.0 / 2026</span>
          <span class="eyebrow-sep">·</span>
          <span class="eyebrow-rev">rev {rev}</span>
          <span class="eyebrow-sep">·</span>
          <span class="eyebrow-status"><span class="eyebrow-pulse"></span>shipping</span>
        </div>

        <h1 class="hero-h reveal">
          <span class="hero-h-line">We&nbsp;pulled</span>
          <span class="hero-h-line">AI off your</span>
          <span class="hero-h-line"><em>laptop.</em></span>
        </h1>

        <p class="hero-sub reveal">
          Push your code to the heavier Mac. The AI runs there with the
          whole repo. You get back a unified diff. Nothing else crosses the wire.
        </p>

        <!-- ── The animated terminal centerpiece ── -->
        <div class="term reveal" id="term">
          <header class="term-bar">
            <span class="term-dots" aria-hidden="true">
              <span></span><span></span><span></span>
            </span>
            <span class="term-path">~/projects/your-app</span>
            <span class="term-host">macbook · zsh</span>
          </header>
          <div class="term-body" aria-live="polite">
            <div class="term-line" data-typewrite='$ patchwire ask "refactor login_bloc to freezed"' data-after="800"></div>
            <div class="term-line term-line-step" data-step="rsync" data-step-detail="14 files · 84 ms"           data-after="700"></div>
            <div class="term-line term-line-step" data-step="POST"  data-step-detail="/ask · 187 bytes"           data-after="900"></div>
            <div class="term-line term-line-step" data-step="spawn" data-step-detail="claude --print · 4.7 s"     data-after="1400"></div>
            <div class="term-line term-line-step" data-step="diff"  data-step-detail="captured · 31 lines · 6 files" data-after="700"></div>
            <div class="term-spacer"></div>
            <div class="term-diff" id="termDiff">
              <div class="diff-rail">@@ <span class="rail-path">lib/auth/login_bloc.dart</span></div>
              <div class="diff-row diff-minus"><span class="num">142</span><span class="sign">−</span><span class="content">  return BlocBase.fromJson(json);</span></div>
              <div class="diff-row diff-plus" ><span class="num">142</span><span class="sign">+</span><span class="content">  return Freezed.fromJson(json);</span></div>
              <div class="diff-row diff-context"><span class="num">143</span><span class="sign">&nbsp;</span><span class="content">{`}`}</span></div>
              <div class="diff-row diff-minus"><span class="num">147</span><span class="sign">−</span><span class="content">class LoginBloc extends BlocBase {`{`}</span></div>
              <div class="diff-row diff-plus" ><span class="num">147</span><span class="sign">+</span><span class="content">@freezed</span></div>
              <div class="diff-row diff-plus" ><span class="num">148</span><span class="sign">+</span><span class="content">class LoginState with _$LoginState {`{`}</span></div>
            </div>
            <div class="term-actions" id="termActions">
              <button class="term-btn term-btn-primary" type="button">git apply <span class="term-btn-kbd">↵</span></button>
              <button class="term-btn" type="button">preview <span class="term-btn-kbd">p</span></button>
              <button class="term-btn term-btn-ghost" type="button">tweak <span class="term-btn-kbd">t</span></button>
            </div>
          </div>
        </div>

        <div class="hero-cta reveal">
          <a href="/quickstart/" class="cta cta-primary magnet">
            <span>Try Patchwire</span>
            <span class="cta-arrow">→</span>
          </a>
          <a href={repo} class="cta cta-ghost magnet">
            <span>View on GitHub</span>
            <span class="cta-arrow">↗</span>
          </a>
        </div>

        <div class="hero-byline reveal" aria-hidden="true">
          <span>↓ scroll</span>
          <span class="byline-line"></span>
          <span>3 minutes to install</span>
        </div>
      </div>
    </section>

    <!-- ───────── SECTION: THE BIG CLAIM ───────── -->
    <section class="claim">
      <span class="kicker reveal"><span class="kicker-bar"></span>01 · the stance</span>
      <h2 class="claim-h reveal">
        Your laptop&nbsp;was <em>never</em> meant to&nbsp;host the AI.
      </h2>
      <p class="claim-sub reveal">
        Code-server is laggy. In-editor AI is forgetful. Mounted FS is a coin flip.
        Patchwire picks a different cut: <strong>local stays local,
        AI stays remote, only diffs cross the wire.</strong>
      </p>

      <div class="parallel reveal">
        <article class="par-card par-old">
          <header class="par-head">
            <span class="par-dot par-dot-amber"></span>
            <span class="par-label">THE OLD WAY</span>
          </header>
          <ul>
            <li>AI edits files in your editor</li>
            <li>You hope it didn't break anything</li>
            <li>You git-reset half the time</li>
            <li>Locked to one provider's tools</li>
          </ul>
        </article>
        <article class="par-card par-new">
          <header class="par-head">
            <span class="par-dot par-dot-phos"></span>
            <span class="par-label">PATCHWIRE</span>
          </header>
          <ul>
            <li>AI edits a clean checkout on the remote</li>
            <li>You read the diff before it lands</li>
            <li>git apply selectively, or never</li>
            <li>Any CLI: Claude, Codex, aider, custom</li>
          </ul>
        </article>
      </div>
    </section>

    <!-- ───────── SECTION: HOW IT WORKS ───────── -->
    <section class="flow">
      <span class="kicker reveal"><span class="kicker-bar"></span>02 · the flow</span>
      <h2 class="flow-h reveal">
        One HTTP call. <em>End-to-end.</em>
      </h2>

      <div class="flowdiagram reveal" aria-hidden="true">
        <div class="flowbox flowbox-laptop">
          <span class="flowbox-icon">⌘</span>
          <span class="flowbox-title">Laptop</span>
          <span class="flowbox-sub">patchwire CLI</span>
        </div>
        <div class="flowwire">
          <svg viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true">
            <line x1="0" y1="30" x2="400" y2="30" stroke="rgba(232,226,208,0.18)" stroke-width="1" stroke-dasharray="2 4"/>
          </svg>
          <span class="flowparticle"></span>
          <span class="flowlabel">rsync · HTTP · diff back</span>
        </div>
        <div class="flowbox flowbox-mac">
          <span class="flowbox-icon">▣</span>
          <span class="flowbox-title">Mac Mini</span>
          <span class="flowbox-sub">patchwire-agent</span>
        </div>
      </div>

      <ol class="steps">
        <li class="step reveal">
          <span class="step-no">01</span>
          <div class="step-body">
            <h3>Push code over rsync.</h3>
            <p>One-way. Your laptop is the source of truth. The remote always mirrors local — never the other direction.</p>
          </div>
        </li>
        <li class="step reveal">
          <span class="step-no">02</span>
          <div class="step-body">
            <h3>HTTP <code>/ask</code> with bearer token.</h3>
            <p>The agent verifies the project is a clean git tree, then spawns the configured AI CLI with the prompt on stdin.</p>
          </div>
        </li>
        <li class="step reveal">
          <span class="step-no">03</span>
          <div class="step-body">
            <h3>AI edits files. Agent captures <code>git diff</code>.</h3>
            <p>The AI edits a clean checkout natively. The agent derives the diff from git, then resets the tree. Robust, no prompt fragility.</p>
          </div>
        </li>
        <li class="step reveal">
          <span class="step-no">04</span>
          <div class="step-body">
            <h3>Diff returns. <em>You</em> decide.</h3>
            <p>Colorized preview. <code>git apply</code> selectively. Nothing lands without your hand on it.</p>
          </div>
        </li>
      </ol>
    </section>

    <!-- ───────── SECTION: SETUP ───────── -->
    <section class="setup">
      <span class="kicker reveal"><span class="kicker-bar"></span>03 · setup</span>
      <h2 class="setup-h reveal">
        Three commands per side. <em>Forever.</em>
      </h2>

      <div class="setup-grid">
        <article class="termcard reveal" data-tilt>
          <header class="termcard-bar">
            <span class="term-dots"><span></span><span></span><span></span></span>
            <span class="termcard-host">on the Mac Mini</span>
          </header>
          <pre class="termcard-body"><span class="t-com"># once</span>
$ pnpm add -g <span class="t-str">github:rebink/patchwire</span>
$ patchwire-agent install
  <span class="t-ok">→ TOKEN: pw_b9f...</span>
  <span class="t-ok">→ launchd: com.patchwire.agent</span></pre>
        </article>
        <article class="termcard termcard-laptop reveal" data-tilt>
          <header class="termcard-bar">
            <span class="term-dots"><span></span><span></span><span></span></span>
            <span class="termcard-host">on your laptop</span>
          </header>
          <pre class="termcard-body"><span class="t-com"># once</span>
$ pnpm add -g <span class="t-str">github:rebink/patchwire</span>
$ patchwire setup
  <span class="t-ok">→ Tailscale peer: mac-mini.tail-xyz.ts.net</span>

<span class="t-com"># forever</span>
$ patchwire ask <span class="t-str">"refactor login_bloc to freezed"</span></pre>
        </article>
      </div>
    </section>

    <!-- ───────── SECTION: FEATURES ───────── -->
    <section class="feats">
      <span class="kicker reveal"><span class="kicker-bar"></span>04 · the gains</span>
      <h2 class="feats-h reveal">
        Built different on&nbsp;purpose.
      </h2>

      <div class="featgrid">
        <article class="feat-card reveal feat-card-tall">
          <span class="feat-no">+</span>
          <h3>Full-repo context.</h3>
          <p>Claude (or Codex, or aider, or your shell script) runs on a clean checkout with the entire tree visible. No 8&#8209;k-token truncation, no "missing import" loops.</p>
          <div class="feat-glow" aria-hidden="true"></div>
        </article>
        <article class="feat-card reveal">
          <span class="feat-no">+</span>
          <h3>Reviewable diffs.</h3>
          <p><code>git diff</code> derived, never AI-imagined. Apply selectively.</p>
        </article>
        <article class="feat-card reveal">
          <span class="feat-no">+</span>
          <h3>AI-agnostic.</h3>
          <p>Any CLI that reads stdin and edits files. Swap providers in one line of YAML.</p>
        </article>
        <article class="feat-card reveal">
          <span class="feat-no">+</span>
          <h3>One-way sync.</h3>
          <p>rsync push. Your laptop's filesystem is the source of truth. The remote can't surprise you.</p>
        </article>
        <article class="feat-card reveal feat-card-quote">
          <p class="feat-q">
            "Your laptop should be quiet. <em>Your AI</em> should run somewhere bigger."
          </p>
          <p class="feat-q-meta">— patchwire@0.1.0</p>
        </article>
        <article class="feat-card reveal feat-card-strip">
          <ul class="strip">
            <li><strong>MIT</strong><span>open source</span></li>
            <li><strong>Tailscale</strong><span>recommended transport</span></li>
            <li><strong>Two bins</strong><span>cli + agent</span></li>
            <li><strong>YAML</strong><span>one file, one project</span></li>
          </ul>
        </article>
      </div>
    </section>

    <!-- ───────── SECTION: CTA ───────── -->
    <section class="endcta">
      <div class="endcta-inner">
        <span class="kicker reveal">↓ apply</span>
        <h2 class="endcta-h reveal">
          Three&nbsp;minutes.<br/>
          One YAML.<br/>
          <em>Diffs forever.</em>
        </h2>
        <div class="endcta-actions reveal">
          <a href="/quickstart/" class="cta cta-primary magnet cta-lg">
            <span>Read the Quickstart</span>
            <span class="cta-arrow">→</span>
          </a>
          <a href="/install-extension/" class="cta cta-ghost magnet cta-lg">
            <span>Install the VS Code extension</span>
            <span class="cta-arrow">↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ───────── FOOTER ───────── -->
    <footer class="foot">
      <div class="foot-grid">
        <div class="foot-mark">
          <span class="wordmark wordmark-dark">
            <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
              <rect x="0.5" y="0.5" width="9" height="9" stroke="currentColor" fill="none"/>
              <rect x="12.5" y="12.5" width="9" height="9" fill="currentColor"/>
              <line x1="6" y1="11" x2="16" y2="11" stroke="currentColor" stroke-dasharray="1 2"/>
            </svg>
            <span>Patchwire</span>
          </span>
          <p class="foot-blurb">
            Built with restraint. MIT licensed. By people who like their laptops quiet.
          </p>
        </div>
        <nav class="foot-nav" aria-label="Footer">
          <div>
            <h4>Docs</h4>
            <a href="/quickstart/">Quickstart</a>
            <a href="/architecture/">Architecture</a>
            <a href="/configuration/">Configuration</a>
            <a href="/security/">Security model</a>
          </div>
          <div>
            <h4>Reference</h4>
            <a href="/commands/">CLI commands</a>
            <a href="/api/">HTTP API</a>
            <a href="/troubleshooting/">Troubleshooting</a>
            <a href="/faq/">FAQ</a>
          </div>
          <div>
            <h4>Project</h4>
            <a href={repo}>GitHub ↗</a>
            <a href={`${repo}/issues`}>Issues ↗</a>
            <a href={`${repo}/blob/main/LICENSE`}>License ↗</a>
            <a href="/roadmap/">Roadmap</a>
          </div>
        </nav>
      </div>
      <div class="foot-bottom">
        <span>© {new Date().getFullYear()} Patchwire · v{version} · rev&nbsp;{rev}</span>
        <span class="foot-tag">local-first · ai-remote · diff-reviewable</span>
      </div>
    </footer>

    <!-- ═══════════════════════════════════════════════════════════
         INTERACTIVE JS — built with safe DOM methods
         ═══════════════════════════════════════════════════════════ -->
    <script>
      // ─── 1. Cursor-tracking spotlight on hero ───
      (() => {
        const spot = document.getElementById('spotlight');
        const hero = document.getElementById('hero');
        if (!spot || !hero || matchMedia('(pointer: coarse)').matches) return;
        let raf = 0, tx = 50, ty = 30;
        function update(e) {
          const r = hero.getBoundingClientRect();
          tx = ((e.clientX - r.left) / r.width) * 100;
          ty = ((e.clientY - r.top) / r.height) * 100;
          if (!raf) raf = requestAnimationFrame(apply);
        }
        function apply() {
          spot.style.setProperty('--x', tx + '%');
          spot.style.setProperty('--y', ty + '%');
          raf = 0;
        }
        hero.addEventListener('pointermove', update);
        hero.addEventListener('pointerleave', () => {
          tx = 50; ty = 30; apply();
        });
      })();

      // ─── 2. Scroll reveal ───
      (() => {
        const els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
          els.forEach(e => e.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
        els.forEach(e => io.observe(e));
      })();

      // ─── 3. Magnetic CTA ───
      (() => {
        if (matchMedia('(pointer: coarse)').matches) return;
        document.querySelectorAll('.magnet').forEach(el => {
          let raf = 0, tx = 0, ty = 0;
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            tx = ((e.clientX - r.left) / r.width - 0.5) * 14;
            ty = ((e.clientY - r.top) / r.height - 0.5) * 10;
            if (!raf) raf = requestAnimationFrame(() => {
              el.style.transform = 'translate(' + tx + 'px, ' + ty + 'px)';
              raf = 0;
            });
          });
          el.addEventListener('pointerleave', () => { el.style.transform = ''; });
        });
      })();

      // ─── 4. Terminal typewriter (built with safe DOM methods) ───
      (() => {
        const term = document.getElementById('term');
        if (!term) return;
        const lines = term.querySelectorAll('.term-line');
        const diff = document.getElementById('termDiff');
        const actions = document.getElementById('termActions');
        let started = false;

        function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

        function makeEl(tag, cls, text) {
          const el = document.createElement(tag);
          if (cls) el.className = cls;
          if (text != null) el.textContent = text;
          return el;
        }

        async function typeLine(el) {
          const text = el.dataset.typewrite;
          if (!text) return 0;
          el.textContent = '';
          const caret = makeEl('span', 'caret');
          el.appendChild(caret);
          for (let i = 0; i < text.length; i++) {
            el.insertBefore(document.createTextNode(text[i]), caret);
            await sleep(text.length > 30 ? 18 : 28);
          }
          caret.remove();
          return parseInt(el.dataset.after || '500', 10);
        }

        function renderStep(el) {
          const step = el.dataset.step || '';
          const detail = el.dataset.stepDetail || '';
          el.textContent = '';
          el.appendChild(makeEl('span', 'step-arrow', '→'));
          el.appendChild(makeEl('span', 'step-key', step));
          el.appendChild(makeEl('span', 'step-dot'));
          el.appendChild(makeEl('span', 'step-detail', detail));
          el.appendChild(makeEl('span', 'step-ok', '✓'));
          el.classList.add('is-in');
          return parseInt(el.dataset.after || '600', 10);
        }

        async function play() {
          if (started) return;
          started = true;
          for (const line of lines) {
            let wait;
            if (line.classList.contains('term-line-step')) wait = renderStep(line);
            else wait = await typeLine(line);
            await sleep(wait);
          }
          diff.classList.add('is-in');
          await sleep(900);
          actions.classList.add('is-in');
        }

        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            for (const e of entries) {
              if (e.isIntersecting) { play(); io.disconnect(); break; }
            }
          }, { threshold: 0.2 });
          io.observe(term);
        } else {
          play();
        }
      })();

      // ─── 5. Tilt cards (lightweight 3D hover) ───
      (() => {
        if (matchMedia('(pointer: coarse)').matches) return;
        document.querySelectorAll('[data-tilt]').forEach(card => {
          let raf = 0, rx = 0, ry = 0;
          card.addEventListener('pointermove', (e) => {
            const r = card.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width - 0.5;
            const py = (e.clientY - r.top) / r.height - 0.5;
            ry = px * 8;
            rx = -py * 6;
            if (!raf) raf = requestAnimationFrame(() => {
              card.style.transform = 'perspective(900px) rotateX(' + rx + 'deg) rotateY(' + ry + 'deg) translateZ(2px)';
              raf = 0;
            });
          });
          card.addEventListener('pointerleave', () => { card.style.transform = ''; });
        });
      })();
    </script>

    <!-- ═══════════════════════════════════════════════════════════
         STYLES
         ═══════════════════════════════════════════════════════════ -->
    <style>
      /* ─── tokens / page ─── */
      :root {
        --gutter: clamp(20px, 4.5vw, 64px);
        --max: 1240px;
      }
      /* Win over custom.css's .rc-brand body cream bg with higher specificity */
      html.rc-brand body.page {
        background: var(--rc-ink);
        color: var(--rc-bone);
        font-family: var(--rc-font-body);
        font-feature-settings: 'ss01','ss02','cv11';
        -webkit-font-smoothing: antialiased;
        margin: 0;
      }
      html.rc-brand.rc-dark { background: var(--rc-ink); }
      .page ::selection { background: var(--rc-phosphor); color: var(--rc-ink); }

      /* ─── reveal animation ─── */
      .reveal {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
        will-change: opacity, transform;
      }
      .reveal.is-in { opacity: 1; transform: none; }

      /* ═══════════════════════════════════════════════════════════
         TOP BAR
         ═══════════════════════════════════════════════════════════ */
      .topbar {
        position: sticky;
        top: 0;
        z-index: 50;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 32px;
        padding: 18px var(--gutter);
        background: rgba(14, 14, 16, 0.72);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--rc-hairline-ink);
      }
      .wordmark {
        display: inline-flex; align-items: center; gap: 10px;
        font-family: var(--rc-font-display);
        font-weight: 500; font-size: 17px; letter-spacing: -0.01em;
        color: var(--rc-bone);
      }
      .topnav { display: flex; justify-content: center; gap: 28px; font-size: 14px; }
      .topnav a {
        color: var(--rc-bone);
        opacity: 0.72;
        position: relative;
        transition: opacity 0.2s ease;
      }
      .topnav a::after {
        content: '';
        position: absolute;
        bottom: -6px; left: 0; right: 100%;
        height: 1px;
        background: var(--rc-phosphor);
        transition: right 0.28s cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      .topnav a:hover { opacity: 1; }
      .topnav a:hover::after { right: 0; }

      .meta-pill {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 6px 12px;
        border-radius: 999px;
        background: rgba(232, 226, 208, 0.05);
        border: 1px solid var(--rc-hairline-ink);
        font-family: var(--rc-font-mono);
        font-size: 11px;
        color: var(--rc-bone-dim);
      }
      .meta-dot {
        width: 6px; height: 6px; border-radius: 50%;
        background: var(--rc-phosphor);
        box-shadow: 0 0 0 3px rgba(201, 245, 100, 0.18);
        animation: pulse 2.2s ease-in-out infinite;
      }
      @keyframes pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }

      /* ═══════════════════════════════════════════════════════════
         HERO
         ═══════════════════════════════════════════════════════════ */
      .hero {
        position: relative;
        overflow: hidden;
        padding: clamp(72px, 9vw, 132px) var(--gutter) clamp(72px, 9vw, 120px);
      }
      .hero-bg { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
      .hero-grid-bg {
        position: absolute; inset: 0;
        background:
          linear-gradient(rgba(232, 226, 208, 0.025) 1px, transparent 1px) 0 0 / 100% 80px,
          linear-gradient(90deg, rgba(232, 226, 208, 0.025) 1px, transparent 1px) 0 0 / 80px 100%;
        mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 0%, transparent 90%);
        -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 0%, transparent 90%);
      }
      .hero-spotlight {
        --x: 50%; --y: 30%;
        position: absolute; inset: 0;
        background: radial-gradient(
          480px circle at var(--x) var(--y),
          rgba(201, 245, 100, 0.06),
          transparent 50%
        );
        transition: background 0.18s linear;
      }
      .hero-glow {
        position: absolute;
        width: 520px; height: 520px;
        border-radius: 50%;
        filter: blur(140px);
        opacity: 0.14;
      }
      .hero-glow-phos { background: var(--rc-phosphor); top: -220px; right: -220px; }
      .hero-glow-amber { background: var(--rc-amber-dim); bottom: -240px; left: -260px; opacity: 0.10; }

      .hero-inner {
        position: relative;
        z-index: 1;
        max-width: var(--max);
        margin: 0 auto;
        display: grid;
        gap: clamp(28px, 3.5vw, 40px);
      }

      .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--rc-bone-dim);
        flex-wrap: wrap;
      }
      .eyebrow-tag {
        padding: 4px 10px;
        border: 1px solid var(--rc-hairline-ink);
        border-radius: 4px;
        color: var(--rc-phosphor);
        background: rgba(201, 245, 100, 0.06);
      }
      .eyebrow-sep { opacity: 0.4; }
      .eyebrow-status { display: inline-flex; align-items: center; gap: 6px; }
      .eyebrow-pulse {
        width: 6px; height: 6px;
        border-radius: 50%;
        background: var(--rc-phosphor);
        box-shadow: 0 0 0 3px rgba(201, 245, 100, 0.18);
        animation: pulse 2.2s ease-in-out infinite;
      }

      .hero-h {
        font-family: var(--rc-font-display);
        font-weight: 400;
        font-size: clamp(48px, 9.6vw, 148px);
        line-height: 0.92;
        letter-spacing: -0.04em;
        color: var(--rc-bone);
        margin: 0;
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
        max-width: 14ch;
      }
      .hero-h-line {
        display: block;
        opacity: 0;
        transform: translateY(0.4em);
        animation: hero-rise 0.85s cubic-bezier(0.16, 0.85, 0.3, 1) forwards;
      }
      .hero-h-line:nth-child(1) { animation-delay: 0.12s; }
      .hero-h-line:nth-child(2) { animation-delay: 0.24s; }
      .hero-h-line:nth-child(3) { animation-delay: 0.36s; }
      .hero-h em {
        font-style: italic;
        font-weight: 380;
        color: var(--rc-phosphor);
        font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
      }
      @keyframes hero-rise { to { opacity: 1; transform: none; } }

      .hero-sub {
        font-size: clamp(17px, 1.55vw, 22px);
        line-height: 1.5;
        color: var(--rc-bone-dim);
        margin: 0;
        max-width: 52ch;
      }

      /* ─── Terminal ─── */
      .term {
        background: #131318;
        border: 1px solid var(--rc-hairline-ink);
        border-radius: 12px;
        overflow: hidden;
        max-width: 880px;
        box-shadow:
          0 1px 0 rgba(232, 226, 208, 0.04) inset,
          0 30px 80px -30px rgba(0, 0, 0, 0.7),
          0 0 0 1px rgba(201, 245, 100, 0.04);
      }
      .term-bar {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 14px;
        padding: 10px 16px;
        background: #0F0F12;
        border-bottom: 1px solid var(--rc-hairline-ink);
        font-family: var(--rc-font-mono);
        font-size: 11.5px;
        color: var(--rc-bone-dim);
      }
      .term-dots { display: inline-flex; gap: 6px; }
      .term-dots span {
        width: 10px; height: 10px;
        border-radius: 50%;
        background: rgba(232, 226, 208, 0.16);
      }
      .term-dots span:nth-child(1) { background: #FF5F57; opacity: 0.85; }
      .term-dots span:nth-child(2) { background: #FEBC2E; opacity: 0.85; }
      .term-dots span:nth-child(3) { background: #28C840; opacity: 0.85; }
      .term-path { text-align: center; opacity: 0.7; }
      .term-host { font-size: 10.5px; opacity: 0.4; letter-spacing: 0.04em; text-transform: uppercase; }

      .term-body {
        padding: 22px 22px 24px;
        font-family: var(--rc-font-mono);
        font-size: clamp(12.5px, 1.05vw, 14px);
        line-height: 1.75;
        color: var(--rc-bone);
        position: relative;
        min-height: 360px;
      }
      .term-line { display: block; min-height: 1.75em; color: var(--rc-bone); }
      .term-line-step {
        opacity: 0;
        transform: translateY(4px);
        transition: opacity 0.3s ease, transform 0.3s ease;
        display: grid;
        grid-template-columns: 18px 80px 14px 1fr auto;
        align-items: center;
        gap: 8px;
      }
      .term-line-step.is-in { opacity: 1; transform: none; }
      .step-arrow { color: var(--rc-bone-dim); opacity: 0.55; }
      .step-key { color: var(--rc-phosphor); font-weight: 500; }
      .step-dot { width: 4px; height: 4px; background: var(--rc-bone-dim); border-radius: 50%; opacity: 0.35; }
      .step-detail { color: var(--rc-bone-dim); }
      .step-ok {
        color: var(--rc-phosphor);
        font-size: 1.1em;
        animation: pop-in 0.4s cubic-bezier(0.2, 1.4, 0.5, 1) both;
      }
      @keyframes pop-in { from { transform: scale(0.4); opacity: 0; } to { transform: scale(1); opacity: 1; } }

      .caret {
        display: inline-block;
        width: 7px; height: 1em;
        vertical-align: -2px;
        background: var(--rc-phosphor);
        margin-left: 1px;
        animation: blink 1.1s steps(2) infinite;
      }
      @keyframes blink { 50% { opacity: 0; } }
      .term-spacer { height: 12px; }
      .term-diff {
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid var(--rc-hairline-ink);
        opacity: 0;
        transition: opacity 0.6s ease;
      }
      .term-diff.is-in { opacity: 1; }
      .diff-rail {
        font-size: 10.5px;
        letter-spacing: 0.04em;
        color: var(--rc-bone-dim);
        opacity: 0.55;
        margin-bottom: 8px;
      }
      .rail-path { color: var(--rc-amber); opacity: 0.85; }
      .diff-row {
        display: grid;
        grid-template-columns: 38px 18px 1fr;
        align-items: baseline;
        gap: 6px;
        padding: 1px 6px;
        margin: 0 -6px;
        font-size: 12.5px;
      }
      .diff-row .num { color: rgba(232, 226, 208, 0.28); text-align: right; font-size: 10.5px; }
      .diff-row .sign { font-weight: 600; text-align: center; }
      .diff-context  { color: var(--rc-bone); opacity: 0.65; }
      .diff-plus     { background: rgba(201, 245, 100, 0.08); }
      .diff-plus .sign { color: var(--rc-phosphor); }
      .diff-minus    { background: rgba(255, 140, 66, 0.07); }
      .diff-minus .sign { color: var(--rc-amber); }
      .diff-minus .content { color: var(--rc-bone-dim); }

      .term-actions {
        display: flex;
        gap: 10px;
        margin-top: 18px;
        flex-wrap: wrap;
        opacity: 0;
        transform: translateY(8px);
        transition: opacity 0.6s ease, transform 0.6s ease;
      }
      .term-actions.is-in { opacity: 1; transform: none; }
      .term-btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 8px 14px;
        font-family: var(--rc-font-mono);
        font-size: 12px;
        color: var(--rc-bone);
        background: rgba(232, 226, 208, 0.04);
        border: 1px solid var(--rc-hairline-ink);
        border-radius: 5px;
        cursor: pointer;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
      }
      .term-btn:hover {
        background: rgba(232, 226, 208, 0.07);
        border-color: rgba(232, 226, 208, 0.32);
      }
      .term-btn-primary {
        background: var(--rc-phosphor);
        color: var(--rc-ink);
        border-color: var(--rc-phosphor);
      }
      .term-btn-primary:hover { background: #d4f878; }
      .term-btn-ghost { color: var(--rc-bone-dim); }
      .term-btn-kbd {
        font-size: 10.5px;
        padding: 1px 5px;
        background: rgba(14, 14, 16, 0.5);
        border-radius: 3px;
        color: inherit;
        opacity: 0.7;
      }
      .term-btn-primary .term-btn-kbd { background: rgba(14, 14, 16, 0.15); }

      /* ─── CTAs ───
         Selectors are intentionally bumped to .page .cta-* so they
         beat custom.css's `html.rc-brand a { color: inherit }` which
         would otherwise force the button text to inherit body's bone
         color (terrible contrast on phosphor). */
      .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 8px; }
      .page .cta {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 14px 22px;
        font-family: var(--rc-font-mono);
        font-weight: 500;
        font-size: 13px;
        letter-spacing: 0.01em;
        border: 1px solid transparent;
        border-radius: 6px;
        transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.25s ease;
        white-space: nowrap;
        will-change: transform;
        text-decoration: none;
      }
      .page .cta-arrow { transition: transform 0.2s ease; color: inherit; }
      .page .cta:hover .cta-arrow { transform: translate(2px, -1px); }
      .page .cta-primary {
        background: var(--rc-phosphor);
        color: var(--rc-ink);
        border-color: var(--rc-phosphor);
        box-shadow: 0 0 0 0 rgba(201, 245, 100, 0.5), 0 1px 0 rgba(255, 255, 255, 0.2) inset;
        font-weight: 600;
      }
      .page .cta-primary:hover {
        background: #d4f878;
        color: var(--rc-ink);
        box-shadow: 0 0 0 6px rgba(201, 245, 100, 0.18), 0 1px 0 rgba(255, 255, 255, 0.25) inset;
      }
      .page .cta-primary span { color: inherit; }
      .page .cta-ghost {
        background: rgba(232, 226, 208, 0.04);
        color: var(--rc-bone);
        border-color: rgba(232, 226, 208, 0.18);
      }
      .page .cta-ghost:hover {
        background: rgba(232, 226, 208, 0.08);
        color: var(--rc-bone);
        border-color: rgba(232, 226, 208, 0.42);
      }
      .page .cta-ghost span { color: inherit; }
      .page .cta-lg { padding: 18px 28px; font-size: 14px; }

      .hero-byline {
        display: inline-flex; align-items: center; gap: 14px;
        margin-top: 18px;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--rc-bone-dim);
        opacity: 0.7;
      }
      .byline-line { width: 60px; height: 1px; background: rgba(232, 226, 208, 0.2); }

      /* ═══════════════════════════════════════════════════════════
         SECTION : CLAIM
         ═══════════════════════════════════════════════════════════ */
      .kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--rc-bone-dim);
        margin-bottom: 28px;
      }
      .kicker-bar { width: 24px; height: 1px; background: var(--rc-phosphor); }

      .claim {
        padding: clamp(80px, 11vw, 140px) var(--gutter);
        max-width: var(--max);
        margin: 0 auto;
        border-top: 1px solid var(--rc-hairline-ink);
      }
      .claim-h {
        font-family: var(--rc-font-display);
        font-weight: 400;
        font-size: clamp(38px, 6.6vw, 92px);
        line-height: 1.04;
        letter-spacing: -0.03em;
        color: var(--rc-bone);
        margin: 0 0 28px;
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
        max-width: 22ch;
        text-wrap: balance;
      }
      .claim-h em {
        font-style: italic;
        font-weight: 380;
        color: var(--rc-amber);
        font-variation-settings: 'SOFT' 100, 'WONK' 1;
      }
      .claim-sub {
        font-size: 18px;
        line-height: 1.6;
        color: var(--rc-bone-dim);
        max-width: 60ch;
        margin: 0 0 48px;
      }
      .claim-sub strong { color: var(--rc-bone); font-weight: 600; }

      .parallel { display: grid; grid-template-columns: 1fr; gap: 22px; }
      @media (min-width: 760px) {
        .parallel { grid-template-columns: 1fr 1fr; gap: 28px; }
      }
      .par-card {
        background: rgba(232, 226, 208, 0.025);
        border: 1px solid var(--rc-hairline-ink);
        border-radius: 12px;
        padding: 28px;
        transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
      }
      .par-card:hover {
        background: rgba(232, 226, 208, 0.05);
        border-color: rgba(232, 226, 208, 0.18);
        transform: translateY(-2px);
      }
      .par-head {
        display: inline-flex; align-items: center; gap: 8px;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 20px;
      }
      .par-dot { width: 6px; height: 6px; border-radius: 50%; }
      .par-dot-amber { background: var(--rc-amber); }
      .par-dot-phos  { background: var(--rc-phosphor); box-shadow: 0 0 8px rgba(201, 245, 100, 0.55); }
      .par-old .par-label { color: var(--rc-amber); opacity: 0.85; }
      .par-new .par-label { color: var(--rc-phosphor); }
      .par-card ul { list-style: none; margin: 0; padding: 0; font-size: 15.5px; line-height: 1.5; }
      .par-card li { padding: 10px 0; border-bottom: 1px dashed var(--rc-hairline-ink); }
      .par-card li:last-child { border-bottom: none; }
      .par-old li {
        color: var(--rc-bone-dim);
        text-decoration: line-through;
        text-decoration-color: rgba(255, 140, 66, 0.55);
      }
      .par-new li { color: var(--rc-bone); }

      /* ═══════════════════════════════════════════════════════════
         SECTION : FLOW
         ═══════════════════════════════════════════════════════════ */
      .flow {
        padding: clamp(80px, 11vw, 140px) var(--gutter);
        max-width: var(--max);
        margin: 0 auto;
        border-top: 1px solid var(--rc-hairline-ink);
      }
      .flow-h {
        font-family: var(--rc-font-display);
        font-weight: 400;
        font-size: clamp(36px, 6vw, 84px);
        line-height: 1.04;
        letter-spacing: -0.03em;
        color: var(--rc-bone);
        margin: 0 0 56px;
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
      }
      .flow-h em {
        font-style: italic;
        font-weight: 380;
        color: var(--rc-phosphor);
        font-variation-settings: 'SOFT' 100, 'WONK' 1;
      }

      .flowdiagram {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 24px;
        padding: 28px 28px 36px;
        background: rgba(232, 226, 208, 0.025);
        border: 1px solid var(--rc-hairline-ink);
        border-radius: 12px;
        margin-bottom: 56px;
        position: relative;
        overflow: hidden;
      }
      .flowbox {
        display: grid; gap: 4px;
        text-align: center;
        padding: 14px 18px;
        min-width: 120px;
      }
      .flowbox-icon { font-family: var(--rc-font-mono); font-size: 22px; color: var(--rc-bone); opacity: 0.7; }
      .flowbox-title { font-family: var(--rc-font-display); font-size: 17px; font-weight: 500; color: var(--rc-bone); }
      .flowbox-sub {
        font-family: var(--rc-font-mono);
        font-size: 10.5px;
        color: var(--rc-bone-dim);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .flowbox-laptop .flowbox-icon { color: var(--rc-amber); }
      .flowbox-mac    .flowbox-icon { color: var(--rc-phosphor); }

      .flowwire {
        position: relative;
        height: 60px;
        display: flex; align-items: center; justify-content: center;
      }
      .flowwire svg { position: absolute; inset: 0; width: 100%; height: 100%; }
      .flowparticle {
        position: absolute;
        top: 50%; left: 0;
        transform: translate(0, -50%);
        width: 8px; height: 8px;
        border-radius: 50%;
        background: var(--rc-phosphor);
        box-shadow: 0 0 12px rgba(201, 245, 100, 0.75);
        animation: travel 3.4s cubic-bezier(0.6, 0, 0.4, 1) infinite;
      }
      @keyframes travel {
        0%   { left: 4%; opacity: 0; }
        15%  { opacity: 1; }
        85%  { opacity: 1; }
        100% { left: 96%; opacity: 0; }
      }
      .flowlabel {
        position: relative;
        z-index: 1;
        font-family: var(--rc-font-mono);
        font-size: 10.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--rc-bone-dim);
        background: rgba(14, 14, 16, 0.7);
        padding: 4px 10px;
        border-radius: 999px;
        border: 1px solid var(--rc-hairline-ink);
      }

      .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
      .step {
        display: grid;
        grid-template-columns: 64px 1fr;
        gap: 28px;
        padding: 28px 0;
        border-bottom: 1px solid var(--rc-hairline-ink);
      }
      .step:last-child { border-bottom: none; }
      .step-no {
        font-family: var(--rc-font-mono);
        font-size: 14px;
        color: var(--rc-phosphor);
        letter-spacing: 0.06em;
        padding-top: 4px;
      }
      .step-body h3 {
        font-family: var(--rc-font-display);
        font-weight: 500;
        font-size: clamp(20px, 2vw, 26px);
        line-height: 1.2;
        letter-spacing: -0.015em;
        color: var(--rc-bone);
        margin: 0 0 6px;
      }
      .step-body h3 em { font-style: italic; font-weight: 380; color: var(--rc-amber); }
      .step-body p { font-size: 16px; line-height: 1.55; color: var(--rc-bone-dim); margin: 0; }
      .step-body code {
        font-family: var(--rc-font-mono);
        font-size: 0.86em;
        background: rgba(201, 245, 100, 0.10);
        padding: 1px 5px;
        border-radius: 3px;
        color: var(--rc-phosphor);
      }

      /* ═══════════════════════════════════════════════════════════
         SECTION : SETUP
         ═══════════════════════════════════════════════════════════ */
      .setup {
        padding: clamp(80px, 11vw, 140px) var(--gutter);
        max-width: var(--max);
        margin: 0 auto;
        border-top: 1px solid var(--rc-hairline-ink);
      }
      .setup-h {
        font-family: var(--rc-font-display);
        font-weight: 400;
        font-size: clamp(36px, 6vw, 84px);
        line-height: 1.04;
        letter-spacing: -0.03em;
        color: var(--rc-bone);
        margin: 0 0 56px;
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
      }
      .setup-h em {
        font-style: italic;
        font-weight: 380;
        color: var(--rc-phosphor);
        font-variation-settings: 'SOFT' 100, 'WONK' 1;
      }
      .setup-grid { display: grid; grid-template-columns: 1fr; gap: 22px; }
      @media (min-width: 860px) { .setup-grid { grid-template-columns: 1fr 1fr; gap: 28px; } }
      .termcard {
        background: #131318;
        border: 1px solid var(--rc-hairline-ink);
        border-radius: 12px;
        overflow: hidden;
        transition: border-color 0.25s ease, background 0.25s ease;
        will-change: transform;
      }
      .termcard:hover {
        border-color: rgba(232, 226, 208, 0.2);
        background: #17171c;
      }
      .termcard-bar {
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: center;
        gap: 14px;
        padding: 10px 16px;
        background: #0F0F12;
        border-bottom: 1px solid var(--rc-hairline-ink);
      }
      .termcard-host {
        text-align: right;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        color: var(--rc-bone-dim);
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .termcard-body {
        padding: 22px 22px 26px;
        font-family: var(--rc-font-mono);
        font-size: clamp(12px, 1vw, 13.5px);
        line-height: 1.85;
        color: var(--rc-bone);
        margin: 0;
        white-space: pre-wrap;
        overflow-wrap: break-word;
      }
      .t-com { color: var(--rc-bone-dim); opacity: 0.55; }
      .t-str { color: var(--rc-amber); }
      .t-ok  { color: var(--rc-phosphor); }

      /* ═══════════════════════════════════════════════════════════
         SECTION : FEATURES
         ═══════════════════════════════════════════════════════════ */
      .feats {
        padding: clamp(80px, 11vw, 140px) var(--gutter);
        max-width: var(--max);
        margin: 0 auto;
        border-top: 1px solid var(--rc-hairline-ink);
      }
      .feats-h {
        font-family: var(--rc-font-display);
        font-weight: 400;
        font-size: clamp(36px, 6vw, 84px);
        line-height: 1.04;
        letter-spacing: -0.03em;
        color: var(--rc-bone);
        margin: 0 0 56px;
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
        max-width: 18ch;
      }

      .featgrid { display: grid; grid-template-columns: 1fr; gap: 16px; }
      @media (min-width: 760px) {
        .featgrid {
          grid-template-columns: 1.4fr 1fr 1fr;
          grid-template-rows: auto auto auto;
          gap: 18px;
        }
        .feat-card-tall { grid-column: span 1; grid-row: span 2; }
        .feat-card-quote { grid-column: span 2; }
        .feat-card-strip { grid-column: span 3; }
      }
      .feat-card {
        position: relative;
        background: rgba(232, 226, 208, 0.025);
        border: 1px solid var(--rc-hairline-ink);
        border-radius: 12px;
        padding: 28px;
        overflow: hidden;
        transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
      }
      .feat-card:hover {
        background: rgba(232, 226, 208, 0.05);
        border-color: rgba(232, 226, 208, 0.22);
        transform: translateY(-3px);
      }
      .feat-no {
        font-family: var(--rc-font-mono);
        font-size: 22px;
        color: var(--rc-phosphor);
        line-height: 1;
        margin-bottom: 22px;
        display: inline-block;
      }
      .feat-card h3 {
        font-family: var(--rc-font-display);
        font-weight: 500;
        font-size: 22px;
        line-height: 1.2;
        letter-spacing: -0.015em;
        color: var(--rc-bone);
        margin: 0 0 10px;
      }
      .feat-card p { font-size: 15px; line-height: 1.55; color: var(--rc-bone-dim); margin: 0; }
      .feat-card code {
        font-family: var(--rc-font-mono);
        font-size: 0.86em;
        background: rgba(201, 245, 100, 0.10);
        padding: 1px 5px;
        border-radius: 3px;
        color: var(--rc-phosphor);
      }
      .feat-glow {
        position: absolute;
        bottom: -120px; right: -100px;
        width: 280px; height: 280px;
        background: radial-gradient(circle, rgba(201, 245, 100, 0.16), transparent 70%);
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.4s ease;
      }
      .feat-card-tall:hover .feat-glow { opacity: 1; }

      .feat-card-quote {
        background: linear-gradient(135deg, rgba(201, 245, 100, 0.04), rgba(255, 140, 66, 0.04));
      }
      .feat-q {
        font-family: var(--rc-font-display);
        font-style: italic;
        font-weight: 380;
        font-size: clamp(18px, 1.8vw, 24px);
        line-height: 1.35;
        color: var(--rc-bone);
        margin: 0 0 14px;
        font-variation-settings: 'SOFT' 100, 'WONK' 1;
        text-wrap: balance;
      }
      .feat-q em { font-style: italic; color: var(--rc-phosphor); }
      .feat-q-meta {
        font-family: var(--rc-font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--rc-bone-dim);
        margin: 0;
      }

      .feat-card-strip { padding: 24px 28px; }
      .strip {
        list-style: none; margin: 0; padding: 0;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
      }
      @media (max-width: 760px) { .strip { grid-template-columns: 1fr 1fr; gap: 18px; } }
      .strip li {
        display: flex; flex-direction: column; gap: 2px;
        font-family: var(--rc-font-mono);
        font-size: 13px;
        border-left: 2px solid var(--rc-phosphor);
        padding-left: 14px;
      }
      .strip li strong { color: var(--rc-bone); font-weight: 500; }
      .strip li span { color: var(--rc-bone-dim); font-size: 11px; opacity: 0.7; }

      /* ═══════════════════════════════════════════════════════════
         SECTION : END CTA
         ═══════════════════════════════════════════════════════════ */
      .endcta {
        padding: clamp(96px, 14vw, 180px) var(--gutter);
        border-top: 1px solid var(--rc-hairline-ink);
        position: relative;
        overflow: hidden;
      }
      .endcta::before {
        content: '';
        position: absolute; inset: 0;
        background:
          radial-gradient(60% 80% at 70% 30%, rgba(201,245,100,0.10) 0%, transparent 70%),
          radial-gradient(40% 70% at 20% 80%, rgba(255,140,66,0.06) 0%, transparent 70%);
        pointer-events: none;
      }
      .endcta-inner { position: relative; max-width: var(--max); margin: 0 auto; text-align: center; }
      .endcta .kicker { color: var(--rc-phosphor); opacity: 0.85; }
      .endcta-h {
        font-family: var(--rc-font-display);
        font-weight: 400;
        font-size: clamp(44px, 8.5vw, 124px);
        line-height: 0.96;
        letter-spacing: -0.035em;
        color: var(--rc-bone);
        margin: 0 auto 44px;
        font-variation-settings: 'SOFT' 30, 'opsz' 144;
        max-width: 14ch;
      }
      .endcta-h em {
        font-style: italic;
        font-weight: 380;
        color: var(--rc-phosphor);
        font-variation-settings: 'SOFT' 100, 'WONK' 1;
      }
      .endcta-actions { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }

      /* ═══════════════════════════════════════════════════════════
         FOOTER
         ═══════════════════════════════════════════════════════════ */
      .foot {
        background: #0A0A0C;
        color: var(--rc-bone);
        padding: 56px var(--gutter) 32px;
        border-top: 1px solid var(--rc-hairline-ink);
      }
      .foot-grid {
        max-width: var(--max);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.2fr 2fr;
        gap: 56px;
        padding-bottom: 36px;
        border-bottom: 1px solid var(--rc-hairline-ink);
      }
      .wordmark-dark { color: var(--rc-bone); }
      .foot-blurb {
        margin: 14px 0 0;
        max-width: 36ch;
        font-size: 14px;
        line-height: 1.55;
        color: var(--rc-bone-dim);
      }
      .foot-nav { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; }
      .foot-nav h4 {
        font-family: var(--rc-font-mono);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--rc-bone-dim);
        margin: 0 0 16px;
      }
      .foot-nav a {
        display: block;
        font-size: 14px;
        line-height: 1.95;
        color: rgba(232, 226, 208, 0.85);
        transition: color 0.15s;
      }
      .foot-nav a:hover { color: var(--rc-phosphor); }
      .foot-bottom {
        max-width: var(--max);
        margin: 0 auto;
        padding-top: 24px;
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        font-family: var(--rc-font-mono);
        font-size: 11px;
        color: rgba(232, 226, 208, 0.4);
      }
      .foot-tag { letter-spacing: 0.06em; color: var(--rc-phosphor); opacity: 0.7; }

      /* ═══════════════════════════════════════════════════════════
         REDUCED MOTION
         ═══════════════════════════════════════════════════════════ */
      @media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1; transform: none; transition: none; }
        .hero-h-line, .meta-dot, .eyebrow-pulse,
        .flowparticle, .caret, .step-ok { animation: none; }
      }

      /* ═══════════════════════════════════════════════════════════
         RESPONSIVE
         ═══════════════════════════════════════════════════════════ */
      @media (max-width: 900px) {
        .topbar { grid-template-columns: auto auto; gap: 12px; padding: 14px var(--gutter); }
        .topnav { display: none; }
        .meta-pill { font-size: 10px; padding: 5px 10px; }

        .hero { padding-block: 56px; }
        .hero-h { font-size: clamp(40px, 11vw, 64px); line-height: 0.96; max-width: 100%; }
        .hero-sub { font-size: 16px; }
        .term { box-shadow: 0 12px 40px -20px rgba(0,0,0,0.7); }
        .term-body { padding: 16px 14px 20px; min-height: 320px; font-size: 11.5px; }
        .term-line-step { grid-template-columns: 14px 60px 8px 1fr auto; gap: 6px; }
        .step-detail { font-size: 0.95em; }

        .hero-cta { flex-direction: column; align-items: stretch; }
        .hero-cta .cta { justify-content: center; }

        .claim-h, .flow-h, .setup-h, .feats-h, .endcta-h {
          font-size: clamp(32px, 9vw, 48px);
        }

        .flowdiagram { grid-template-columns: 1fr; gap: 14px; padding: 22px; }
        .flowwire { height: 40px; }

        .step { grid-template-columns: 44px 1fr; gap: 16px; padding-block: 20px; }
        .step-body h3 { font-size: 18px; }

        .featgrid { grid-template-columns: 1fr; }
        .feat-card-tall, .feat-card-quote, .feat-card-strip { grid-column: auto; grid-row: auto; }

        .endcta-actions { flex-direction: column; align-items: stretch; }
        .endcta-actions .cta {
          justify-content: center;
          white-space: normal;
          text-align: center;
          line-height: 1.3;
        }
        .endcta-actions .cta span:first-child { flex: 1; }

        .foot-grid { grid-template-columns: 1fr; gap: 32px; }
        .foot-nav { grid-template-columns: repeat(3, 1fr); gap: 20px; }
        .foot-bottom { flex-direction: column; align-items: flex-start; gap: 8px; font-size: 10px; }
      }
      @media (max-width: 540px) {
        .foot-nav { grid-template-columns: 1fr 1fr; }
      }
    </style>
  </body>
</html>
