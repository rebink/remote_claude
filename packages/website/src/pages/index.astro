    <!-- ═══════════════════════════════════════════════════════════
         INTERACTIVE JS — built with safe DOM methods.
         data-astro-rerun: re-execute these IIFEs after every
         view-transition navigation back to this page, so the
         hero typewriter / spotlight / magnet / tilt / reveal
         observers re-initialise against the fresh DOM.
         ═══════════════════════════════════════════════════════════ -->
    <script is:inline>
      // Wrap every page-side IIFE in bindAll() so we can re-attach
      // observers and event listeners after Astro view transitions.
      // bindAll() runs once on initial paint, then again on every
      // `astro:page-load` (which fires both on first load and on
      // every SPA arrival to this route).
      function bindAll() {
      // Single source-of-truth for motion preference
      const prefersReducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ─── 1. Cursor-tracking spotlight on hero ───
      (() => {
        const spot = document.getElementById('spotlight');
        const hero = document.getElementById('hero');
        if (!spot || !hero || matchMedia('(pointer: coarse)').matches || prefersReducedMotion) return;
        let raf = 0, tx = 50, ty = 30;
        function update(e) {
          const r = hero.getBoundingClientRect();
          tx = ((e.clientX - r.left) / r.width) * 100;
          ty = ((e.clientY - r.top) / r.height) * 100;
          if (!raf) raf = requestAnimationFrame(apply);
        }
        function apply() {
          spot.style.setProperty('--x', tx + '%');
          spot.style.setProperty('--y', ty + '%');
          raf = 0;
        }
        hero.addEventListener('pointermove', update);
        hero.addEventListener('pointerleave', () => {
          tx = 50; ty = 30; apply();
        });
      })();

      // ─── 2. Scroll reveal ───
      (() => {
        const els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) {
          els.forEach(e => e.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
        els.forEach(e => io.observe(e));
      })();

      // ─── 3. Magnetic CTA ───
      (() => {
        if (matchMedia('(pointer: coarse)').matches || prefersReducedMotion) return;
        document.querySelectorAll('.magnet').forEach(el => {
          let raf = 0, tx = 0, ty = 0;
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            tx = ((e.clientX - r.left) / r.width - 0.5) * 14;
            ty = ((e.clientY - r.top) / r.height - 0.5) * 10;
            if (!raf) raf = requestAnimationFrame(() => {
              el.style.transform = 'translate(' + tx + 'px, ' + ty + 'px)';
              raf = 0;
            });
          });
          el.addEventListener('pointerleave', () => { el.style.transform = ''; });
        });
      })();

      // ─── 4. Terminal typewriter (built with safe DOM methods) ───
      (() => {
        const term = document.getElementById('term');
        if (!term) return;
        const lines = term.querySelectorAll('.term-line');
        const diff = document.getElementById('termDiff');
        const actions = document.getElementById('termActions');
        let started = false;

        function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

        function makeEl(tag, cls, text) {
          const el = document.createElement(tag);
          if (cls) el.className = cls;
          if (text != null) el.textContent = text;
          return el;
        }

        async function typeLine(el) {
          const text = el.dataset.typewrite;
          if (!text) return 0;
          el.textContent = '';
          if (prefersReducedMotion) {
            el.textContent = text;
            return 0;
          }
          const caret = makeEl('span', 'caret');
          el.appendChild(caret);
          for (let i = 0; i < text.length; i++) {
            el.insertBefore(document.createTextNode(text[i]), caret);
            await sleep(text.length > 30 ? 18 : 28);
          }
          caret.remove();
          return parseInt(el.dataset.after || '500', 10);
        }

        function renderStep(el) {
          const step = el.dataset.step || '';
          const detail = el.dataset.stepDetail || '';
          el.textContent = '';
          el.appendChild(makeEl('span', 'step-arrow', '→'));
          el.appendChild(makeEl('span', 'step-key', step));
          el.appendChild(makeEl('span', 'step-dot'));
          el.appendChild(makeEl('span', 'step-detail', detail));
          el.appendChild(makeEl('span', 'step-ok', '✓'));
          el.classList.add('is-in');
          return parseInt(el.dataset.after || '600', 10);
        }

        async function play() {
          if (started) return;
          started = true;
          for (const line of lines) {
            let wait;
            if (line.classList.contains('term-line-step')) wait = renderStep(line);
            else wait = await typeLine(line);
            await sleep(wait);
          }
          diff.classList.add('is-in');
          await sleep(900);
          actions.classList.add('is-in');
        }

        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            for (const e of entries) {
              if (e.isIntersecting) { play(); io.disconnect(); break; }
            }
          }, { threshold: 0.2 });
          io.observe(term);
        } else {
          play();
        }
      })();

      // ─── 5. Tilt cards (lightweight 3D hover) ───
      (() => {
        if (matchMedia('(pointer: coarse)').matches || prefersReducedMotion) return;
        document.querySelectorAll('[data-tilt]').forEach(card => {
          let raf = 0, rx = 0, ry = 0;
          card.addEventListener('pointermove', (e) => {
            const r = card.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width - 0.5;
            const py = (e.clientY - r.top) / r.height - 0.5;
            ry = px * 8;
            rx = -py * 6;
            if (!raf) raf = requestAnimationFrame(() => {
              card.style.transform = 'perspective(900px) rotateX(' + rx + 'deg) rotateY(' + ry + 'deg) translateZ(2px)';
              raf = 0;
            });
          });
          card.addEventListener('pointerleave', () => { card.style.transform = ''; });
        });
      })();
      } /* end bindAll() */

      // First paint
      bindAll();
      // Subsequent SPA arrivals via Astro view transitions
      document.addEventListener('astro:page-load', bindAll);
    </script>

