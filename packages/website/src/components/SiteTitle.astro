---
// Starlight `<SiteTitle>` component override.
//
// Why this exists:
// Starlight's default SiteTitle renders the brand mark via
// <img src="logo.svg">. SVGs loaded that way don't inherit
// `currentColor` from the parent, so the squares disappeared on
// the dark theme. By inlining the SVG here we get the exact same
// DOM as the landing page's .wordmark and the 404 page's
// .nf-wordmark — single source of truth for brand rendering.
//
// All typography, color, sizing, hover motion, view-transition
// naming, and theme-adaptive color cascade live in
// `src/styles/custom.css`. This component is intentionally style-
// free so cascade resolution stays simple.
const { siteTitle, siteTitleHref } = Astro.props;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <svg
    width="26"
    height="26"
    viewBox="0 0 24 24"
    fill="none"
    role="img"
    aria-label="Patchwire logo"
  >
    <path d="M12 9.5 L12 5.5 Q12 3 9.5 3 L5.5 3 Q3 3 3 5.5 L3 9.5 Q3 12 5.5 12 L10 12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M16 13 L18.5 13 Q21 13 21 15.5 L21 18.5 Q21 21 18.5 21 L15.5 21 Q13 21 13 18.5 L13 16 A3 3 0 0 0 16 13 Z" fill="currentColor"/>
    <circle cx="12.5" cy="12.5" r="2.4" fill="#C9F564"/>
  </svg>
  <span translate="no">{siteTitle}</span>
</a>
