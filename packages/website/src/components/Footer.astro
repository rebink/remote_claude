---
// Starlight `<Footer>` override — keeps the default footer
// (edit link, last-updated, prev/next pagination) and appends a
// branded block that echoes the landing page footer so every docs
// page closes with the same identity signal as the home page.
import Default from '@astrojs/starlight/components/Footer.astro';
// Typing `Astro.props` as Starlight's route data so `{...Astro.props}` below
// is assignable to <Default>. This is Starlight's documented override pattern.
import type { Props } from '@astrojs/starlight/props';

const repo = 'https://github.com/rebink/patchwire';
const year = new Date().getFullYear();
const version = '0.1.0';
---

<Default {...Astro.props} />

<div class="pw-brand-footer">
  <div class="pw-brand-line">
    <a href="/" class="pw-brand-mark" aria-label="Patchwire home">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" role="img" aria-hidden="true">
        <rect x="0.5" y="0.5" width="9" height="9" stroke="currentColor" stroke-width="1.8" fill="none"/>
        <rect x="12.5" y="12.5" width="9" height="9" fill="currentColor"/>
        <line x1="6" y1="11" x2="16" y2="11" stroke="currentColor" stroke-width="1.4" stroke-dasharray="1.4 2"/>
        <circle cx="11" cy="11" r="1.5" fill="#C9F564"/>
      </svg>
      <span>Patchwire</span>
    </a>
    <span class="pw-brand-tag">local-first · ai-remote · diff-reviewable</span>
  </div>
  <div class="pw-brand-meta">
    <span>© {year} Patchwire · v{version}</span>
    <span class="pw-brand-sep" aria-hidden="true">·</span>
    <a href={repo}>GitHub ↗</a>
    <span class="pw-brand-sep" aria-hidden="true">·</span>
    <a href={`${repo}/blob/main/LICENSE`}>MIT License ↗</a>
  </div>
</div>

<style>
  .pw-brand-footer {
    margin-top: 4rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--sl-color-hairline-light);
    display: grid;
    gap: 0.5rem;
    font-family: var(--rc-font-mono);
    font-size: 11px;
    color: var(--sl-color-gray-3);
  }
  .pw-brand-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .pw-brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--rc-font-display);
    font-weight: 500;
    font-size: 15px;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .pw-brand-mark:hover {
    transform: translateX(0.5px);
  }
  .pw-brand-mark svg {
    transition: transform 0.4s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .pw-brand-mark:hover svg {
    transform: translateY(-0.5px) scale(1.04);
  }
  .pw-brand-tag {
    letter-spacing: 0.06em;
    color: var(--rc-phosphor);
    opacity: 0.78;
  }
  .pw-brand-meta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    letter-spacing: 0.02em;
  }
  .pw-brand-meta a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .pw-brand-meta a:hover {
    color: var(--rc-phosphor);
  }
  .pw-brand-sep {
    opacity: 0.35;
  }
</style>
